# Restore micro-VM kernel (#60): merged onto x86_64_defconfig of the Debian LTS source (linux-source-6.12) by
# restore-vm/Containerfile and os/Containerfile stage 3.
# The VM (crates/pve/src/restorevm.rs): q35 + KVM, virtio-blk disks (read-only), virtio-serial agent port, ttyS0
# log, no network, no display. Built in: everything mkinitrd.sh used to load as modules; a module: ZFS only (dkms).

# no network, no devices the VM does not have
# CONFIG_NET is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_AGP is not set
# CONFIG_HID is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_CDROM is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_ETHERNET is not set
# CONFIG_HAMRADIO is not set
# CONFIG_NFS_FS is not set
# CONFIG_LOGO is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_PROFILING is not set
# CONFIG_KEXEC is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set

# KVM guest, virtio
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# initramfs (zstd, mkinitrd.sh), devtmpfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# guest file systems (read-only use)
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_NTFS3_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# partitions, md, device mapper (LVM, thin pools, mirrors; dm-linear for dynamic disks)
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_MD=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=y
CONFIG_MD_RAID456=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_MIRROR=y

# ZFS as the only module (zfs-dkms against this tree)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_ZLIB_INFLATE=y
CONFIG_ZLIB_DEFLATE=y
