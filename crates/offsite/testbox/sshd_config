# Test SFTP server modelled on a Hetzner Storage Box (its port-23 service).
Port 22
HostKey /etc/ssh/hostkey/ssh_host_ed25519_key
UsePAM no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitRootLogin no
AllowUsers tenant
# Keys come from a command so it can also enforce the per-account connection
# limit (see keys-cmd.sh); no authorized_keys file is consulted.
AuthorizedKeysFile none
AuthorizedKeysCommand /usr/local/sbin/keys-cmd %u
AuthorizedKeysCommandUser nobody
# One SFTP channel per connection: a "connection" is what Hetzner counts.
MaxSessions 1
# At most 10 connections in the unauthenticated phase at once (start:rate:full).
MaxStartups 10:30:10
LoginGraceTime 20
# Refused over-limit logins count as failed auth; don't penalise the test client.
PerSourcePenalties no
AllowTcpForwarding no
AllowStreamLocalForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitTTY no
PermitUserRC no
ChrootDirectory /srv/sftp
ForceCommand internal-sftp -d /data
Subsystem sftp internal-sftp
ClientAliveInterval 30
LogLevel VERBOSE
