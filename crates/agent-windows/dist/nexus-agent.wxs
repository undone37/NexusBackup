<?xml version="1.0" encoding="utf-8"?>
<!--
  NexusBackup Agent MSI (wixl from msitools, WiX 3 schema; built by release/packages.sh,
  checked by release/test-packages.sh). Silent install for GPO / Intune:
    msiexec /i nexus-agent-<v>-x64.msi /qn
  Uninstall keeps %ProgramData%\NexusAgent (agent key, certificates) unless PURGE=1:
    msiexec /x nexus-agent-<v>-x64.msi /qn PURGE=1
  No enrollment token property on purpose: tokens are one-time and per host, and MSI
  properties end up in logs, GPO/Intune configuration and process lists. Enroll with
  "nexus-agent.exe init" with the token on stdin (docs/agent-windows.md).
  Fleet deployment (docs/agent-windows.md "Fleet deployment"): the reusable, time-limited
  fleet secret from the appliance as a property,
    msiexec /i nexus-agent-<v>-x64.msi /qn FLEETSECRET=nxf1.<id>.<secret>
  initialises a new agent for fleet enrollment (ignored on an enrolled agent); the
  appliance finds it in its next scan of the fleet's address ranges.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="NexusBackup Agent" Language="1033" Version="$(var.Version)"
           Manufacturer="NexusBackup" UpgradeCode="f0236c93-ddce-4b09-a197-525c84656168">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="NexusBackup Agent $(var.Version)"
             Comments="Pull-model backup agent (mutual TLS, VSS, USN journal)" />
    <Media Id="1" Cabinet="agent.cab" EmbedCab="yes" />

    <!-- one installation per machine; a newer MSI replaces an older one, no downgrades -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of NexusBackup Agent is already installed." />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/undone37/NexusBackup" />
    <Property Id="ARPHELPLINK" Value="https://github.com/undone37/NexusBackup/blob/main/docs/agent-windows.md" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- app icon (crates/agent-gui/dist/nexus-agent-gui.ico, also embedded in the exe):
         Start menu shortcut and Apps & features -->
    <Icon Id="NexusAgent.ico" SourceFile="nexus-agent-gui.ico" />
    <Property Id="ARPPRODUCTICON" Value="NexusAgent.ico" />
    <!-- the fleet secret is not written to the MSI log -->
    <Property Id="MsiHiddenProperties" Value="FLEETSECRET" />
    <!-- PURGE (uninstall only): wixl does not list Secure="yes" properties in
         SecureCustomProperties (and refuses a second row), so it reaches the server side
         only for administrators; uninstalls run elevated anyway (admin, SYSTEM via GPO/Intune) -->

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="NexusBackup Agent">
          <Component Id="Agent" Guid="*" Win64="yes">
            <File Id="AgentExe" Name="nexus-agent.exe" Source="nexus-agent.exe" KeyPath="yes" />
            <!-- LocalSystem: backup/restore/security privileges; `service` = SCM entry point -->
            <ServiceInstall Id="AgentService" Name="NexusAgent" DisplayName="NexusBackup Agent"
                            Description="NexusBackup pull-model backup agent (mTLS, VSS, USN journal)"
                            Type="ownProcess" Start="auto" ErrorControl="normal" Arguments="service"
                            Account="LocalSystem" Vital="yes" />
            <!-- an agent that is not enrolled yet stops again by itself (exit 0) -->
            <ServiceControl Id="AgentServiceControl" Name="NexusAgent" Start="install" Stop="both"
                            Remove="uninstall" Wait="no" />
          </Component>
          <Component Id="Marker" Guid="*" Win64="yes">
            <!-- self-update off: the MSI owns nexus-agent.exe (agent_core::update::package_marker) -->
            <File Id="PackageManaged" Name="package-managed" Source="package-managed.msi" KeyPath="yes" />
          </Component>
          <!-- desktop UI (tray icon + status window, crates/agent-gui): started at every user
               logon through the per-machine Run key (users can switch it off in Task Manager >
               Startup); the Start menu entry opens the window -->
          <Component Id="Gui" Guid="*" Win64="yes">
            <File Id="GuiExe" Name="nexus-agent-gui.exe" Source="nexus-agent-gui.exe" KeyPath="yes" />
            <!-- not advertised (a Shortcut nested in File becomes an advertised one in wixl) -->
            <Shortcut Id="GuiStartMenu" Directory="ProgramMenuFolder" Name="NexusBackup Agent"
                      Description="Backup status of this computer" Target="[#GuiExe]" Arguments="--open"
                      WorkingDirectory="INSTALLDIR" Icon="NexusAgent.ico" />
            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                           Name="NexusBackupAgentGui" Type="string" Value="&quot;[INSTALLDIR]nexus-agent-gui.exe&quot;" />
          </Component>
          <Component Id="Readme" Guid="*" Win64="yes">
            <File Id="Readme" Name="README.md" Source="README.md" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="CommonAppDataFolder">
        <Directory Id="DataDir" Name="NexusAgent">
          <Directory Id="ConfigDir" Name="config">
            <Directory Id="KeysDir" Name="release-keys">
              <?include keys.wxi ?>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="NexusBackup Agent" Level="1">
      <ComponentRef Id="Agent" />
      <ComponentRef Id="Marker" />
      <ComponentRef Id="Gui" />
      <ComponentRef Id="Readme" />
      <?include keyrefs.wxi ?>
    </Feature>

    <!-- protected ACL on %ProgramData%\NexusAgent (SYSTEM + Administrators only) and the
         service failure actions; as LocalSystem, before the service is started -->
    <CustomAction Id="ServiceSetup" FileKey="AgentExe" ExeCommand="service-setup"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!-- PURGE=1 on uninstall: also delete the enrollment (key, certificates) and state;
         runs while nexus-agent.exe is still there (the service is stopped by then) -->
    <CustomAction Id="PurgeData" FileKey="AgentExe" ExeCommand="purge-data --yes"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- FLEETSECRET (install only): "init" with the fleet secret after the ACL is set and before the
         service starts (StartServices); refused on an enrolled agent, which must not fail
         an upgrade (Return="ignore") -->
    <CustomAction Id="FleetInit" FileKey="AgentExe" ExeCommand="init --fleet-secret &quot;[FLEETSECRET]&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="ServiceSetup" After="InstallServices">NOT REMOVE="ALL"</Custom>
      <Custom Action="FleetInit" After="ServiceSetup">FLEETSECRET AND NOT REMOVE="ALL"</Custom>
      <Custom Action="PurgeData" After="DeleteServices">REMOVE="ALL" AND PURGE="1" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
