[Unit]
Description=NexusBackup chunk store (dedup, compression, encryption, GC, retention locks)
Requires=nexus-keyd.service
After=nexus-keyd.service local-fs.target

[Service]
Type=notify
ExecStart=/usr/libexec/nexus/chunkstore
User=nexus-chunkstore
Group=nexus-chunkstore
Restart=on-failure

# Indexes/manifests/chunks; the data tier is mounted below this later.
StateDirectory=nexus/chunkstore
StateDirectoryMode=0700
# Ingest socket for connectors: /run/nexus-chunkstore/
RuntimeDirectory=nexus-chunkstore
RuntimeDirectoryMode=0750
UMask=0077
# Holds tenant DEKs in memory.
LimitMEMLOCK=64M
LimitCORE=0

# Talks to connectors and keyd over Unix sockets only.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
