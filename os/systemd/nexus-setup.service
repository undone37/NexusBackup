[Unit]
Description=NexusBackup first-boot setup wizard (console, tty1)
# Runs until the wizard has written setup-done and never again afterwards.
# `nexus-setup --force-reconfigure-network` is run by hand from a console.
ConditionPathExists=!/var/lib/nexus/setup-done
ConditionPathExists=/usr/libexec/nexus/nexus-setup
After=systemd-user-sessions.service systemd-sysusers.service systemd-tmpfiles-setup.service
After=systemd-vconsole-setup.service NetworkManager.service plymouth-quit-wait.service
Wants=NetworkManager.service
# Same pattern as Fedora's initial-setup: getty@tty1 waits for this oneshot,
# so the wizard owns tty1 until setup is done (tty2.. keep their gettys).
Before=getty@tty1.service

[Service]
Type=oneshot
TimeoutStartSec=infinity
# Quitting the wizard (exit 3) or an error starts it again until setup-done exists.
ExecStart=/bin/sh -c 'while [ ! -e /var/lib/nexus/setup-done ]; do /usr/libexec/nexus/nexus-setup || { echo "nexus-setup exited ($?), restarting; details: journalctl -u nexus-setup"; sleep 3; }; done'

StandardInput=tty-force
StandardOutput=tty
# Audit lines and errors go to the journal, not over the TUI.
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# Disallocating the VT afterwards drops anything left in its scrollback.
TTYVTDisallocate=yes
Environment=TERM=linux

# Holds the recovery key and passwords briefly: no core dumps, memory locked.
LimitCORE=0
LimitMEMLOCK=infinity
UMask=0077

# Runs as root: writes /etc/nexus and /var/lib/nexus (created by tmpfiles with
# the service owners; root needs DAC override to write into keyd's 0700 dir),
# chowns the files it creates to the service users, and drives NetworkManager,
# hostnamed and systemd over D-Bus (those need uid 0, not capabilities).
# CAP_NET_ADMIN: nft opens the outbound firewall for one offsite target while a
# configuration backup is fetched ("b" on the overview, replacement appliance).
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_NET_ADMIN
AmbientCapabilities=
ReadWritePaths=/var/lib/nexus /etc/nexus
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
NoNewPrivileges=yes
# only terminals (the wizard's tty1 and /dev/tty)
DevicePolicy=closed
DeviceAllow=char-tty rw
DeviceAllow=/dev/tty rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@resources
SystemCallErrorNumber=EPERM
# D-Bus (system bus), sysfs NIC info, nft (netlink); IP only to fetch a configuration
# backup from the offsite target the operator typed in (DNS + that target: the
# nftables output policy drops everything else; SELinux allows the SSH/HTTP ports).
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
