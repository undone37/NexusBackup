[Unit]
Description=NexusBackup: back up configured Proxmox VE guests
After=network-online.target nexus-keyd.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/nexus/nexus-pve /etc/nexus/pve.json backup-all
User=nexus-chunkstore
Group=nexus-chunkstore
StateDirectory=nexus/chunkstore
# ponytail: same sandbox baseline as nexus-chunkstore.service; split connector user when connectors multiply
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
