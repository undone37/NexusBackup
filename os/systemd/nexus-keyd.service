[Unit]
Description=NexusBackup key daemon (KEK + tenant DEKs, hands keyrings to the scheduler)
# Requires `keyd init` from the first-boot wizard (nexus-setup).
ConditionPathExists=/var/lib/nexus/keyd/kek.recovery

[Service]
Type=exec
ExecStart=/usr/libexec/nexus/keyd serve /var/lib/nexus/keyd /run/nexus-keyd/keyd.sock nexus-chunkstore
User=nexus-keyd
Group=nexus-keyd
Restart=on-failure

# Socket /run/nexus-keyd/keyd.sock: directory 0750 nexus-keyd:nexus-keyd, so only
# members of group nexus-keyd (the scheduler user nexus-chunkstore) reach it; keyd
# additionally checks the peer uid (SO_PEERCRED).
RuntimeDirectory=nexus-keyd
RuntimeDirectoryMode=0750
# /var/lib/nexus/keyd (0700 nexus-keyd, tmpfiles.d/nexus.conf)
ReadWritePaths=/var/lib/nexus/keyd
UMask=0077

# Keys live only in memory: allow mlock, never dump core.
LimitMEMLOCK=64M
LimitCORE=0

# No network at all, only the local socket.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

# TPM sealing is deferred (state.md): no devices. With TPM this becomes
# DevicePolicy=closed + DeviceAllow=/dev/tpmrm0 rw + SupplementaryGroups=tss.
PrivateDevices=yes
# No PrivateUsers=: the peer-uid check needs the real uid of the scheduler.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
