[Unit]
Description=NexusBackup: offsite copy (upload, inventory check, retention, GC, sampled verify)
After=network-online.target nexus-keyd.service nexus-pve-backup.service
Wants=network-online.target

[Service]
Type=oneshot
User=nexus-chunkstore
Group=nexus-chunkstore
StateDirectory=nexus/chunkstore
# one config per tenant box; ponytail: single tenant config until the control plane manages targets
ExecStart=/usr/libexec/nexus/nexus-offsite /etc/nexus/offsite.json upload
ExecStart=/usr/libexec/nexus/nexus-offsite /etc/nexus/offsite.json check
ExecStart=/usr/libexec/nexus/nexus-offsite /etc/nexus/offsite.json retention
ExecStart=/usr/libexec/nexus/nexus-offsite /etc/nexus/offsite.json gc
ExecStart=/usr/libexec/nexus/nexus-offsite /etc/nexus/offsite.json verify 3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
