# Overrides 90-default.preset, which enables sshd. Presets are re-applied on first
# boot (empty machine-id), so disabling sshd only via a symlink is not enough.
disable sshd.service
disable sshd.socket
enable nftables.service
enable chronyd.service
# First-boot wizard on tty1; inert once /var/lib/nexus/setup-done exists.
enable nexus-setup.service
# Outbound allow-list sync (root oneshot, path- and timer-triggered).
enable nexus-nft-sync.service
enable nexus-nft-sync.path
enable nexus-nft-sync.timer
# NAS mount helper (socket-activated per connection, docs/nas-connector.md).
enable nexus-nasmount.socket
# Plugin installer (path-triggered oneshot, also once at boot); inert until
# /var/lib/nexus/setup-done exists (ConditionPathExists in the service).
enable nexus-plugin-install.service
enable nexus-plugin-install.path
# nexus-keyd, nexus-web-api and nexus-scheduler are enabled by nexus-setup
# (`systemctl enable --now`) as its last step.
disable nexus-keyd.service
disable nexus-web-api.service
disable nexus-scheduler.service
disable nexus-replicad.service
