# Overrides 90-default.preset, which enables sshd. Presets are re-applied on first
# boot (empty machine-id), so disabling sshd only via a symlink is not enough.
disable sshd.service
disable sshd.socket
enable nftables.service
enable chronyd.service
# First-boot wizard on tty1; inert until /usr/libexec/nexus/nexus-setup ships
# (ConditionPathExists) and after /var/lib/nexus/setup-done exists.
enable nexus-setup.service
# The other nexus-*.service are enabled here once their binaries ship in the image;
# nexus-web-api and nexus-scheduler are enabled by nexus-setup itself.
