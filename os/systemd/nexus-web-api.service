[Unit]
Description=NexusBackup web UI and REST API (management port 8443/tcp)
After=network-online.target
Wants=network-online.target
# nexus-setup creates this as its last step (docs/control-plane.md)
ConditionPathExists=/var/lib/nexus/setup-done

[Service]
Type=notify
ExecStart=/usr/libexec/nexus/nexus-web-api
User=nexus-webapi
Group=nexus-webapi
# catalog DB (rw, WAL) and file-restore downloads (read) are shared via group
# nexus-catalog (tmpfiles.d/nexus.conf); TLS key 0600 nexus-webapi, metrics token
# 0640 root:nexus-webapi (written by nexus-setup).
SupplementaryGroups=nexus-catalog
# replication (docs/replication.md): /run/nexus-replicad (socket, replication CA
# certificate, sealing public key), 0750 nexus-chunkstore:nexus-replicad
SupplementaryGroups=nexus-replicad
ReadWritePaths=/var/lib/nexus/catalog
# OS update control (request/window/inhibit for nexus-update; 2770 root:nexus-catalog)
ReadWritePaths=/var/lib/nexus/update
# console unlock codes (hash files, 0700 nexus-webapi; read + deleted by nexus-console-gate)
ReadWritePaths=/var/lib/nexus/console-unlock
# plugin uploads (docs/plugin-system.md): bundle + signature into the staging dir
# (2770 nexus-webapi:nexus-plugins, read and deleted by nexus-plugin-install), then
# .trigger for nexus-plugin-install.path; project keys and installed manifests read-only
ReadWritePaths=/var/lib/nexus/plugins-staging
Environment=NEXUS_PLUGIN_STAGING=/var/lib/nexus/plugins-staging
Environment=NEXUS_PLUGIN_KEYS=/etc/pki/nexus/plugin-keys
Environment=NEXUS_PLUGINS=/var/lib/nexus/plugins
Restart=on-failure
UMask=0077
LimitCORE=0

# Listens on 8443 (unprivileged port, no CAP_NET_BIND_SERVICE needed). Outbound
# only to the OIDC identity provider (discovery, JWKS, token endpoint; the
# scheduler puts those hosts on the firewall allow-list); everything else is
# dropped by the nftables output chain.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindAllow=tcp:8443
SocketBindDeny=any

PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
# no PrivateUsers=: the catalog is shared via the supplementary group nexus-catalog
PrivateTmp=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
