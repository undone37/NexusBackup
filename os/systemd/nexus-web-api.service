[Unit]
Description=NexusBackup web UI and REST API (management port 8443/tcp)
After=network-online.target
Wants=network-online.target
# nexus-setup creates this as its last step (docs/control-plane.md)
ConditionPathExists=/var/lib/nexus/setup-done

[Service]
Type=notify
ExecStart=/usr/libexec/nexus/web-api
User=nexus-webapi
Group=nexus-webapi
# catalog DB (rw, WAL) and file-restore downloads (read) are group-shared
SupplementaryGroups=nexus-catalog
ReadWritePaths=/var/lib/nexus/catalog
Restart=on-failure

StateDirectory=nexus/webapi
StateDirectoryMode=0700
RuntimeDirectory=nexus-webapi
RuntimeDirectoryMode=0750
UMask=0077
LimitCORE=0

# Listens on 8443 (unprivileged port, no CAP_NET_BIND_SERVICE needed).
# AF_UNIX for talking to scheduler/catalog/restore over local sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindAllow=tcp:8443
SocketBindDeny=any

PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
# no PrivateUsers=: the catalog is shared via the supplementary group nexus-catalog
PrivateTmp=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
