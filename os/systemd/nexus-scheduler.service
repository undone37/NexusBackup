[Unit]
Description=NexusBackup scheduler (policies, job runner, retention, GC, verify, offsite, alerts)
After=network-online.target nexus-keyd.service
Wants=network-online.target nexus-keyd.service
ConditionPathExists=/var/lib/nexus/setup-done

[Service]
Type=exec
ExecStart=/usr/libexec/nexus/nexus-scheduler
User=nexus-chunkstore
Group=nexus-chunkstore
# catalog DB (group nexus-catalog); keyd socket via nexus-chunkstore's
# membership in nexus-keyd (sysusers.d/nexus.conf)
SupplementaryGroups=nexus-catalog
Restart=on-failure
# SIGTERM ends running jobs with the scheduler; they are marked failed on the next start.
KillMode=control-group
# The restore micro-VM (file restore from VM images) runs EL's QEMU.
Environment=NEXUS_QEMU=/usr/libexec/qemu-kvm

# chunk stores, offsite inventories, key escrow, alert cursor, file-restore
# downloads, catalog (all created by tmpfiles.d/nexus.conf with owners/modes);
# /run/nexus-nft/allowed.json is the outbound allow-list for nexus-nft-sync.
ReadWritePaths=/var/lib/nexus/catalog /var/lib/nexus/chunkstore /var/lib/nexus/offsite
ReadWritePaths=/var/lib/nexus/escrow /var/lib/nexus/scheduler /var/lib/nexus/downloads
ReadWritePaths=/run/nexus-nft
# OS update control (maintenance window for nexus-update; 2770 root:nexus-catalog)
ReadWritePaths=/var/lib/nexus/update
# the appliance's own SSH keys: generated, rotated, retired (0750 nexus-chunkstore)
ReadWritePaths=/etc/nexus/ssh
# installed plugins (/var/lib/nexus/plugins) stay read-only (ProtectSystem=strict):
# nexus-pluginhost runs them from there, only nexus-plugin-install writes them
# generated job configs with secrets: private, wiped at start
RuntimeDirectory=nexus-scheduler
RuntimeDirectoryMode=0700
UMask=0077
LimitMEMLOCK=64M
LimitCORE=0

# PVE API/SSH, offsite SFTP, webhook/SMTP (alerts.json or the catalog setting); keyd over AF_UNIX. Destinations are
# enforced by the nftables allow-list, not here (they are configured at runtime).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# File restore boots the restore micro-VM with KVM: /dev/kvm only.
DevicePolicy=closed
DeviceAllow=/dev/kvm rw

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# QEMU with KVM maps no W+X memory (TCG would need it; no TCG fallback here).
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# chgrp of downloads/ to nexus-catalog (no CAP_CHOWN, so only own files to own groups)
SystemCallFilter=@chown
# nexus-pluginhost sandboxes its plugin in the forked child before exec: Landlock
# (landlock_*) and a seccomp filter (@sandbox), lowered rlimits (setrlimit, prlimit64;
# lowering only: no CAP_SYS_RESOURCE) and nice 10 (setpriority). RestrictNamespaces=yes
# stays: no user namespaces on the appliance, the host's best-effort unshare fails and
# the plugin runs as nexus-chunkstore confined by SELinux (nexus_plugin_t) + Landlock.
SystemCallFilter=@sandbox setrlimit prlimit64 setpriority
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
