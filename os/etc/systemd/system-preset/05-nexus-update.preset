# Updates are staged by nexus-update and applied only in the maintenance window or on
# admin request. The stock auto-updaters would reboot at any time (bootc upgrade --apply).
# Presets are re-applied on first boot, so this must be a preset, not only a symlink.
disable bootc-fetch-apply-updates.timer
disable rpm-ostreed-automatic.timer
disable podman-auto-update.timer
enable nexus-update.timer
enable nexus-update.path
# Boot menu (GRUB) password: installs /etc/nexus/grub-user.cfg into /boot at every boot (Phase 18).
enable nexus-grub-password.service
# Diagnostics requests from the web UI (self-checks, support bundle; also the pre-update checks' tool).
enable nexus-diag.path
# Disks: inventory, SMART, RAID state (timer) and requests from the web UI (Phase 16a/b).
enable nexus-disks.timer
enable nexus-disks.path
# Network interfaces from the web UI and the path-MTU check (Phase 22a).
enable nexus-net.timer
enable nexus-net.path
# nexus-disks reads SMART itself (hourly, never waking a sleeping disk); no second poller
disable smartd.service
# Health-check-gated rollback (also in 90-default.preset; repeated so it cannot drift).
enable greenboot-healthcheck.service
enable greenboot-set-rollback-trigger.service
enable greenboot-success.target
