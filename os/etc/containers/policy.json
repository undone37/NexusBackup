{
  "default": [
    {
      "type": "reject"
    }
  ],
  "transports": {
    "docker": {
      "ghcr.io/undone37/nexusbackup": [
        {
          "type": "sigstoreSigned",
          "keyPaths": [
            "/etc/pki/nexus/cosign/TEST-KEY-DO-NOT-SHIP.pub",
            "/etc/pki/nexus/cosign/nexus-release-2026-alpha.pub"
          ],
          "signedIdentity": {
            "type": "matchRepository"
          }
        }
      ]
    },
    "oci": {
      "/var/lib/nexus/update-offline/current/image": [
        {
          "type": "insecureAcceptAnything"
        }
      ]
    }
  }
}
