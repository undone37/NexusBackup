{
    "default": [
        {
            "type": "reject"
        }
    ],
    "transports": {
        "docker": {
            "ghcr.io/nexusbackup/appliance": [
                {
                    "type": "sigstoreSigned",
                    "keyPaths": [
                        "/etc/pki/nexus/cosign/TEST-KEY-DO-NOT-SHIP.pub"
                    ],
                    "signedIdentity": {
                        "type": "matchRepository"
                    }
                }
            ]
        }
    }
}
