# NexusBackup appliance OS image (plan.md 4.2, 12.1, ADR-004).
# Build from the repository root (the context needs crates/, web/, restore-vm/, os/):
#   podman build -f os/Containerfile -t localhost/nexus-os:dev .
#
# Stages: web (SPA) -> rust (workspace, on the target's glibc) -> restorevm
# (micro-VM kernel + initramfs) -> selinux (policy module) -> final bootc image.
# Only the final stage ends up in the image; compilers and devel packages do not.
#
# quay.io/almalinux/almalinux-bootc does not exist (unauthorized); the official
# AlmaLinux bootc image lives under quay.io/almalinuxorg/.
ARG BASE=quay.io/almalinuxorg/almalinux-bootc:10
ARG NODE=docker.io/library/node:22-trixie-slim
ARG DEBIAN=docker.io/library/debian:trixie
ARG RUST_VERSION=1.93.0

# ---- Stage 1: web UI (web/dist is embedded into nexus-web-api at compile time)
FROM ${NODE} AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY web/ ./
# the dev mock (loaded by vite.config.ts) imports the shipped plugins' manifests
COPY plugins/ /src/plugins/
RUN npm run build

# ---- Stage 2: Rust workspace. Built on the base image so the binaries link
# against the glibc they run with. The restore agent is a static musl binary.
FROM ${BASE} AS rust
ARG RUST_VERSION
# parallel rustc jobs (memory: ~1 GB per job at the peak)
ARG JOBS=8
RUN dnf -y install --setopt=install_weak_deps=False gcc make \
 && dnf clean all
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup.sh \
 && sh /tmp/rustup.sh -y --no-modify-path --profile minimal --default-toolchain ${RUST_VERSION} \
      --target x86_64-unknown-linux-musl \
 && rm /tmp/rustup.sh
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY restore-vm/agent/ restore-vm/agent/
COPY plugins/ plugins/
COPY --from=web /src/web/dist web/dist
# The cache mounts keep the registry and target dir across builds; the
# binaries are copied out within the same RUN.
RUN --mount=type=cache,target=/opt/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -j ${JOBS} \
      -p keyd -p pve -p offsite -p web-api -p scheduler -p setup -p nftsync -p agent-conn -p truenas -p nas \
      -p plugin-host -p plugin-manager \
 # separately: one build with -p web-api would unify features and link the replication
 # daemons (chunk store, keyd client) into nexus-web-api, which only needs the protocol types
 && cargo build --release --locked -j ${JOBS} -p replication \
 # the console tool (verify/inspect bundles): separately, its `cli` feature must not
 # unify into the other binaries
 && cargo build --release --locked -j ${JOBS} -p plugin-sdk --features cli --bin nexus-plugin \
 && cargo build --release --locked -j ${JOBS} -p restorevm-agent --target x86_64-unknown-linux-musl \
 && mkdir -p /out \
 && cp target/release/keyd target/release/nexus-pve target/release/nexus-offsite \
       target/release/nexus-web-api target/release/nexus-scheduler target/release/nexus-setup \
       target/release/nexus-nft-sync target/release/nexus-agentctl target/release/nexus-truenas \
       target/release/nexus-nas target/release/nexus-nasmount \
       target/release/nexus-replicad target/release/nexus-replica \
       target/release/nexus-pluginhost target/release/nexus-plugin-install target/release/nexus-plugin /out/ \
 && cp target/x86_64-unknown-linux-musl/release/nexus-restore-agent /out/agent

# ---- Stage 3: restore micro-VM (Debian 13 kernel + ZFS initramfs, restore-vm/).
# The RUN lines are those of restore-vm/Containerfile (keep in sync), so both
# share podman's layer cache.
FROM ${DEBIAN} AS restorevm
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's/^Components: main$/Components: main contrib/' /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends linux-image-amd64 linux-headers-amd64 \
      build-essential dkms kmod cpio zstd xz-utils ca-certificates
RUN apt-get install -y --no-install-recommends zfs-dkms zfsutils-linux \
 && KVER=$(basename /boot/vmlinuz-* | sed 's/^vmlinuz-//') \
 && dkms autoinstall -k "$KVER" \
 && modinfo -k "$KVER" zfs | grep -E '^(filename|version|vermagic)'
RUN apt-get install -y --no-install-recommends lvm2 mdadm util-linux fdisk busybox-static \
      e2fsprogs xfsprogs ntfs-3g btrfs-progs dosfstools
ARG DEBIAN
COPY restore-vm/ /src/
COPY --from=rust /out/agent /out/agent
RUN BASE_DIGEST=${DEBIAN} bash /src/mkinitrd.sh

# ---- Stage 4: SELinux policy module (selinux-policy-devel never reaches the image)
FROM ${BASE} AS selinux
RUN dnf -y install --setopt=install_weak_deps=False selinux-policy-devel make \
 && dnf clean all
COPY os/selinux/nexus.te os/selinux/nexus.fc /build/
RUN make -C /build -f /usr/share/selinux/devel/Makefile nexus.pp
# neverallow check (semanage expand-check) in this throwaway stage: the distro's
# own modules fail it (container policy), so the install result is ignored and
# only violations of the nexus module's neverallows fail the build.
COPY os/selinux/nexus-port.cil /build/
RUN sed -i '/expand-check/d' /etc/selinux/semanage.conf \
 && echo expand-check=1 >> /etc/selinux/semanage.conf \
 && { semodule -i /build/nexus.pp /build/nexus-port.cil > /build/neverallow.log 2>&1 || true; } \
 && ! grep -A4 'neverallow check failed at .*/nexus/cil' /build/neverallow.log

# ---- Stage 5: the appliance image
FROM ${BASE}

# chrony, nftables: part of the base, asserted. qemu-kvm-core: the restore
# micro-VM (/usr/libexec/qemu-kvm, nbd block driver and seccomp built in). audit:
# auditd keeps AVC denials and other security events in /var/log/audit.
RUN dnf -y install --setopt=install_weak_deps=False chrony nftables qemu-kvm-core audit \
 && dnf clean all \
 && rm -rf /var/cache/dnf /var/cache/ldconfig /var/lib/dnf /var/log/dnf* /var/log/hawkey.log \
 && /usr/libexec/qemu-kvm -drive format=help | grep -qw nbd

# Service users and groups (systemd-sysusers also runs at boot; running it here
# puts them into the image's /etc/passwd and /etc/group).
COPY os/sysusers.d/nexus.conf /usr/lib/sysusers.d/nexus.conf
RUN systemd-sysusers /usr/lib/sysusers.d/nexus.conf

# Binaries and the restore micro-VM.
COPY --from=rust /out/keyd /out/nexus-pve /out/nexus-offsite /out/nexus-web-api \
     /out/nexus-scheduler /out/nexus-setup /out/nexus-nft-sync /out/nexus-agentctl /out/nexus-truenas \
     /out/nexus-nas /out/nexus-nasmount /out/nexus-replicad /out/nexus-replica \
     /out/nexus-pluginhost /out/nexus-plugin-install /usr/libexec/nexus/
# plugin console tool (verify/inspect bundles); the test plugin (nexus-test-plugin) is never shipped
COPY --from=rust /out/nexus-plugin /usr/bin/nexus-plugin
COPY --from=restorevm /out/vmlinuz /out/initrd.img /out/manifest.txt /usr/lib/nexus/restore-vm/
RUN chmod 0755 /usr/libexec/nexus /usr/libexec/nexus/* /usr/bin/nexus-plugin \
 && test -z "$(find /usr /etc -name 'nexus-test-plugin*')" \
 && chmod 0644 /usr/lib/nexus/restore-vm/*

# SELinux module: install into the image's policy store, check that labels
# resolve, and label what this stage added.
COPY --from=selinux /build/nexus.pp /usr/share/selinux/packages/nexus/nexus.pp
# portcon (7444/tcp -> nexus_agent_port_t) cannot live in the .te module: a CIL module
COPY os/selinux/nexus-port.cil /usr/share/selinux/packages/nexus/nexus-port.cil
RUN semodule -i /usr/share/selinux/packages/nexus/nexus.pp /usr/share/selinux/packages/nexus/nexus-port.cil \
 && semodule -l | grep -qx nexus \
 && semodule -l | grep -qx nexus-port \
 && matchpathcon /usr/libexec/nexus/keyd | grep -q nexus_keyd_exec_t \
 && matchpathcon /usr/libexec/nexus/nexus-agentctl | grep -q nexus_agentctl_exec_t \
 && matchpathcon /usr/libexec/nexus/nexus-truenas | grep -q nexus_truenas_exec_t \
 && matchpathcon /usr/libexec/nexus/nexus-nas | grep -q nexus_nas_exec_t \
 && matchpathcon /usr/libexec/nexus/nexus-nasmount | grep -q nexus_nasmount_exec_t \
 && matchpathcon /run/nexus-nasmount/mount.sock | grep -q nexus_nasmount_var_run_t \
 && matchpathcon /usr/libexec/nexus/nexus-replicad | grep -q nexus_replicad_exec_t \
 && matchpathcon /usr/libexec/nexus/nexus-replica | grep -q nexus_replica_exec_t \
 && matchpathcon /var/lib/nexus/replicad/ca.key | grep -q nexus_replicad_var_lib_t \
 && matchpathcon /var/lib/nexus/scheduler/replica/1/client.key | grep -q nexus_replica_key_t \
 && matchpathcon /var/lib/nexus/scheduler/agent-ca/ca.key | grep -q nexus_agent_ca_t \
 && matchpathcon /usr/libexec/nexus/nexus-web-api | grep -q nexus_webapi_exec_t \
 && matchpathcon /usr/libexec/nexus/nexus-scheduler | grep -q nexus_scheduler_exec_t \
 && matchpathcon /usr/lib/nexus/restore-vm/vmlinuz | grep -q nexus_restorevm_image_t \
 && matchpathcon /var/lib/nexus/catalog | grep -q nexus_catalog_t \
 && matchpathcon /usr/libexec/nexus/nexus-pluginhost | grep -q nexus_pluginhost_exec_t \
 && matchpathcon /usr/libexec/nexus/nexus-plugin-install | grep -q nexus_plugininstall_exec_t \
 && matchpathcon /var/lib/nexus/plugins | grep -q nexus_plugin_data_t \
 && matchpathcon /var/lib/nexus/plugins/x/1.0.0/manifest.json | grep -q nexus_plugin_data_t \
 && matchpathcon /var/lib/nexus/plugins/x/1.0.0/bin/plugin | grep -q nexus_plugin_exec_t \
 && matchpathcon /var/lib/nexus/plugins/x/.1.0.0.tmp/bin/plugin | grep -q nexus_plugin_exec_t \
 && matchpathcon /var/lib/nexus/plugins-staging/x.nxplugin | grep -q nexus_plugin_staging_t \
 && matchpathcon /etc/pki/nexus/plugin-keys/x.pub | grep -q cert_t \
 && matchpathcon /usr/libexec/nexus/nexus-diag | grep -q nexus_diag_exec_t \
 && matchpathcon /var/lib/nexus/diag/0123/bundle.tar.gz | grep -q nexus_diag_var_lib_t

# Systemd units, presets, tmpfiles (state dirs with owners and modes).
COPY os/systemd/*.service os/systemd/*.path os/systemd/*.timer os/systemd/*.socket /usr/lib/systemd/system/
COPY os/systemd/10-nexus.preset /usr/lib/systemd/system-preset/10-nexus.preset
COPY os/tmpfiles.d/nexus.conf /usr/lib/tmpfiles.d/nexus.conf

# Firewall: EL's nftables.service loads /etc/sysconfig/nftables.conf.
COPY os/nftables.conf /etc/sysconfig/nftables.conf

# Signed OS updates and health-gated rollback (docs/release.md).
ARG NEXUS_IMAGE_REPO=ghcr.io/undone37/nexusbackup
ARG NEXUS_VERSION=0.0.0-dev
# greenboot only; NOT greenboot-default-health-checks (its DNS check fails behind default-deny)
RUN dnf -y install --setopt=install_weak_deps=False greenboot \
 && dnf clean all && rm -rf /var/cache/dnf /var/lib/dnf /var/log/dnf* /var/log/hawkey.log

# /etc overlay: chrony.conf, containers signature policy + registry config, cosign
# key, update.conf, greenboot.conf, presets. Must come AFTER the greenboot install
# (overrides /etc/greenboot/greenboot.conf). Then the update agent, diagnostics, health check
# and their units (os/greenboot/usr only, never os/greenboot/tests).
COPY os/etc/ /etc/
COPY os/greenboot/usr/ /usr/
RUN if [ "$NEXUS_IMAGE_REPO" != ghcr.io/undone37/nexusbackup ]; then \
      sed -i "s|ghcr.io/undone37/nexusbackup|$NEXUS_IMAGE_REPO|" /etc/containers/policy.json \
        /etc/containers/registries.d/nexus-appliance.yaml /etc/nexus/update.conf; fi \
 && python3 -c 'import json; json.load(open("/etc/containers/policy.json"))' \
 && test -f /usr/lib/bootupd/grub2-static/configs.d/08_greenboot.cfg \
 && ls /etc/pki/nexus/plugin-keys/*.pub >/dev/null \
 && systemctl preset nexus-update.timer nexus-update.path nexus-diag.path greenboot-healthcheck.service \
      greenboot-set-rollback-trigger.service greenboot-success.target \
 && systemctl is-enabled -q nexus-update.timer nexus-update.path nexus-diag.path greenboot-healthcheck.service \
      greenboot-set-rollback-trigger.service \
 && test "$(systemctl is-enabled bootc-fetch-apply-updates.timer)" = masked \
 && test "$(systemctl is-enabled rpm-ostreed-automatic.timer)" = masked
LABEL org.opencontainers.image.version=${NEXUS_VERSION}

# Time: NTS only (chronyd -p parses the config and fails on errors).
RUN chronyd -p -f /etc/chrony.conf >/dev/null

# No interactive root (locked password, emergency access on the local console
# only); sshd off. The preset file also governs the first-boot preset-all.
RUN usermod -L root \
 && systemctl preset sshd.service sshd.socket nftables.service chronyd.service \
      nexus-setup.service nexus-nft-sync.service nexus-nft-sync.path nexus-nft-sync.timer nexus-nasmount.socket \
      nexus-plugin-install.service nexus-plugin-install.path \
 && ! systemctl is-enabled -q sshd.service \
 && systemctl is-enabled -q nftables.service chronyd.service nexus-setup.service \
      nexus-nft-sync.path nexus-nft-sync.timer nexus-nasmount.socket \
      nexus-plugin-install.service nexus-plugin-install.path \
 && ! systemctl is-enabled -q nexus-web-api.service nexus-scheduler.service nexus-keyd.service

# COPY keeps the build host's modes (umask 002 → 0664/0775): strip group/world
# write from everything shipped in /etc and /usr (base image docs excepted).
RUN find /etc /usr -xdev \( -type f -o -type d \) -perm /022 -not -path '/usr/share/doc/*' \
      -exec chmod go-w {} + \
 && test -z "$(find /etc /usr -xdev \( -type f -o -type d \) -perm /022 -not -path '/usr/share/doc/*')"
RUN bootc container lint
