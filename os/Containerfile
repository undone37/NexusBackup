# NexusBackup appliance OS image (plan.md 12.1, ADR-004).
# Build: podman build -t nexus-os:dev os/
#
# quay.io/almalinux/almalinux-bootc does not exist (unauthorized); the official
# AlmaLinux bootc image lives under quay.io/almalinuxorg/.
ARG BASE=quay.io/almalinuxorg/almalinux-bootc:10

# ---- Stage 1: compile the SELinux policy module (devel tooling never reaches the image)
FROM ${BASE} AS selinux-build
RUN dnf -y install --setopt=install_weak_deps=False selinux-policy-devel make \
 && dnf clean all
COPY selinux/nexus.te selinux/nexus.fc /build/
RUN make -C /build -f /usr/share/selinux/devel/Makefile nexus.pp

# ---- Stage 2: the appliance image
FROM ${BASE}

# chrony and nftables are part of the base image; this asserts it without pulling extras.
RUN dnf -y install --setopt=install_weak_deps=False chrony nftables \
 && dnf clean all \
 && rm -rf /var/cache/dnf /var/lib/dnf /var/log/dnf* /var/log/hawkey.log

# SELinux module: install into the image's policy store and check labels resolve.
COPY --from=selinux-build /build/nexus.pp /usr/share/selinux/packages/nexus/nexus.pp
RUN semodule -i /usr/share/selinux/packages/nexus/nexus.pp \
 && semodule -l | grep -qx nexus \
 && matchpathcon /usr/libexec/nexus/keyd | grep -q nexus_keyd_exec_t \
 && matchpathcon /var/lib/nexus/chunkstore | grep -q nexus_chunkstore_var_lib_t

# Service users (also created at boot by systemd-sysusers; created here so the
# image's /etc/passwd already contains them).
COPY sysusers.d/nexus.conf /usr/lib/sysusers.d/nexus.conf
RUN systemd-sysusers /usr/lib/sysusers.d/nexus.conf

# Service units. Not enabled yet: the binaries under /usr/libexec/nexus/ are not
# shipped in the image until the services exist.
COPY systemd/nexus-chunkstore.service systemd/nexus-keyd.service systemd/nexus-web-api.service \
     systemd/nexus-setup.service \
     /usr/lib/systemd/system/
RUN install -d -m 0755 /usr/libexec/nexus

# Firewall: EL's nftables.service loads /etc/sysconfig/nftables.conf.
COPY nftables.conf /etc/sysconfig/nftables.conf

# Time: NTS only (chronyd -p parses the config and fails on errors).
COPY chrony.conf /etc/chrony.conf
RUN chronyd -p -f /etc/chrony.conf >/dev/null

# No interactive root; no SSH by default (break-glass enablement comes later).
# The preset file also governs first-boot preset-all, so sshd stays off.
COPY systemd/10-nexus.preset /usr/lib/systemd/system-preset/10-nexus.preset
RUN usermod -L root \
 && systemctl preset sshd.service sshd.socket nftables.service chronyd.service nexus-setup.service \
 && ! systemctl is-enabled -q sshd.service \
 && systemctl is-enabled -q nftables.service chronyd.service nexus-setup.service

RUN bootc container lint
