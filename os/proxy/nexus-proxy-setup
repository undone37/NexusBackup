#!/bin/bash
# NexusBackup hot-add proxy, before the agent starts (#35, os/proxy/Containerfile):
# - the agent binary: the image's copy into /usr/local/sbin when there is none or the image's is newer (an OS
#   update of the proxy); otherwise the one the appliance installed (agent rollouts) stays;
# - first boot: a static address from the OVF properties nexus.ip / nexus.gateway / nexus.dns (empty: DHCP), and the
#   enrolment token from nexus.token for `nexus-agent init` (VMware Tools, guestinfo.ovfEnv), then the proxy role
#   (`proxy = on`). The appliance enrols the agent with that token (Agents -> New agent, the proxy's address).
set -euo pipefail
# a failure shows on the console too (the proxy has no login)
trap 'echo "nexus-proxy-setup: failed at line $LINENO" >&2' ERR
shipped=/usr/lib/nexus-proxy/nexus-agent
dst=/usr/local/sbin/nexus-agent
conf=/etc/nexus-agent/agent.conf

ver() { "$1" version 2>/dev/null | awk 'NR == 1 {print $2}'; }
# $1 is a newer version than $2
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]; }

install -d -m 0755 /usr/local/sbin
if [ ! -x "$dst" ] || newer "$(ver "$shipped")" "$(ver "$dst")"; then
	install -m 0755 "$shipped" "$dst.new"
	mv -f "$dst.new" "$dst"
	# a newer image's agent is the new baseline: no older binary to revert to
	rm -f "$dst.prev"
	echo "nexus-proxy-setup: agent $(ver "$dst") from the image"
fi

# the OVF environment: VMware Tools' channel to the host answers some seconds after vmtoolsd started (lab:
# the first boot read nothing and came up with DHCP and no token); every property is in it, also an empty one
env=
for _ in $(seq 30); do
	env=$(vmtoolsd --cmd 'info-get guestinfo.ovfEnv' 2>/dev/null | tr -d '\n' || true)
	case $env in *'oe:key="nexus.'*) break ;; esac
	sleep 2
done
[ -n "$env" ] || echo "nexus-proxy-setup: no OVF environment (deployed without the OVA's properties?): DHCP, no token"
# <Property oe:key="nexus.x" oe:value="..."/>, the value restricted to CHARS
prop() { printf '%s' "$env" | sed -n "s/.*oe:key=\"nexus\\.$1\"[[:space:]]*oe:value=\"\([$2]*\)\".*/\\1/p"; }

# first boot with a static address (nexus.ip): one NetworkManager connection on the first Ethernet device
ip=$(prop ip '0-9./')
if [ -n "$ip" ] && ! nmcli -t -f NAME con show | grep -qx nexus-proxy; then
	dev=$(nmcli -t -f DEVICE,TYPE dev | awk -F: '$2 == "ethernet" {print $1; exit}')
	gw=$(prop gateway '0-9.')
	dns=$(prop dns '0-9. ')
	nmcli con add type ethernet ifname "$dev" con-name nexus-proxy ipv4.method manual ipv4.addresses "$ip" \
		${gw:+ipv4.gateway "$gw"} ${dns:+ipv4.dns "$dns"} ipv6.method disabled connection.autoconnect yes >/dev/null
	nmcli con up nexus-proxy >/dev/null
	echo "nexus-proxy-setup: $dev has the static address $ip"
fi

install -d -m 0700 /etc/nexus-agent
if [ ! -e /etc/nexus-agent/agent.key ]; then
	# the token is base32 (A-Z, 2-7)
	tok=$(prop token 'A-Za-z0-9')
	if [ -z "$tok" ]; then
		echo "nexus-proxy-setup: no enrolment token: set the OVF property nexus.token (Agents -> New agent) and reboot"
		exit 0
	fi
	printf '%s\n' "$tok" | "$dst" init --token - >/dev/null
	echo "nexus-proxy-setup: agent initialised with the token from the OVF properties"
fi
grep -q '^proxy[[:space:]]*=' "$conf" 2>/dev/null || echo 'proxy = on' >>"$conf"
chmod 0600 "$conf"
