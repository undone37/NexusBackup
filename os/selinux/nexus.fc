# NexusBackup file contexts (see nexus.te for who may do what).

# executables: one entry type per domain
/usr/libexec/nexus/keyd			--	gen_context(system_u:object_r:nexus_keyd_exec_t,s0)
/usr/libexec/nexus/nexus-web-api	--	gen_context(system_u:object_r:nexus_webapi_exec_t,s0)
/usr/libexec/nexus/nexus-scheduler	--	gen_context(system_u:object_r:nexus_scheduler_exec_t,s0)
/usr/libexec/nexus/nexus-pve		--	gen_context(system_u:object_r:nexus_pve_exec_t,s0)
/usr/libexec/nexus/nexus-offsite	--	gen_context(system_u:object_r:nexus_offsite_exec_t,s0)
/usr/libexec/nexus/nexus-agentctl	--	gen_context(system_u:object_r:nexus_agentctl_exec_t,s0)
/usr/libexec/nexus/nexus-truenas	--	gen_context(system_u:object_r:nexus_truenas_exec_t,s0)
/usr/libexec/nexus/nexus-vmware	--	gen_context(system_u:object_r:nexus_vmware_exec_t,s0)
/usr/libexec/nexus/nexus-xcpng	--	gen_context(system_u:object_r:nexus_xcpng_exec_t,s0)
/usr/libexec/nexus/nexus-nas		--	gen_context(system_u:object_r:nexus_nas_exec_t,s0)
/usr/libexec/nexus/nexus-nasmount	--	gen_context(system_u:object_r:nexus_nasmount_exec_t,s0)
/usr/libexec/nexus/nexus-replicad	--	gen_context(system_u:object_r:nexus_replicad_exec_t,s0)
/usr/libexec/nexus/nexus-replica	--	gen_context(system_u:object_r:nexus_replica_exec_t,s0)
/usr/libexec/nexus/nexus-pluginhost	--	gen_context(system_u:object_r:nexus_pluginhost_exec_t,s0)
/usr/libexec/nexus/nexus-plugin-install	--	gen_context(system_u:object_r:nexus_plugininstall_exec_t,s0)
/usr/libexec/nexus/nexus-setup		--	gen_context(system_u:object_r:nexus_setup_exec_t,s0)
/usr/libexec/nexus/nexus-nft-sync	--	gen_context(system_u:object_r:nexus_nftsync_exec_t,s0)
/usr/libexec/nexus/nexus-tls		--	gen_context(system_u:object_r:nexus_tls_exec_t,s0)
/usr/libexec/nexus/nexus-diag		--	gen_context(system_u:object_r:nexus_diag_exec_t,s0)
/usr/libexec/nexus/nexus-disks		--	gen_context(system_u:object_r:nexus_disks_exec_t,s0)
/usr/libexec/nexus/nexus-net		--	gen_context(system_u:object_r:nexus_net_exec_t,s0)
/usr/libexec/nexus/nexus-time		--	gen_context(system_u:object_r:nexus_time_exec_t,s0)
/usr/libexec/nexus/nexus-console-gate	--	gen_context(system_u:object_r:nexus_consolegate_exec_t,s0)
/usr/libexec/nexus/nexus-config-backup	--	gen_context(system_u:object_r:nexus_cfgbackup_exec_t,s0)
/usr/libexec/nexus/nexus-index		--	gen_context(system_u:object_r:nexus_index_exec_t,s0)
/usr/libexec/nexus/nexus-fsindex	--	gen_context(system_u:object_r:nexus_fsindex_exec_t,s0)

# restore micro-VM kernel + initramfs (read by the confined QEMU only)
/usr/lib/nexus/restore-vm(/.*)?			gen_context(system_u:object_r:nexus_restorevm_image_t,s0)

# unit files: nexus-setup may enable/start these and nothing else
/usr/lib/systemd/system/nexus-.*		gen_context(system_u:object_r:nexus_unit_file_t,s0)
# the store's mount unit, written by nexus-disks (Phase 16b)
/etc/systemd/system/var-lib-nexus-chunkstore\.mount	--	gen_context(system_u:object_r:nexus_unit_file_t,s0)

# state
/var/lib/nexus				-d	gen_context(system_u:object_r:nexus_var_lib_t,s0)
/var/lib/nexus/setup-done		--	gen_context(system_u:object_r:nexus_var_lib_t,s0)
/var/lib/nexus/\.setup\.lock		--	gen_context(system_u:object_r:nexus_var_lib_t,s0)
/var/lib/nexus/catalog(/.*)?			gen_context(system_u:object_r:nexus_catalog_t,s0)
/var/lib/nexus/downloads(/.*)?			gen_context(system_u:object_r:nexus_downloads_t,s0)
/var/lib/nexus/keyd(/.*)?			gen_context(system_u:object_r:nexus_keyd_var_lib_t,s0)
/var/lib/nexus/chunkstore(/.*)?			gen_context(system_u:object_r:nexus_store_t,s0)
/var/lib/nexus/offsite(/.*)?			gen_context(system_u:object_r:nexus_store_t,s0)
/var/lib/nexus/scheduler(/.*)?			gen_context(system_u:object_r:nexus_store_t,s0)
/var/lib/nexus/scheduler/secrets\.key	--	gen_context(system_u:object_r:nexus_scheduler_secret_t,s0)
/var/lib/nexus/scheduler/agent-ca(/.*)?		gen_context(system_u:object_r:nexus_agent_ca_t,s0)
/var/lib/nexus/scheduler/replica(/.*)?		gen_context(system_u:object_r:nexus_replica_key_t,s0)
/var/lib/nexus/replicad(/.*)?			gen_context(system_u:object_r:nexus_replicad_var_lib_t,s0)
/var/lib/nexus/webapi(/.*)?			gen_context(system_u:object_r:nexus_webapi_var_lib_t,s0)
/var/lib/nexus/escrow(/.*)?			gen_context(system_u:object_r:nexus_escrow_t,s0)
# plugins: installed tree (written only by nexus-plugin-install), the binary of every
# version incl. the unpack dir <id>/.<version>.tmp (both match [^/]+), uploads
/var/lib/nexus/plugins(/.*)?			gen_context(system_u:object_r:nexus_plugin_data_t,s0)
/var/lib/nexus/plugins/[^/]+/[^/]+/bin/plugin	--	gen_context(system_u:object_r:nexus_plugin_exec_t,s0)
/var/lib/nexus/plugins-staging(/.*)?		gen_context(system_u:object_r:nexus_plugin_staging_t,s0)
/var/lib/nexus/agent-releases(/.*)?		gen_context(system_u:object_r:nexus_agent_release_t,s0)
/var/lib/nexus/update(/.*)?			gen_context(system_u:object_r:nexus_update_t,s0)
/var/lib/nexus/tls(/.*)?			gen_context(system_u:object_r:nexus_tls_req_t,s0)
/var/lib/nexus/diag(/.*)?			gen_context(system_u:object_r:nexus_diag_var_lib_t,s0)
/var/lib/nexus/disks(/.*)?			gen_context(system_u:object_r:nexus_disks_var_lib_t,s0)
/var/lib/nexus/net(/.*)?			gen_context(system_u:object_r:nexus_net_var_lib_t,s0)
/var/lib/nexus/time(/.*)?			gen_context(system_u:object_r:nexus_time_var_lib_t,s0)
/etc/nexus/time(/.*)?			gen_context(system_u:object_r:nexus_time_conf_t,s0)
/run/nexus-time(/.*)?			gen_context(system_u:object_r:nexus_time_var_run_t,s0)
/var/lib/nexus/console-unlock(/.*)?		gen_context(system_u:object_r:nexus_console_unlock_t,s0)
/var/lib/nexus/config-backup(/.*)?		gen_context(system_u:object_r:nexus_cfgbackup_var_lib_t,s0)
# file search index (Phase 31b): nexus-index only ([x]: m4 would expand index(…))
/var/lib/nexus/inde[x](/.*)?			gen_context(system_u:object_r:nexus_index_var_lib_t,s0)

# configuration and secrets
/etc/nexus(/.*)?				gen_context(system_u:object_r:nexus_etc_t,s0)
/etc/nexus/grub-user\.cfg		--	gen_context(system_u:object_r:nexus_grub_user_t,s0)
/etc/nexus/tls(/.*)?				gen_context(system_u:object_r:nexus_webapi_secret_t,s0)
# imported chain + key (web.pem, web.pem.prev and their temp names): written by nexus-tls only
/etc/nexus/tls/web\..*			--	gen_context(system_u:object_r:nexus_tls_web_t,s0)
# key of a pending CSR: nexus-tls only (not even the web-api)
/etc/nexus/tls/pending(/.*)?			gen_context(system_u:object_r:nexus_tls_pending_t,s0)
/etc/nexus/metrics-token		--	gen_context(system_u:object_r:nexus_webapi_secret_t,s0)
/etc/nexus/ssh(/.*)?				gen_context(system_u:object_r:nexus_sshkey_t,s0)
/etc/nexus/index\.json			--	gen_context(system_u:object_r:nexus_index_etc_t,s0)

# runtime
/run/nexus-keyd(/.*)?				gen_context(system_u:object_r:nexus_keyd_var_run_t,s0)
/run/nexus-scheduler(/.*)?			gen_context(system_u:object_r:nexus_scheduler_var_run_t,s0)
/run/nexus-nft(/.*)?				gen_context(system_u:object_r:nexus_nft_var_run_t,s0)
/run/nexus-replicad(/.*)?			gen_context(system_u:object_r:nexus_replicad_var_run_t,s0)
/run/nexus-nft-sync(/.*)?			gen_context(system_u:object_r:nexus_nftsync_var_run_t,s0)
/run/nexus-nft-status(/.*)?			gen_context(system_u:object_r:nexus_nftstatus_var_run_t,s0)
/run/nexus-nasmount(/.*)?			gen_context(system_u:object_r:nexus_nasmount_var_run_t,s0)
/run/nexus-nasmount\.[^/]+(/.*)?		gen_context(system_u:object_r:nexus_nasmount_var_run_t,s0)
/run/nexus-console-gate(/.*)?			gen_context(system_u:object_r:nexus_consolegate_var_run_t,s0)
/run/nexus-inde[x](/.*)?				gen_context(system_u:object_r:nexus_index_var_run_t,s0)
