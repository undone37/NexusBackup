policy_module(nexus, 1.0.0)

########################################
# NexusBackup appliance policy (plan.md 4.2, docs/control-plane.md).
#
# Every process runs in its own domain; entry only through its exec type:
#
#   init_t ── nexus_keyd_exec_t ──────> nexus_keyd_t       KEK + DEKs, unix socket, no network
#   init_t ── nexus_webapi_exec_t ────> nexus_webapi_t     8443/tcp, catalog, downloads (read)
#   init_t ── nexus_scheduler_exec_t ─> nexus_scheduler_t  catalog, stores, keyd, alerts out
#               ├─ nexus_pve_exec_t ──> nexus_pve_t        PVE API + ssh (runs /usr/bin/ssh in-domain)
#               │    └─ qemu_exec_t ──> nexus_restorevm_t  restore micro-VM: /dev/kvm, its two sockets
#               ├─ nexus_offsite_exec_t > nexus_offsite_t  SFTP boxes, S3 (https), stores
#               ├─ nexus_agentctl_exec_t > nexus_agentctl_t  Linux/Windows agents (TCP 7444, mTLS),
#               │                                          stores, agent CA (only this domain)
#               ├─ nexus_truenas_exec_t > nexus_truenas_t  TrueNAS API (wss 443) + ssh (in-domain), stores
#               ├─ nexus_nas_exec_t ──> nexus_nas_t        NFS/SMB shares: reads nfs_t/cifs_t through the
#               │                                          mount fd from nexus-nasmount, stores
#               ├─ nexus_replica_exec_t > nexus_replica_t  secondary: pulls from a primary (TLS), stores
#               └─ nexus_pluginhost_exec_t > nexus_pluginhost_t  plugin host (trusted): stores, keyd, downloads
#                    └─ nexus_plugin_exec_t ──> nexus_plugin_t   plugin (UNTRUSTED code): TCP out, its install
#                                                          dir, /usr, its private tmp; outside nexus_domain
#   init_t ── nexus_plugininstall_exec_t > nexus_plugininstall_t  installer: catalog, staging (read/delete),
#                                                          the only writer of plugin dirs + binaries
#   init_t ── nexus_replicad_exec_t ──> nexus_replicad_t   replication server: stores read-only, no network
#   init_t ── nexus_nasmount_exec_t ──> nexus_nasmount_t   root, CAP_SYS_ADMIN: one detached read-only
#                                                          NFS/CIFS mount per socket connection
#   init_t ── nexus_setup_exec_t ─────> nexus_setup_t      first boot (root): nmcli/hostnamectl/systemctl
#   init_t ── nexus_nftsync_exec_t ───> nexus_nftsync_t    root oneshot ── iptables_exec_t ──> iptables_t
#   init_t ── nexus_tls_exec_t ───────> nexus_tls_t        root oneshot, no caps: CSR key, imported web
#                                                          certificate (the only writer), no network
#   init_t ── nexus_diag_exec_t ──────> nexus_diag_t       root oneshot, diagnostics: reads journal/audit/
#                                                          nft/chrony/catalog, writes its dir, no network
#   init_t ── nexus_disks_exec_t ─────> nexus_disks_t      root oneshot, disks: SMART, mdadm, mkfs/xfs_growfs,
#                                                          the store's mount unit; no network, no keys
#   init_t ── nexus_consolegate_exec_t > nexus_consolegate_t  console gate on tty2 (root): unlock code or
#                                                          recovery key ── shell_exec_t ──> unconfined_t
#                                                          (the emergency root shell; the only way there)
#
# Data types are private to the domains named in their rules; nothing is
# shared through generic types (var_lib_t, etc_t, tmp_t). No domain is
# permissive or unconfined (the console gate's root shell is unconfined_t by
# design, Phase 14c). Every allow rule below states why it exists.
########################################

gen_require(`
	type iptables_t;
	type init_t;
	type initrc_t;
	type ssh_exec_t;
	type qemu_exec_t;
	type tpm_device_t;
	type nfs_t;
	type cifs_t;
	type net_conf_t;
	type unconfined_t;
	role system_r;
	class service { start stop status reload enable disable };
	class system { reload status };
')

########################################
# Types

attribute nexus_domain;
attribute nexus_job_domain;

# nexus_daemon(name): domain + exec type, started by systemd
define(`nexus_daemon',`
	type nexus_$1_t, nexus_domain;
	type nexus_$1_exec_t;
	init_daemon_domain(nexus_$1_t, nexus_$1_exec_t)
	# every unit has NoNewPrivileges=yes: the transition must be NNP-safe
	allow init_t nexus_$1_t:process2 { nnp_transition nosuid_transition };
')
# nexus_job(name): domain + exec type, entered only from nexus_scheduler_t
define(`nexus_job',`
	type nexus_$1_t, nexus_domain, nexus_job_domain;
	type nexus_$1_exec_t;
	domain_type(nexus_$1_t)
	domain_entry_file(nexus_$1_t, nexus_$1_exec_t)
	role system_r types nexus_$1_t;
')

nexus_daemon(keyd)
nexus_daemon(webapi)
nexus_daemon(scheduler)
nexus_daemon(setup)
nexus_daemon(nftsync)
nexus_daemon(replicad)
nexus_job(pve)
nexus_job(offsite)
nexus_job(agentctl)
nexus_job(truenas)
nexus_job(nas)
nexus_daemon(nasmount)
nexus_job(replica)
nexus_job(pluginhost)
nexus_daemon(plugininstall)
nexus_daemon(consolegate)
nexus_daemon(tls)

# Plugin process (docs/plugin-system.md): untrusted third-party code. Deliberately
# NOT in nexus_domain: that attribute grants every nexus service basics a plugin must
# not inherit (search of /var/lib/nexus and /run, /proc system state, syslog socket,
# unix sockets) and it would be covered by allow rules written for trusted services.
# Its few basics are granted explicitly below.
type nexus_plugin_t;
domain_type(nexus_plugin_t)
role system_r types nexus_plugin_t;
type nexus_plugin_exec_t;	# /var/lib/nexus/plugins/<id>/<version>/bin/plugin (the only entry point)
domain_entry_file(nexus_plugin_t, nexus_plugin_exec_t)
type nexus_plugin_data_t;	# /var/lib/nexus/plugins: manifests, assets (written only by the installer)
files_type(nexus_plugin_data_t)
type nexus_plugin_staging_t;	# /var/lib/nexus/plugins-staging: uploaded bundles + signatures (web-api -> installer)
files_type(nexus_plugin_staging_t)
type nexus_plugin_tmp_t;	# per-job private tmp of a plugin (/tmp/nexus-plugin-<job>-<rand>, PrivateTmp of the scheduler)
files_tmp_file(nexus_plugin_tmp_t)

# restore micro-VM (EL's qemu-kvm, entered from nexus_pve_t only)
type nexus_restorevm_t, nexus_domain;
domain_type(nexus_restorevm_t)
domain_entry_file(nexus_restorevm_t, qemu_exec_t)
role system_r types nexus_restorevm_t;
type nexus_restorevm_image_t;
files_type(nexus_restorevm_image_t)

type nexus_var_lib_t;		# /var/lib/nexus, setup-done
files_type(nexus_var_lib_t)
type nexus_catalog_t;		# SQLite catalog (WAL)
files_type(nexus_catalog_t)
type nexus_downloads_t;		# file-restore downloads
files_type(nexus_downloads_t)
type nexus_keyd_var_lib_t;	# wrapped KEK + DEKs
files_type(nexus_keyd_var_lib_t)
type nexus_store_t;		# chunk stores, offsite inventories, scheduler state
files_type(nexus_store_t)
type nexus_escrow_t;		# wrapped key escrow uploaded to the boxes
files_type(nexus_escrow_t)
type nexus_etc_t;		# /etc/nexus (scheduler.json, alerts.json, smtp-password)
files_config_file(nexus_etc_t)
type nexus_grub_user_t;		# /etc/nexus/grub-user.cfg: boot menu password hash (Phase 18)
files_config_file(nexus_grub_user_t)
type nexus_webapi_secret_t;	# TLS key/cert, metrics token
files_config_file(nexus_webapi_secret_t)
type nexus_webapi_var_lib_t;	# web-api state: totp.key (encrypts TOTP seeds, review H-2)
files_type(nexus_webapi_var_lib_t)
type nexus_scheduler_secret_t;	# scheduler secrets.key (opens sealed catalog secrets, review H-2)
files_type(nexus_scheduler_secret_t)
type nexus_sshkey_t;		# appliance SSH/SFTP keys + known_hosts
files_config_file(nexus_sshkey_t)
type nexus_unit_file_t;		# nexus-*.service/.path/.timer
systemd_unit_file(nexus_unit_file_t)
type nexus_keyd_var_run_t;	# keyd socket
files_pid_file(nexus_keyd_var_run_t)
type nexus_scheduler_var_run_t;	# job dirs with generated configs + secrets
files_pid_file(nexus_scheduler_var_run_t)
type nexus_nft_var_run_t;	# outbound allow-list (scheduler -> nft-sync)
files_pid_file(nexus_nft_var_run_t)
type nexus_update_t;		# OS update control dir (nexus-update reads it as root)
files_type(nexus_update_t)
type nexus_nftsync_var_run_t;	# nft-sync: elements it added last time
files_pid_file(nexus_nftsync_var_run_t)
type nexus_nftstatus_var_run_t;	# nft-sync status for the web UI: effective sets, blocked attempts (web-api reads)
files_pid_file(nexus_nftstatus_var_run_t)
type nexus_pve_tmp_t;		# restore micro-VM work dir (sockets, console log)
files_tmp_file(nexus_pve_tmp_t)
type nexus_agent_ca_t;		# appliance CA for agents: CA + client keys (nexus-agentctl only)
files_type(nexus_agent_ca_t)
type nexus_nasmount_var_run_t;	# mount helper socket dir + per-instance runtime dirs (Kerberos cache)
files_pid_file(nexus_nasmount_var_run_t)
# backup agents listen on 7444/tcp (docs/agent-protocol.md)
type nexus_agent_port_t;
corenet_port(nexus_agent_port_t)
type nexus_replicad_var_lib_t;	# replication CA key + token-sealing key (nexus-replicad only)
files_type(nexus_replicad_var_lib_t)
type nexus_replicad_var_run_t;	# replicad socket, published ca.pem / seal.pub (web-api reads)
files_pid_file(nexus_replicad_var_run_t)
type nexus_replica_key_t;	# secondary: client key + certificate per replication source (nexus-replica only)
files_type(nexus_replica_key_t)
type nexus_console_unlock_t;	# console unlock codes (hashes): web-api writes, the console gate reads + deletes
files_type(nexus_console_unlock_t)
type nexus_consolegate_var_run_t;	# console gate: failed attempts (RuntimeDirectory=nexus-console-gate)
files_pid_file(nexus_consolegate_var_run_t)
type nexus_tls_web_t;		# /etc/nexus/tls/web.pem(.prev): imported chain + key (nexus-tls writes, web-api reads)
files_config_file(nexus_tls_web_t)
type nexus_tls_pending_t;	# /etc/nexus/tls/pending: key of a pending CSR (nexus-tls only)
files_type(nexus_tls_pending_t)
type nexus_tls_req_t;		# /var/lib/nexus/tls: requests (web-api) and answers (nexus-tls)
files_type(nexus_tls_req_t)

########################################
# Common to all nexus domains: the basics of a Rust program on glibc.

# own signals (thread cancellation), pipes and socketpairs between threads
allow nexus_domain self:process { signal_perms getsched };
allow nexus_domain self:fifo_file rw_fifo_file_perms;
allow nexus_domain self:unix_stream_socket create_stream_socket_perms;
# /proc/self (std::thread::available_parallelism reads cgroup + sched data), /proc/meminfo
kernel_read_system_state(nexus_domain)
# /sys/devices/system/cpu (available_parallelism), /sys/fs/cgroup quota
dev_read_sysfs(nexus_domain)
fs_read_cgroup_files(nexus_domain)
# getrandom() falls back to /dev/urandom early in boot
dev_read_urand(nexus_domain)
# locale and time zone data
miscfiles_read_localization(nexus_domain)
# stderr -> journal
logging_send_syslog_msg(nexus_domain)
# search /var/lib for /var/lib/nexus and /run for the runtime dirs
files_search_var_lib(nexus_domain)
files_search_pids(nexus_domain)
allow nexus_domain nexus_var_lib_t:dir search_dir_perms;

# Only keyd may ever touch the TPM (TPM sealing is deferred, the rule stays).
neverallow { nexus_domain -nexus_keyd_t } tpm_device_t:chr_file *;
# Key material: only keyd (and setup, which runs `keyd init` once) see it; the
# console gate reads it to check the recovery key (as recover-admin does).
neverallow { nexus_domain -nexus_keyd_t -nexus_setup_t -nexus_consolegate_t } nexus_keyd_var_lib_t:file { read open };
neverallow { nexus_domain -nexus_keyd_t -nexus_setup_t } nexus_keyd_var_lib_t:file write;
# The restore micro-VM (QEMU parsing untrusted guest disks) never reaches keys,
# stores, the catalog, downloads, credentials or job configs, nor the keyd socket
# (security review H-3: it shares the nexus-chunkstore uid, so MAC is the boundary).
neverallow nexus_restorevm_t { nexus_keyd_var_lib_t nexus_store_t nexus_escrow_t nexus_catalog_t nexus_downloads_t nexus_sshkey_t nexus_scheduler_var_run_t nexus_webapi_secret_t }:file { read write append open create unlink link rename setattr execute ioctl lock };
neverallow nexus_restorevm_t { nexus_keyd_var_run_t nexus_store_t nexus_catalog_t nexus_scheduler_var_run_t }:dir { search read write add_name };
neverallow nexus_restorevm_t nexus_keyd_t:unix_stream_socket connectto;
neverallow nexus_restorevm_t self:{ tcp_socket udp_socket } create;
# The agent CA keys sign agent certificates and authenticate the appliance to every
# agent: only nexus-agentctl reads them (not even the scheduler that spawns it).
neverallow { nexus_domain -nexus_agentctl_t } nexus_agent_ca_t:file { read open };
# The web API never reads chunks, keys or the PVE/SFTP credentials (nor the
# replication CA key: it only gets the CA certificate from replicad's runtime dir).
neverallow nexus_webapi_t { nexus_store_t nexus_keyd_var_lib_t nexus_sshkey_t nexus_scheduler_var_run_t nexus_replicad_var_lib_t nexus_replica_key_t }:file { read open };
# Replication (docs/replication.md): replicad serves the stores read-only, never
# reaches keyd and has no network; the replication CA key and the secondary's
# client keys are private to replicad / nexus-replica.
neverallow nexus_replicad_t nexus_store_t:file { write append create unlink rename setattr };
neverallow nexus_replicad_t nexus_store_t:dir { write add_name remove_name rmdir create };
# (connectto between daemons is granted by the base policy's `daemon` attribute:
# keyd's socket file is the boundary)
neverallow nexus_replicad_t nexus_keyd_var_run_t:sock_file { write open };
neverallow nexus_replicad_t { nexus_keyd_var_run_t nexus_catalog_t }:dir search;
neverallow nexus_replicad_t self:{ tcp_socket udp_socket } create;
neverallow { nexus_domain -nexus_replicad_t } nexus_replicad_var_lib_t:file { read open };
neverallow { nexus_domain -nexus_replica_t } nexus_replica_key_t:file { read open };

########################################
# keyd: own state + socket. No network (PrivateNetwork=yes in the unit as well).

manage_dirs_pattern(nexus_keyd_t, nexus_keyd_var_lib_t, nexus_keyd_var_lib_t)
manage_files_pattern(nexus_keyd_t, nexus_keyd_var_lib_t, nexus_keyd_var_lib_t)
# the listening socket in /run/nexus-keyd (dir created by systemd, RuntimeDirectory=)
manage_sock_files_pattern(nexus_keyd_t, nexus_keyd_var_run_t, nexus_keyd_var_run_t)
allow nexus_keyd_t self:unix_stream_socket { listen accept };
# resolve the allowed peer user name (nexus-chunkstore) to its uid
auth_read_passwd(nexus_keyd_t)
# mlockall(): keys never reach swap
allow nexus_keyd_t self:capability ipc_lock;
# TPM sealing (deferred): dev_rw_tpm(nexus_keyd_t)

########################################
# web-api: TLS on 8443, catalog (rw), downloads (read), its secrets (read).

allow nexus_webapi_t self:tcp_socket create_stream_socket_perms;
allow nexus_webapi_t self:tcp_socket { listen accept };
corenet_tcp_bind_generic_node(nexus_webapi_t)
# 8443 is http_port_t in the base policy
corenet_tcp_bind_http_port(nexus_webapi_t)
# Type=notify: READY=1 to /run/systemd/notify
init_write_pid_socket(nexus_webapi_t)
init_dgram_send(nexus_webapi_t)
# SQLite catalog: db, -wal, -shm, journal; locks
manage_files_pattern(nexus_webapi_t, nexus_catalog_t, nexus_catalog_t)
allow nexus_webapi_t nexus_catalog_t:dir rw_dir_perms;
allow nexus_webapi_t nexus_catalog_t:file map;
# GET /downloads/{token}: stream files the scheduler wrote
read_files_pattern(nexus_webapi_t, nexus_downloads_t, nexus_downloads_t)
# OS update control: request (stage/apply), window, inhibit; reads status.json
manage_files_pattern(nexus_webapi_t, nexus_update_t, nexus_update_t)
# setup-done (ConditionPathExists and the binary's own check)
read_files_pattern(nexus_webapi_t, nexus_var_lib_t, nexus_var_lib_t)
# OIDC sign-in (docs/phase12-contract.md §2): discovery, JWKS and token requests to
# the identity provider (443 = http_port_t; IdPs on other ports are unreserved).
# Destinations are limited by the nftables allow-list (issuer, token and JWKS hosts);
# trust anchors are compiled in or come from the OIDC settings (no system store).
corenet_tcp_connect_http_port(nexus_webapi_t)
corenet_tcp_connect_all_unreserved_ports(nexus_webapi_t)
allow nexus_webapi_t self:udp_socket create_socket_perms;
sysnet_dns_name_resolve(nexus_webapi_t)
# TLS key + cert, metrics token
allow nexus_webapi_t nexus_etc_t:dir search_dir_perms;
read_files_pattern(nexus_webapi_t, nexus_webapi_secret_t, nexus_webapi_secret_t)
files_search_etc(nexus_webapi_t)

########################################
# scheduler: catalog, stores, keyd, job runner, alert delivery.

# SQLite catalog (as web-api)
manage_files_pattern(nexus_scheduler_t, nexus_catalog_t, nexus_catalog_t)
allow nexus_scheduler_t nexus_catalog_t:dir rw_dir_perms;
allow nexus_scheduler_t nexus_catalog_t:file map;
# retention / gc / verify in-process; snapshot refresh; offsite inventory; alert cursor
manage_dirs_pattern(nexus_scheduler_t, nexus_store_t, nexus_store_t)
manage_files_pattern(nexus_scheduler_t, nexus_store_t, nexus_store_t)
# escrow files from keyd for the offsite upload
manage_dirs_pattern(nexus_scheduler_t, nexus_escrow_t, nexus_escrow_t)
manage_files_pattern(nexus_scheduler_t, nexus_escrow_t, nexus_escrow_t)
# downloads: chgrp/chmod of the dir at start, expiry deletes files written by nexus-pve
manage_dirs_pattern(nexus_scheduler_t, nexus_downloads_t, nexus_downloads_t)
manage_files_pattern(nexus_scheduler_t, nexus_downloads_t, nexus_downloads_t)
allow nexus_scheduler_t nexus_downloads_t:dir setattr_dir_perms;
allow nexus_scheduler_t self:capability { chown fowner };
# setup-done (unit condition), /var/lib/nexus statfs for the capacity alert
read_files_pattern(nexus_scheduler_t, nexus_var_lib_t, nexus_var_lib_t)
fs_getattr_xattr_fs(nexus_scheduler_t)
# job dirs with generated configs (0600) in /run/nexus-scheduler
manage_dirs_pattern(nexus_scheduler_t, nexus_scheduler_var_run_t, nexus_scheduler_var_run_t)
manage_files_pattern(nexus_scheduler_t, nexus_scheduler_var_run_t, nexus_scheduler_var_run_t)
# OS update control: maintenance window from the policies
manage_files_pattern(nexus_scheduler_t, nexus_update_t, nexus_update_t)
# outbound allow-list for nexus-nft-sync (atomic rename)
manage_files_pattern(nexus_scheduler_t, nexus_nft_var_run_t, nexus_nft_var_run_t)
# scheduler.json, alerts.json, smtp password file
read_files_pattern(nexus_scheduler_t, nexus_etc_t, nexus_etc_t)
# the appliance's own SSH keys (docs/phase12-contract.md §4): generated, rotated
# (<name>.next) and retired (rename over <name>) in /etc/nexus/ssh; the scheduler
# publishes only the public halves to the catalog
manage_files_pattern(nexus_scheduler_t, nexus_sshkey_t, nexus_sshkey_t)
files_search_etc(nexus_scheduler_t)
# tenant keyrings (ensure/escrow) from keyd
stream_connect_pattern(nexus_scheduler_t, nexus_keyd_var_run_t, nexus_keyd_var_run_t, nexus_keyd_t)
# alert delivery: webhook (http/https or any unreserved port) and SMTP; DNS;
# endpoint resolution for the allow-list. Destinations are limited by nftables.
allow nexus_scheduler_t self:tcp_socket create_stream_socket_perms;
allow nexus_scheduler_t self:udp_socket create_socket_perms;
corenet_tcp_connect_http_port(nexus_scheduler_t)
corenet_tcp_connect_smtp_port(nexus_scheduler_t)
corenet_tcp_connect_all_unreserved_ports(nexus_scheduler_t)
# audit / alert forwarding (forward.rs): syslog over TLS (6514, syslog_tls_port_t)
corenet_tcp_connect_syslog_tls_port(nexus_scheduler_t)
sysnet_dns_name_resolve(nexus_scheduler_t)
# rustls roots for the webhook (system trust store)
miscfiles_read_generic_certs(nexus_scheduler_t)
# hostname for alert texts
kernel_read_kernel_sysctls(nexus_scheduler_t)
auth_read_passwd(nexus_scheduler_t)
# spawn jobs: transition into their domains, collect their output, signal them
domtrans_pattern(nexus_scheduler_t, nexus_pve_exec_t, nexus_pve_t)
domtrans_pattern(nexus_scheduler_t, nexus_offsite_exec_t, nexus_offsite_t)
domtrans_pattern(nexus_scheduler_t, nexus_agentctl_exec_t, nexus_agentctl_t)
domtrans_pattern(nexus_scheduler_t, nexus_truenas_exec_t, nexus_truenas_t)
domtrans_pattern(nexus_scheduler_t, nexus_nas_exec_t, nexus_nas_t)
# the scheduler runs with NoNewPrivileges, inherited by its jobs
allow nexus_scheduler_t nexus_job_domain:process2 { nnp_transition nosuid_transition };
allow nexus_scheduler_t nexus_job_domain:process { sigkill signal };
# cancelling a running job (13b): each job runs in its own process group, which the
# scheduler signals as a whole (a plugin host keeps its plugins in their own groups)
allow nexus_scheduler_t self:process setpgid;
allow nexus_job_domain nexus_scheduler_t:fd use;
allow nexus_job_domain nexus_scheduler_t:fifo_file rw_inherited_fifo_file_perms;
allow nexus_job_domain nexus_scheduler_t:process sigchld;
corecmd_search_bin(nexus_scheduler_t)

########################################
# Jobs (nexus-pve, nexus-offsite): read their job dir, use the tenant store
# and keyd. Same Unix user as the scheduler, different domains.

allow nexus_job_domain nexus_scheduler_var_run_t:dir list_dir_perms;
read_files_pattern(nexus_job_domain, nexus_scheduler_var_run_t, nexus_scheduler_var_run_t)
manage_dirs_pattern(nexus_job_domain, nexus_store_t, nexus_store_t)
manage_files_pattern(nexus_job_domain, nexus_store_t, nexus_store_t)
stream_connect_pattern(nexus_job_domain, nexus_keyd_var_run_t, nexus_keyd_var_run_t, nexus_keyd_t)
allow nexus_job_domain self:tcp_socket create_stream_socket_perms;
allow nexus_job_domain self:udp_socket create_socket_perms;
sysnet_dns_name_resolve(nexus_job_domain)
auth_read_passwd(nexus_job_domain)
# keys and known_hosts referenced by the source / offsite config
allow nexus_job_domain nexus_etc_t:dir search_dir_perms;
read_files_pattern(nexus_job_domain, nexus_sshkey_t, nexus_sshkey_t)
files_search_etc(nexus_job_domain)

# --- nexus-pve: PVE API (TLS, pinned CA from the job dir), ssh to the nodes,
# file-restore downloads, the restore micro-VM.
# PVE API is 8006 (unreserved); SSH is 22 or a NAT-forwarded unreserved port.
corenet_tcp_connect_all_unreserved_ports(nexus_pve_t)
corenet_tcp_connect_ssh_port(nexus_pve_t)
# /usr/bin/ssh runs in this domain (no transition to the user-oriented ssh_t)
can_exec(nexus_pve_t, ssh_exec_t)
corecmd_search_bin(nexus_pve_t)
# ssh: system crypto policy and ssh_config under /etc
files_read_etc_files(nexus_pve_t)
# ssh looks for ~/.ssh of a user whose home is / ; nothing to find
files_dontaudit_search_home(nexus_pve_t)
# files_get writes <downloads>/<token>.<fmt>
manage_files_pattern(nexus_pve_t, nexus_downloads_t, nexus_downloads_t)
allow nexus_pve_t nexus_downloads_t:dir rw_dir_perms;
# restore micro-VM work dir under the private /tmp, sockets for NBD + agent
files_search_tmp(nexus_pve_t)
manage_dirs_pattern(nexus_pve_t, nexus_pve_tmp_t, nexus_pve_tmp_t)
manage_files_pattern(nexus_pve_t, nexus_pve_tmp_t, nexus_pve_tmp_t)
manage_sock_files_pattern(nexus_pve_t, nexus_pve_tmp_t, nexus_pve_tmp_t)
files_tmp_filetrans(nexus_pve_t, nexus_pve_tmp_t, dir)
allow nexus_pve_t self:unix_stream_socket { listen accept connectto };
# checks that kernel + initramfs exist before starting QEMU
list_dirs_pattern(nexus_pve_t, nexus_restorevm_image_t, nexus_restorevm_image_t)
allow nexus_pve_t nexus_restorevm_image_t:file getattr;
# /dev/kvm probe (kvm_usable()) before choosing accel=kvm
dev_rw_kvm(nexus_pve_t)
# QEMU runs in its own domain; nexus-pve kills it when done
domtrans_pattern(nexus_pve_t, qemu_exec_t, nexus_restorevm_t)
allow nexus_pve_t nexus_restorevm_t:process2 { nnp_transition nosuid_transition };
allow nexus_pve_t nexus_restorevm_t:process { sigkill signal };
allow nexus_restorevm_t nexus_pve_t:fd use;
allow nexus_restorevm_t nexus_pve_t:fifo_file rw_inherited_fifo_file_perms;
allow nexus_restorevm_t nexus_pve_t:process sigchld;

# --- nexus-offsite: SFTP to the boxes (Storage Box: 23 and 22; lab: unreserved)
# and HTTPS to S3 endpoints (443 = http_port_t; MinIO/on-prem 9000 etc. =
# unreserved). Trust anchors are compiled in or come from the job dir (ca_file),
# so no access to the system certificate store is needed; DNS via nexus_job_domain.
corenet_tcp_connect_telnetd_port(nexus_offsite_t)
corenet_tcp_connect_ssh_port(nexus_offsite_t)
corenet_tcp_connect_http_port(nexus_offsite_t)
corenet_tcp_connect_all_unreserved_ports(nexus_offsite_t)
# wrapped key escrow is uploaded with the packs
read_files_pattern(nexus_offsite_t, nexus_escrow_t, nexus_escrow_t)
list_dirs_pattern(nexus_offsite_t, nexus_escrow_t, nexus_escrow_t)

########################################
# Restore micro-VM (QEMU, -sandbox on, no NIC): kernel + initramfs, /dev/kvm,
# the NBD and agent sockets and console log in nexus-pve's work dir. Nothing else:
# no network, no other files, no devices.

read_files_pattern(nexus_restorevm_t, nexus_restorevm_image_t, nexus_restorevm_image_t)
allow nexus_restorevm_t nexus_restorevm_image_t:file map;
list_dirs_pattern(nexus_restorevm_t, nexus_restorevm_image_t, nexus_restorevm_image_t)
files_search_usr(nexus_restorevm_t)
dev_rw_kvm(nexus_restorevm_t)
stream_connect_pattern(nexus_restorevm_t, nexus_pve_tmp_t, nexus_pve_tmp_t, nexus_pve_t)
# -serial file:<workdir>/console.log
create_files_pattern(nexus_restorevm_t, nexus_pve_tmp_t, nexus_pve_tmp_t)
rw_files_pattern(nexus_restorevm_t, nexus_pve_tmp_t, nexus_pve_tmp_t)
files_search_tmp(nexus_restorevm_t)
# QEMU binary, its module directory and firmware (SeaBIOS, option ROMs)
files_read_usr_files(nexus_restorevm_t)
corecmd_search_bin(nexus_restorevm_t)
# guest RAM (memfd/anon), vCPU threads, -sandbox installs its seccomp filter
allow nexus_restorevm_t self:process { setsched setrlimit };
allow nexus_restorevm_t self:unix_dgram_socket create_socket_perms;
fs_rw_tmpfs_files(nexus_restorevm_t)
dev_read_rand(nexus_restorevm_t)

########################################
# setup (root, first boot): catalog, keyd init, TLS/metrics token, setup-done,
# then nmcli / hostnamectl / systemctl over D-Bus and the systemd socket.

allow nexus_setup_t self:capability { chown fowner dac_override dac_read_search ipc_lock };
# The unit runs the wizard in a restart loop (ExecStart=/bin/sh -c ...): the shell is
# initrc_t, and with NoNewPrivileges=yes its exec of nexus-setup needs nnp_transition,
# or the wizard silently stays in initrc_t (lab: SELINUX_ERR bounded transition at first boot)
allow initrc_t nexus_setup_t:process2 { nnp_transition nosuid_transition };
manage_dirs_pattern(nexus_setup_t, nexus_var_lib_t, nexus_var_lib_t)
manage_files_pattern(nexus_setup_t, nexus_var_lib_t, nexus_var_lib_t)
manage_dirs_pattern(nexus_setup_t, nexus_catalog_t, nexus_catalog_t)
manage_files_pattern(nexus_setup_t, nexus_catalog_t, nexus_catalog_t)
allow nexus_setup_t nexus_catalog_t:file map;
# keyd init (KEK + recovery escrow) and chown to nexus-keyd
manage_dirs_pattern(nexus_setup_t, nexus_keyd_var_lib_t, nexus_keyd_var_lib_t)
manage_files_pattern(nexus_setup_t, nexus_keyd_var_lib_t, nexus_keyd_var_lib_t)
# /etc/nexus/tls, metrics-token
manage_dirs_pattern(nexus_setup_t, nexus_etc_t, nexus_etc_t)
manage_dirs_pattern(nexus_setup_t, nexus_webapi_secret_t, nexus_webapi_secret_t)
manage_files_pattern(nexus_setup_t, nexus_webapi_secret_t, nexus_webapi_secret_t)
filetrans_pattern(nexus_setup_t, nexus_etc_t, nexus_webapi_secret_t, dir, "tls")
filetrans_pattern(nexus_setup_t, nexus_etc_t, nexus_webapi_secret_t, file, "metrics-token")
filetrans_pattern(nexus_setup_t, nexus_etc_t, nexus_webapi_secret_t, file, ".metrics-token.tmp")
# boot menu password hash (crates/setup/src/grub.rs); nexus-grub-password (root, unconfined_service_t
# like nexus-update: it remounts /boot) copies it to /boot/grub2/user.cfg
manage_files_pattern(nexus_setup_t, nexus_grub_user_t, nexus_grub_user_t)
filetrans_pattern(nexus_setup_t, nexus_etc_t, nexus_grub_user_t, file, "grub-user.cfg")
filetrans_pattern(nexus_setup_t, nexus_etc_t, nexus_grub_user_t, file, ".grub-user.cfg.tmp")
files_search_etc(nexus_setup_t)
# user/group names for chown (nss: files, then systemd-userdbd), hostname, NIC list
auth_read_passwd(nexus_setup_t)
systemd_userdbd_stream_connect(nexus_setup_t)
# script mode (lab/tests): answers file placed in /etc/nexus by the operator
read_files_pattern(nexus_setup_t, nexus_etc_t, nexus_etc_t)
kernel_read_kernel_sysctls(nexus_setup_t)
kernel_read_network_state(nexus_setup_t)
allow nexus_setup_t self:netlink_route_socket r_netlink_socket_perms;
# the wizard's terminal (tty1), and the TUI's /dev/tty
term_use_unallocated_ttys(nexus_setup_t)
term_use_generic_ptys(nexus_setup_t)
term_use_controlling_term(nexus_setup_t)
# nmcli, hostnamectl (bin_t) and systemctl run in this domain
corecmd_exec_bin(nexus_setup_t)
systemd_exec_systemctl(nexus_setup_t)
files_read_etc_files(nexus_setup_t)
files_read_usr_files(nexus_setup_t)
# D-Bus: NetworkManager (profile nexus-mgmt), hostnamed (set-hostname), systemd
dbus_system_bus_client(nexus_setup_t)
networkmanager_dbus_chat(nexus_setup_t)
systemd_dbus_chat_hostnamed(nexus_setup_t)
init_dbus_chat(nexus_setup_t)
# systemctl enable --now: talk to PID 1, reload, enable + start the nexus units only
init_stream_connect(nexus_setup_t)
init_read_state(nexus_setup_t)
allow nexus_setup_t init_t:system { reload status };
allow nexus_setup_t nexus_unit_file_t:service { start status enable };
allow nexus_setup_t nexus_unit_file_t:file read_file_perms;
systemd_search_unit_dirs(nexus_setup_t)
allow nexus_setup_t self:unix_dgram_socket create_socket_perms;

########################################
# nft-sync (root oneshot): read the allow-list, resolv.conf, chrony.conf;
# resolve NTS names; run nft (iptables_t) with the script on stdin.

allow nexus_nftsync_t nexus_nft_var_run_t:dir list_dir_perms;
# its own state (RuntimeDirectory=nexus-nft-sync)
manage_files_pattern(nexus_nftsync_t, nexus_nftsync_var_run_t, nexus_nftsync_var_run_t)
# status.json for the web UI (/run/nexus-nft-status, tmpfiles: 0755 root; temp file + rename)
manage_files_pattern(nexus_nftsync_t, nexus_nftstatus_var_run_t, nexus_nftstatus_var_run_t)
read_files_pattern(nexus_nftsync_t, nexus_nft_var_run_t, nexus_nft_var_run_t)
sysnet_read_config(nexus_nftsync_t)
# chrony.conf (etc_t) for the NTS server names
files_read_etc_files(nexus_nftsync_t)
# /etc/nexus/allowed-hosts (static OS destinations, e.g. the update registry)
read_files_pattern(nexus_nftsync_t, nexus_etc_t, nexus_etc_t)
sysnet_dns_name_resolve(nexus_nftsync_t)
allow nexus_nftsync_t self:udp_socket create_socket_perms;
allow nexus_nftsync_t self:tcp_socket create_stream_socket_perms;
corecmd_search_bin(nexus_nftsync_t)
iptables_domtrans(nexus_nftsync_t)
allow nexus_nftsync_t iptables_t:process2 { nnp_transition nosuid_transition };
# nft reads the script from our pipe and writes errors to our stderr
allow iptables_t nexus_nftsync_t:fd use;
allow iptables_t nexus_nftsync_t:fifo_file rw_inherited_fifo_file_perms;
allow iptables_t nexus_nftsync_t:process sigchld;

########################################
# Review H-2: sealed catalog secrets
# The scheduler alone creates and reads its sealing key (created with O_EXCL, no temp file).
manage_files_pattern(nexus_scheduler_t, nexus_store_t, nexus_scheduler_secret_t)
filetrans_pattern(nexus_scheduler_t, nexus_store_t, nexus_scheduler_secret_t, file, "secrets.key")
neverallow { nexus_domain -nexus_scheduler_t } nexus_scheduler_secret_t:file { read open };
# web-api state dir holds the TOTP seed key; setup creates it on first boot (as root,
# chowned to nexus-webapi), web-api creates it only if missing and no seed is encrypted yet.
manage_files_pattern(nexus_webapi_t, nexus_webapi_var_lib_t, nexus_webapi_var_lib_t)
manage_dirs_pattern(nexus_setup_t, nexus_webapi_var_lib_t, nexus_webapi_var_lib_t)
manage_files_pattern(nexus_setup_t, nexus_webapi_var_lib_t, nexus_webapi_var_lib_t)
filetrans_pattern(nexus_setup_t, nexus_var_lib_t, nexus_webapi_var_lib_t, dir, "webapi")
neverallow { nexus_domain -nexus_webapi_t -nexus_setup_t } nexus_webapi_var_lib_t:file { read open };

########################################
# nexus-agentctl (crate agent-conn): backup/restore/update/enrollment of Linux and
# Windows agents over TLS (agents listen, the appliance connects), tree snapshots in
# the tenant store (job domain rules above: job dir, store, keyd), its mapping index
# <store>/agent-map.db, the agent CA, file downloads. No catalog: the scheduler
# passes everything in the job config and records the results.

# agents on 7444 (nexus_agent_port_t) or another configured port (unreserved)
allow nexus_agentctl_t nexus_agent_port_t:tcp_socket name_connect;
corenet_tcp_connect_all_unreserved_ports(nexus_agentctl_t)
# agent-map.db is SQLite in WAL mode (the -shm file is mmapped)
allow nexus_agentctl_t nexus_store_t:file map;
# the CA dir is created on first use below the scheduler state dir (nexus_store_t)
manage_dirs_pattern(nexus_agentctl_t, nexus_agent_ca_t, nexus_agent_ca_t)
manage_files_pattern(nexus_agentctl_t, nexus_agent_ca_t, nexus_agent_ca_t)
filetrans_pattern(nexus_agentctl_t, nexus_store_t, nexus_agent_ca_t, dir, "agent-ca")
# files get: tar/zip downloads for the web-api
manage_files_pattern(nexus_agentctl_t, nexus_downloads_t, nexus_downloads_t)
allow nexus_agentctl_t nexus_downloads_t:dir rw_dir_perms;
# signed agent binaries for agent_update (/usr/share/nexus/agent)
files_read_usr_files(nexus_agentctl_t)

########################################
# nexus-truenas (crate truenas, docs/truenas-connector.md): TrueNAS JSON-RPC API over
# wss (certificate pinned from the job dir), /usr/bin/ssh to the restricted user's
# forced command (key + pinned host key from the job dir), tree snapshots in the
# tenant store (job domain rules: job dir, store, keyd), file downloads. No catalog.

# API on 443 (http_port_t) or another configured port; SSH on 22 or unreserved (NAT)
corenet_tcp_connect_http_port(nexus_truenas_t)
corenet_tcp_connect_ssh_port(nexus_truenas_t)
corenet_tcp_connect_all_unreserved_ports(nexus_truenas_t)
# /usr/bin/ssh runs in this domain (no transition to the user-oriented ssh_t)
can_exec(nexus_truenas_t, ssh_exec_t)
corecmd_search_bin(nexus_truenas_t)
# ssh: system crypto policy and ssh_config under /etc
files_read_etc_files(nexus_truenas_t)
# ssh looks for ~/.ssh of a user whose home is / ; nothing to find
files_dontaudit_search_home(nexus_truenas_t)
# files get: tar/zip downloads for the web-api
manage_files_pattern(nexus_truenas_t, nexus_downloads_t, nexus_downloads_t)
allow nexus_truenas_t nexus_downloads_t:dir rw_dir_perms;

########################################
# NAS shares (crate nas, docs/nas-connector.md). Decision: kernel NFS/CIFS mounts,
# read-only, in a private mount namespace, by a small privileged helper.
#
# nexus-nasmount (root, CAP_SYS_ADMIN only, socket-activated per connection by
# nexus-nasmount.socket): builds one mount with fsopen/fsconfig/fsmount, detached
# (an anonymous mount namespace no process lives in), ro,nosuid,nodev,noexec,
# nosymfollow, and passes the mount fd to the connector. It never attaches a mount
# anywhere (no move_mount, no mounton on any directory), has no file access beyond
# its runtime dirs, and opens no sockets itself (the NFS/SMB connections belong to
# the kernel).

# systemd creates /run/nexus-nasmount/mount.sock and the per-instance runtime dirs
init_named_socket_activation(nexus_nasmount_t, nexus_nasmount_var_run_t, "nexus-nasmount")
# the accepted connection on fd 0 (StandardInput=socket): systemd labels activation
# sockets with the service domain, so the connection is its own socket
allow nexus_nasmount_t self:unix_stream_socket { getattr getopt setopt read write shutdown };
# building the mount: only NFS and CIFS superblocks
allow nexus_nasmount_t self:capability sys_admin;
fs_mount_nfs(nexus_nasmount_t)
fs_mount_cifs(nexus_nasmount_t)
allow nexus_nasmount_t { nfs_t cifs_t }:filesystem getattr;
# NFSv4 walks from the pseudo root to the export path as the mounting process
allow nexus_nasmount_t { nfs_t cifs_t }:dir { getattr search };
# fsopen("nfs4"/"cifs") loads the file system module on first use
kernel_request_load_module(nexus_nasmount_t)
# peer check: NEXUS_NASMOUNT_ALLOW_USER -> uid
auth_read_passwd(nexus_nasmount_t)
# SMB Kerberos (sec=krb5): keytab + ticket cache in its private runtime dir, kinit (bin_t)
manage_dirs_pattern(nexus_nasmount_t, nexus_nasmount_var_run_t, nexus_nasmount_var_run_t)
manage_files_pattern(nexus_nasmount_t, nexus_nasmount_var_run_t, nexus_nasmount_var_run_t)
corecmd_exec_bin(nexus_nasmount_t)
files_read_etc_files(nexus_nasmount_t)
sysnet_dns_name_resolve(nexus_nasmount_t)
corenet_tcp_connect_kerberos_port(nexus_nasmount_t)
allow nexus_nasmount_t self:key { create write search view link setattr };
neverallow nexus_nasmount_t { nexus_store_t nexus_keyd_var_lib_t nexus_catalog_t nexus_scheduler_var_run_t nexus_sshkey_t }:file { read write append open create unlink link rename setattr execute ioctl lock };

# nexus-nas: connects to the helper, receives the mount fd and reads the share
# through it (never mounts, never writes there); tree snapshots in the tenant store
# (job domain rules: job dir, store, keyd); file downloads.
allow nexus_nas_t nexus_nasmount_var_run_t:dir search_dir_perms;
allow nexus_nas_t nexus_nasmount_var_run_t:sock_file write;
# systemd creates the listening socket in the service domain (socket activation)
allow nexus_nas_t nexus_nasmount_t:unix_stream_socket connectto;
allow nexus_nas_t nexus_nasmount_t:fd use;
allow nexus_nas_t { nfs_t cifs_t }:filesystem getattr;
allow nexus_nas_t { nfs_t cifs_t }:dir list_dir_perms;
allow nexus_nas_t { nfs_t cifs_t }:file read_file_perms;
allow nexus_nas_t { nfs_t cifs_t }:lnk_file { getattr read };
allow nexus_nas_t { nfs_t cifs_t }:{ fifo_file sock_file chr_file blk_file } getattr;
neverallow nexus_nas_t { nfs_t cifs_t }:file { write append create unlink setattr relabelfrom };
neverallow nexus_nas_t { nfs_t cifs_t }:filesystem { mount remount unmount };
# files get: tar/zip downloads for the web-api
manage_files_pattern(nexus_nas_t, nexus_downloads_t, nexus_downloads_t)
allow nexus_nas_t nexus_downloads_t:dir rw_dir_perms;
# Replication (docs/replication.md).
#
# nexus-replicad (primary): reads the tenant stores (sealed manifests, indexes,
# chunks) and serves them to the web-api over its Unix socket; keeps the
# replication CA and the token-sealing key; no network, no keyd, no catalog.

list_dirs_pattern(nexus_replicad_t, nexus_store_t, nexus_store_t)
read_files_pattern(nexus_replicad_t, nexus_store_t, nexus_store_t)
manage_dirs_pattern(nexus_replicad_t, nexus_replicad_var_lib_t, nexus_replicad_var_lib_t)
manage_files_pattern(nexus_replicad_t, nexus_replicad_var_lib_t, nexus_replicad_var_lib_t)
# runtime dir (RuntimeDirectory=): socket, ca.pem, seal.pub (written via tmp + rename)
manage_sock_files_pattern(nexus_replicad_t, nexus_replicad_var_run_t, nexus_replicad_var_run_t)
manage_files_pattern(nexus_replicad_t, nexus_replicad_var_run_t, nexus_replicad_var_run_t)
allow nexus_replicad_t nexus_replicad_var_run_t:dir rw_dir_perms;
allow nexus_replicad_t self:unix_stream_socket { listen accept };
# resolve the allowed peer user (nexus-webapi) to its uid
auth_read_passwd(nexus_replicad_t)

# web-api: connect to replicad only, read the published CA certificate + sealing key
stream_connect_pattern(nexus_webapi_t, nexus_replicad_var_run_t, nexus_replicad_var_run_t, nexus_replicad_t)
read_files_pattern(nexus_webapi_t, nexus_replicad_var_run_t, nexus_replicad_var_run_t)
# Settings -> Firewall: the effective sets and blocked attempts nexus-nft-sync publishes
read_files_pattern(nexus_webapi_t, nexus_nftstatus_var_run_t, nexus_nftstatus_var_run_t)

# nexus-replica (secondary, job domain like nexus-offsite: job dir, stores, keyd):
# outbound TLS to the primary's management port (8443 = http_port_t; NAT-forwarded
# lab ports are unreserved), its client key + certificate per replication source.
domtrans_pattern(nexus_scheduler_t, nexus_replica_exec_t, nexus_replica_t)
corenet_tcp_connect_http_port(nexus_replica_t)
corenet_tcp_connect_all_unreserved_ports(nexus_replica_t)
manage_dirs_pattern(nexus_replica_t, nexus_replica_key_t, nexus_replica_key_t)
manage_files_pattern(nexus_replica_t, nexus_replica_key_t, nexus_replica_key_t)
filetrans_pattern(nexus_replica_t, nexus_store_t, nexus_replica_key_t, dir, "replica")

########################################
# Plugins (docs/plugin-system.md). Trust split: nexus-pluginhost (trusted job domain)
# does everything security-relevant (chunking, sealing, store, keyd, downloads); the
# plugin binary (nexus_plugin_t) is untrusted code that only talks to its source system
# and streams to the host over stdin/stdout. The plugin runs as the scheduler's uid
# (nexus-chunkstore), so this policy -- with Landlock, seccomp and rlimits set by
# nexus-pluginhost and the nftables allow-list -- is the boundary.

# --- nexus-pluginhost (job domain: job dir, stores, keyd, DNS like the other connectors)
domtrans_pattern(nexus_scheduler_t, nexus_pluginhost_exec_t, nexus_pluginhost_t)
# reads manifest.json and follows <id>/current to the installed version; opens bin/plugin
# (fd for execveat; the domtrans_pattern below grants read + execute on it)
list_dirs_pattern(nexus_pluginhost_t, nexus_plugin_data_t, nexus_plugin_data_t)
read_files_pattern(nexus_pluginhost_t, nexus_plugin_data_t, nexus_plugin_data_t)
read_lnk_files_pattern(nexus_pluginhost_t, nexus_plugin_data_t, nexus_plugin_data_t)
# files get on plugin sources: tar/zip downloads for the web-api
manage_files_pattern(nexus_pluginhost_t, nexus_downloads_t, nexus_downloads_t)
allow nexus_pluginhost_t nexus_downloads_t:dir rw_dir_perms;
# the plugin's private tmp dir below the scheduler's PrivateTmp /tmp: created with its
# own type, wiped by the host after the job (including whatever the plugin left in it)
files_search_tmp(nexus_pluginhost_t)
files_tmp_filetrans(nexus_pluginhost_t, nexus_plugin_tmp_t, dir)
manage_dirs_pattern(nexus_pluginhost_t, nexus_plugin_tmp_t, nexus_plugin_tmp_t)
manage_files_pattern(nexus_pluginhost_t, nexus_plugin_tmp_t, nexus_plugin_tmp_t)
manage_lnk_files_pattern(nexus_pluginhost_t, nexus_plugin_tmp_t, nexus_plugin_tmp_t)
# sandbox set up in the forked child before execveat: setpgid (the host kills the
# whole process group), lowered hard rlimits (setrlimit), nice 10 (setsched)
allow nexus_pluginhost_t self:process { setpgid setrlimit setsched };

# --- pluginhost -> plugin: entered only through nexus_plugin_exec_t
domtrans_pattern(nexus_pluginhost_t, nexus_plugin_exec_t, nexus_plugin_t)
# the scheduler's NoNewPrivileges is inherited, and the host sets NO_NEW_PRIVS itself
allow nexus_pluginhost_t nexus_plugin_t:process2 { nnp_transition nosuid_transition };
# timeouts / cancellation / end of job: kill the plugin's process group
allow nexus_pluginhost_t nexus_plugin_t:process { sigkill signal };
# rlimitinh: keep the lowered soft limits the host set (otherwise reset to init's soft
# limits, capped by the hard limits). noatsecure: no AT_SECURE exec, which would clear
# PR_SET_PDEATHSIG (the plugin must die with its host); the host clears the environment
# anyway, so glibc's AT_SECURE environment filtering would have nothing to remove.
allow nexus_pluginhost_t nexus_plugin_t:process { rlimitinh noatsecure };
# domtrans_pattern gave the plugin: fd use, the host's pipes (stdin/stdout protocol,
# stderr log), sigchld. The mount op hands over an NBD socketpair end (plugin-system.md).
allow nexus_plugin_t nexus_pluginhost_t:unix_stream_socket { getattr getopt setopt read write shutdown };

# --- nexus_plugin_t: what a sandboxed plugin process may do, and nothing else
# own process: signals between its threads/children, pipes to tools it runs
allow nexus_plugin_t self:process { signal_perms getsched };
allow nexus_plugin_t self:fifo_file rw_fifo_file_perms;
# its install dir (manifest, assets) and its own binary (re-exec in-domain allowed),
# reached through /var/lib/nexus (search only: every other child has its own type)
files_search_var_lib(nexus_plugin_t)
allow nexus_plugin_t nexus_var_lib_t:dir search_dir_perms;
list_dirs_pattern(nexus_plugin_t, nexus_plugin_data_t, nexus_plugin_data_t)
read_files_pattern(nexus_plugin_t, nexus_plugin_data_t, nexus_plugin_data_t)
read_lnk_files_pattern(nexus_plugin_t, nexus_plugin_data_t, nexus_plugin_data_t)
can_exec(nexus_plugin_t, nexus_plugin_exec_t)
# dynamically linked plugins: ld.so, ld.so.cache, the image's shared libraries
libs_use_ld_so(nexus_plugin_t)
libs_use_shared_libs(nexus_plugin_t)
# client tools of the image (pg_dump, tar, sh, ...) run in this domain, no transition
corecmd_exec_bin(nexus_plugin_t)
corecmd_exec_shell(nexus_plugin_t)
# the SSH client (plugin truenas: forced-command streams) runs in this domain, no
# transition to ssh_t; its key and known_hosts live in the plugin's tmp dir
can_exec(nexus_plugin_t, ssh_exec_t)
files_read_usr_files(nexus_plugin_t)
files_list_usr(nexus_plugin_t)
# /etc: generic config files (nsswitch.conf, hosts, crypto-policies, ...), locale and
# time zone, the system trust store (TLS to the source), resolv.conf. Deliberately not
# sysnet_read_config / sysnet_dns_name_resolve: on EL those search every runtime dir
# (files_search_all_pids), which includes keyd's socket dir.
files_read_etc_files(nexus_plugin_t)
# /etc/passwd + /etc/group (passwd_file_t, no hashes): ssh in the sandbox resolves its own uid
allow nexus_plugin_t passwd_file_t:file read_file_perms;
miscfiles_read_localization(nexus_plugin_t)
miscfiles_read_generic_certs(nexus_plugin_t)
allow nexus_plugin_t net_conf_t:dir list_dir_perms;
read_files_pattern(nexus_plugin_t, net_conf_t, net_conf_t)
read_lnk_files_pattern(nexus_plugin_t, net_conf_t, net_conf_t)
# /dev/null (stdin of tools), /dev/zero, /dev/urandom (getrandom fallback)
dev_rw_null(nexus_plugin_t)
dev_rw_zero(nexus_plugin_t)
dev_read_urand(nexus_plugin_t)
# its private tmp dir (HOME=TMPDIR): files, dirs, symlinks; never executable (below)
files_search_tmp(nexus_plugin_t)
manage_dirs_pattern(nexus_plugin_t, nexus_plugin_tmp_t, nexus_plugin_tmp_t)
manage_files_pattern(nexus_plugin_t, nexus_plugin_tmp_t, nexus_plugin_tmp_t)
manage_lnk_files_pattern(nexus_plugin_t, nexus_plugin_tmp_t, nexus_plugin_tmp_t)
# network: TCP client to any port (the ports a plugin may reach are limited by Landlock
# to its manifest's endpoints and by the nftables allow-list to the configured hosts),
# DNS over UDP, getaddrinfo's netlink route query (AI_ADDRCONFIG). No listen/accept.
allow nexus_plugin_t self:tcp_socket create_socket_perms;
allow nexus_plugin_t self:udp_socket create_socket_perms;
allow nexus_plugin_t self:netlink_route_socket r_netlink_socket_perms;
corenet_tcp_connect_all_ports(nexus_plugin_t)
corenet_tcp_sendrecv_generic_if(nexus_plugin_t)
corenet_udp_sendrecv_generic_if(nexus_plugin_t)
corenet_tcp_sendrecv_generic_node(nexus_plugin_t)
corenet_udp_sendrecv_generic_node(nexus_plugin_t)
corenet_udp_sendrecv_dns_port(nexus_plugin_t)
corenet_sendrecv_dns_client_packets(nexus_plugin_t)
# std::thread::available_parallelism and glibc probe /proc and cgroup files: denied
# quietly (Landlock denies them as well); the callers fall back.
kernel_dontaudit_read_system_state(nexus_plugin_t)
dev_dontaudit_search_sysfs(nexus_plugin_t)
fs_dontaudit_search_cgroup_dirs(nexus_plugin_t)

# Plugin boundary (neverallow: checked when the module is linked into the policy).
# Entered only through its own exec type, and only from nexus-pluginhost.
neverallow nexus_plugin_t ~nexus_plugin_exec_t:file entrypoint;
neverallow { nexus_domain -nexus_pluginhost_t } nexus_plugin_t:process transition;
# No nexus data: keys, stores, escrow, catalog, downloads, credentials, job configs
# (secrets), web-api / scheduler secrets, agent CA, replication keys, /etc/nexus,
# staged bundles, service sockets; not even a directory search into them.
neverallow nexus_plugin_t { nexus_keyd_var_lib_t nexus_store_t nexus_escrow_t nexus_catalog_t nexus_downloads_t nexus_sshkey_t nexus_scheduler_var_run_t nexus_webapi_secret_t nexus_tls_web_t nexus_tls_pending_t nexus_tls_req_t nexus_webapi_var_lib_t nexus_scheduler_secret_t nexus_agent_ca_t nexus_replicad_var_lib_t nexus_replica_key_t nexus_etc_t nexus_plugin_staging_t nexus_keyd_var_run_t nexus_replicad_var_run_t nexus_nasmount_var_run_t }:{ file lnk_file sock_file } { read write append open create unlink link rename setattr execute ioctl lock };
neverallow nexus_plugin_t { nexus_keyd_var_lib_t nexus_keyd_var_run_t nexus_store_t nexus_escrow_t nexus_catalog_t nexus_downloads_t nexus_sshkey_t nexus_scheduler_var_run_t nexus_webapi_secret_t nexus_tls_web_t nexus_tls_pending_t nexus_tls_req_t nexus_webapi_var_lib_t nexus_agent_ca_t nexus_replicad_var_lib_t nexus_replicad_var_run_t nexus_replica_key_t nexus_etc_t nexus_plugin_staging_t nexus_nasmount_var_run_t }:dir { search read write add_name };
# No connection to any nexus service socket (keyd!), no capabilities, no server sockets.
neverallow nexus_plugin_t nexus_domain:unix_stream_socket connectto;
neverallow nexus_plugin_t nexus_domain:unix_dgram_socket sendto;
neverallow nexus_plugin_t self:{ capability capability2 cap_userns cap2_userns } *;
neverallow nexus_plugin_t self:tcp_socket { listen accept };
# Its own code and data are read-only to it; nothing it writes is executable.
neverallow nexus_plugin_t { nexus_plugin_data_t nexus_plugin_exec_t }:{ file lnk_file } { write append create unlink rename link setattr relabelfrom relabelto };
neverallow nexus_plugin_t nexus_plugin_data_t:dir { write add_name remove_name create rmdir rename reparent setattr };
neverallow nexus_plugin_t nexus_plugin_tmp_t:file { execute execute_no_trans entrypoint };
# Only the installer writes installed plugins (not the host, not the web-api, not setup).
neverallow { nexus_domain -nexus_plugininstall_t } { nexus_plugin_data_t nexus_plugin_exec_t }:{ file lnk_file } { write append create unlink rename link setattr relabelto };
neverallow { nexus_domain -nexus_plugininstall_t } nexus_plugin_data_t:dir { write add_name remove_name create rmdir rename reparent setattr };

# --- nexus-plugin-install (oneshot, user nexus-plugins, no network): verifies approved
# bundles from the staging dir against the project + publisher keys, unpacks them into
# /var/lib/nexus/plugins/<id>/.<version>.tmp, renames that to <version>, switches
# <id>/current, records the result in the catalog and deletes the staged files.
# SQLite catalog (WAL, as web-api)
manage_files_pattern(nexus_plugininstall_t, nexus_catalog_t, nexus_catalog_t)
allow nexus_plugininstall_t nexus_catalog_t:dir rw_dir_perms;
allow nexus_plugininstall_t nexus_catalog_t:file map;
# setup-done (unit condition and the binary's own check)
read_files_pattern(nexus_plugininstall_t, nexus_var_lib_t, nexus_var_lib_t)
# staged bundles + signatures: read, then delete (never create: that is the web-api)
allow nexus_plugininstall_t nexus_plugin_staging_t:dir rw_dir_perms;
allow nexus_plugininstall_t nexus_plugin_staging_t:file { read_file_perms unlink };
# install tree: dirs, files, the current symlink; bin/plugin gets the exec type by its
# name (the unpacker must create it under exactly that name, not a temp name + rename)
manage_dirs_pattern(nexus_plugininstall_t, nexus_plugin_data_t, nexus_plugin_data_t)
manage_files_pattern(nexus_plugininstall_t, nexus_plugin_data_t, nexus_plugin_data_t)
manage_lnk_files_pattern(nexus_plugininstall_t, nexus_plugin_data_t, nexus_plugin_data_t)
manage_files_pattern(nexus_plugininstall_t, nexus_plugin_data_t, nexus_plugin_exec_t)
filetrans_pattern(nexus_plugininstall_t, nexus_plugin_data_t, nexus_plugin_exec_t, file, "plugin")
# project plugin keys: /etc/pki/nexus/plugin-keys/*.pub (cert_t: public keys only)
miscfiles_read_generic_certs(nexus_plugininstall_t)
files_search_etc(nexus_plugininstall_t)
# the installer never executes what it installs, and has no network
neverallow nexus_plugininstall_t nexus_plugin_exec_t:file { execute execute_no_trans };
neverallow nexus_plugininstall_t self:{ tcp_socket udp_socket } create;

# --- web-api: upload (bundle + signature into staging, touches .trigger for
# nexus-plugin-install.path), project keys (GET /plugin-keys), installed manifests
allow nexus_webapi_t nexus_plugin_staging_t:dir rw_dir_perms;
manage_files_pattern(nexus_webapi_t, nexus_plugin_staging_t, nexus_plugin_staging_t)
# nexus-plugin-install.path (PathModified=.trigger): systemd needs an inotify watch on the
# existing file (read + watch); without it only the first creation ever fires the installer
allow init_t nexus_plugin_staging_t:file { getattr read watch };
# the same for the PathExists units of nexus-tls and nexus-diag: systemd (init_t) reads
# and watches the request file it waits for (found in the VM: helpers never started)
allow init_t { nexus_tls_req_t nexus_diag_var_lib_t }:file { getattr read watch };
miscfiles_read_generic_certs(nexus_webapi_t)
list_dirs_pattern(nexus_webapi_t, nexus_plugin_data_t, nexus_plugin_data_t)
read_files_pattern(nexus_webapi_t, nexus_plugin_data_t, nexus_plugin_data_t)
read_lnk_files_pattern(nexus_webapi_t, nexus_plugin_data_t, nexus_plugin_data_t)

# --- scheduler: resolves <id>/current and reads manifests before spawning the host
# (never the binary: only nexus-pluginhost opens and executes it)
list_dirs_pattern(nexus_scheduler_t, nexus_plugin_data_t, nexus_plugin_data_t)
read_files_pattern(nexus_scheduler_t, nexus_plugin_data_t, nexus_plugin_data_t)
read_lnk_files_pattern(nexus_scheduler_t, nexus_plugin_data_t, nexus_plugin_data_t)

########################################
# Web certificate (docs/control-plane.md "Web certificate"): nexus-tls (root oneshot,
# no capabilities, no network) answers the web-api's requests in /var/lib/nexus/tls:
# a CSR (new key into /etc/nexus/tls/pending), installing a validated chain as
# web.pem (temp file + rename, previous kept as web.pem.prev) and reverting. It never
# writes the self-signed identity certificate or its key (nexus_webapi_secret_t),
# which replication secondaries pin; the web-api reads web.pem and never the pending key.

# requests in, answers out
allow nexus_tls_t nexus_tls_req_t:dir rw_dir_perms;
manage_files_pattern(nexus_tls_t, nexus_tls_req_t, nexus_tls_req_t)
read_files_pattern(nexus_tls_t, nexus_var_lib_t, nexus_var_lib_t)
# /etc/nexus/tls: add and remove its own entries only
files_search_etc(nexus_tls_t)
allow nexus_tls_t nexus_etc_t:dir search_dir_perms;
allow nexus_tls_t nexus_webapi_secret_t:dir rw_dir_perms;
manage_files_pattern(nexus_tls_t, nexus_webapi_secret_t, nexus_tls_web_t)
filetrans_pattern(nexus_tls_t, nexus_webapi_secret_t, nexus_tls_web_t, file, "web.pem")
filetrans_pattern(nexus_tls_t, nexus_webapi_secret_t, nexus_tls_web_t, file, "web.tmp")
filetrans_pattern(nexus_tls_t, nexus_webapi_secret_t, nexus_tls_web_t, file, "web.pem.tmp")
filetrans_pattern(nexus_tls_t, nexus_webapi_secret_t, nexus_tls_web_t, file, "web.pem.prev")
filetrans_pattern(nexus_tls_t, nexus_webapi_secret_t, nexus_tls_web_t, file, "web.pem.prev.tmp")
filetrans_pattern(nexus_tls_t, nexus_webapi_secret_t, nexus_tls_web_t, file, "web.pem.prev.new")
manage_dirs_pattern(nexus_tls_t, nexus_tls_pending_t, nexus_tls_pending_t)
manage_files_pattern(nexus_tls_t, nexus_tls_pending_t, nexus_tls_pending_t)
filetrans_pattern(nexus_tls_t, nexus_webapi_secret_t, nexus_tls_pending_t, dir, "pending")

# web-api: writes requests (temp file + rename), reads and deletes answers, serves web.pem
allow nexus_webapi_t nexus_tls_req_t:dir rw_dir_perms;
manage_files_pattern(nexus_webapi_t, nexus_tls_req_t, nexus_tls_req_t)
read_files_pattern(nexus_webapi_t, nexus_webapi_secret_t, nexus_tls_web_t)
# nexus-tls.path (PathExists=request.json): systemd watches the request dir
allow init_t nexus_tls_req_t:dir { getattr search read watch };
allow init_t nexus_tls_req_t:file getattr;

# Only nexus-tls writes the imported certificate and reads the pending key; it never
# writes the identity certificate/key, has no network and no capabilities.
neverallow { nexus_domain -nexus_tls_t } nexus_tls_web_t:file { write append create unlink rename link setattr relabelto };
neverallow { nexus_domain -nexus_tls_t } nexus_tls_pending_t:file { read write open create unlink relabelto };
neverallow nexus_tls_t nexus_webapi_secret_t:file { write append create unlink rename link setattr };
neverallow nexus_tls_t self:{ tcp_socket udp_socket } create;
neverallow nexus_tls_t self:capability *;

# Diagnostics (Phase 14b, os/greenboot/usr/libexec/nexus/nexus-diag): root oneshot started
# by nexus-diag.path when the web-api writes /var/lib/nexus/diag/request.json. Self-checks
# and a redacted support bundle: reads the journal (journalctl_t), the audit log, the
# nftables ruleset (iptables_t), chrony (chronyc_t), systemd state, the catalog (read-only),
# the update status and the web certificate; writes only its control dir. No network.

nexus_daemon(diag)
# nexus-update (root, unconfined_service_t: its script is bin_t) runs the checks before it
# stages an update: same domain as from the path unit (found in the VM: chronyc denied)
gen_require(`
	type unconfined_service_t;
')
domtrans_pattern(unconfined_service_t, nexus_diag_exec_t, nexus_diag_t)
allow unconfined_service_t nexus_diag_t:process2 { nnp_transition nosuid_transition };
type nexus_diag_var_lib_t;	# /var/lib/nexus/diag: requests (web-api) and results (nexus-diag)
files_type(nexus_diag_var_lib_t)

# the script runs under /usr/bin/python3 (bin_t) with the standard library from /usr;
# ausearch (bin_t) runs in this domain; nexus-health (bin_t) is imported for the audit chain
corecmd_exec_bin(nexus_diag_t)
libs_use_ld_so(nexus_diag_t)
libs_use_shared_libs(nexus_diag_t)
libs_read_lib_files(nexus_diag_t)
files_read_usr_files(nexus_diag_t)
files_read_etc_files(nexus_diag_t)
# import ssl: OpenSSL configuration under /etc/pki; ausearch -i: user names
miscfiles_read_generic_certs(nexus_diag_t)
auth_read_passwd(nexus_diag_t)
# its control dir: consumes request.json, writes <id>/{status,checks}.json and the bundle,
# prunes old results
manage_dirs_pattern(nexus_diag_t, nexus_diag_var_lib_t, nexus_diag_var_lib_t)
manage_files_pattern(nexus_diag_t, nexus_diag_var_lib_t, nexus_diag_var_lib_t)
# setup-done
read_files_pattern(nexus_diag_t, nexus_var_lib_t, nexus_var_lib_t)
# catalog, read-only (mode=ro, readonly_shm: the -shm file is opened O_RDONLY): quick_check,
# audit chain, row counts
list_dirs_pattern(nexus_diag_t, nexus_catalog_t, nexus_catalog_t)
read_files_pattern(nexus_diag_t, nexus_catalog_t, nexus_catalog_t)
# SQLite run by root tries to fchown/open the -wal/-shm read-write before it falls back to
# read-only; refusing that is the point, so do not log it
dontaudit nexus_diag_t nexus_catalog_t:file { write setattr };
allow nexus_diag_t nexus_catalog_t:file map;
# update status.json (bootc booted/staged/rollback as nexus-update last saw it)
list_dirs_pattern(nexus_diag_t, nexus_update_t, nexus_update_t)
read_files_pattern(nexus_diag_t, nexus_update_t, nexus_update_t)
# keyd: the socket exists (never connects)
allow nexus_diag_t nexus_keyd_var_run_t:dir search_dir_perms;
allow nexus_diag_t nexus_keyd_var_run_t:sock_file getattr;
# web certificate expiry: cert.pem shares the type of the TLS key and the metrics token;
# DAC keeps the key closed (0600 nexus-webapi; this domain has no DAC override) and the
# script opens only cert.pem
files_search_etc(nexus_diag_t)
allow nexus_diag_t nexus_etc_t:dir search_dir_perms;
read_files_pattern(nexus_diag_t, nexus_webapi_secret_t, nexus_webapi_secret_t)
# disk usage: statfs of the store, /var, /sysroot, /boot
fs_getattr_all_fs(nexus_diag_t)
allow nexus_diag_t nexus_store_t:dir getattr;
files_getattr_boot_dirs(nexus_diag_t)
# SELinux mode (/sys/fs/selinux/enforce)
selinux_get_enforce_mode(nexus_diag_t)
# audit log: ausearch reads auditd.conf and /var/log/audit
logging_read_audit_config(nexus_diag_t)
logging_read_audit_log(nexus_diag_t)
logging_map_audit_log(nexus_diag_t)
# failed units, is-active: systemctl over the private socket, status of PID 1 and units
systemd_exec_systemctl(nexus_diag_t)
init_stream_connect(nexus_diag_t)
init_read_state(nexus_diag_t)
allow nexus_diag_t init_t:system status;
systemd_status_all_unit_files(nexus_diag_t)
# journal (journalctl), chrony (chronyc), nftables (nft list): each tool in its own domain;
# the unit has NoNewPrivileges=yes; output comes back through our pipes
journalctl_domtrans(nexus_diag_t)
chronyd_domtrans_chronyc(nexus_diag_t)
iptables_domtrans(nexus_diag_t)
allow nexus_diag_t { journalctl_t chronyc_t iptables_t }:process2 { nnp_transition nosuid_transition };
allow { journalctl_t chronyc_t iptables_t } nexus_diag_t:fd use;
allow { journalctl_t chronyc_t iptables_t } nexus_diag_t:fifo_file rw_inherited_fifo_file_perms;
allow { journalctl_t chronyc_t iptables_t } nexus_diag_t:process sigchld;

# no network; never writes the catalog, update control or anything outside its dir; never
# reads keys, stores, credentials or job configs; never talks to keyd
neverallow nexus_diag_t self:{ tcp_socket udp_socket rawip_socket sctp_socket } create;
neverallow nexus_diag_t { nexus_catalog_t nexus_update_t nexus_var_lib_t nexus_webapi_secret_t nexus_etc_t }:file { write append create unlink rename setattr };
neverallow nexus_diag_t { nexus_keyd_var_lib_t nexus_store_t nexus_escrow_t nexus_sshkey_t nexus_scheduler_var_run_t nexus_scheduler_secret_t nexus_webapi_var_lib_t nexus_agent_ca_t nexus_replicad_var_lib_t nexus_replica_key_t nexus_downloads_t }:file { read open };
neverallow nexus_diag_t nexus_keyd_var_run_t:sock_file { write open };
# only nexus-diag writes results (the web-api writes requests into the top dir, reads results)
neverallow { nexus_domain -nexus_diag_t -nexus_webapi_t } nexus_diag_var_lib_t:file { read write open };

# web-api: request.json (tmp + rename) into the control dir, status / checks / bundle out
allow nexus_webapi_t nexus_diag_var_lib_t:dir rw_dir_perms;
manage_files_pattern(nexus_webapi_t, nexus_diag_var_lib_t, nexus_diag_var_lib_t)
# Console gate (Phase 14c, nexus-console-gate.service on tty2, root): accepts a
# one-time unlock code (issued by the web-api after an approved console.unlock) or
# the recovery key, records the shell in the catalog and starts it with
# `systemd-run --scope -p RuntimeMaxSec=` (systemd stops the scope when the time is
# up). Executing bash moves the shell to unconfined_t: the emergency root shell.

allow nexus_consolegate_t self:capability { chown fowner dac_override dac_read_search ipc_lock };
# systemd-run --scope: PID 1 starts (and on timeout or a restarted gate stops) the shell's
# transient scope; its password agent looks at /proc/sys/fs (found in the VM)
allow nexus_consolegate_t init_t:system { start stop status };
kernel_read_fs_sysctls(nexus_consolegate_t)
# catalog (audit, alert, banner setting); SQLite running as root chowns the -wal/-shm
# it creates to the database's owner
manage_files_pattern(nexus_consolegate_t, nexus_catalog_t, nexus_catalog_t)
allow nexus_consolegate_t nexus_catalog_t:dir rw_dir_perms;
allow nexus_consolegate_t nexus_catalog_t:file map;
# setup-done
read_files_pattern(nexus_consolegate_t, nexus_var_lib_t, nexus_var_lib_t)
# recovery key check: kek.recovery unwrapped with the typed key must equal kek.local
list_dirs_pattern(nexus_consolegate_t, nexus_keyd_var_lib_t, nexus_keyd_var_lib_t)
read_files_pattern(nexus_consolegate_t, nexus_keyd_var_lib_t, nexus_keyd_var_lib_t)
# unlock codes: read, and delete when used or expired (never create: that is the web-api)
allow nexus_consolegate_t nexus_console_unlock_t:dir rw_dir_perms;
allow nexus_consolegate_t nexus_console_unlock_t:file { read_file_perms unlink };
# failed attempts across restarts of the gate
manage_files_pattern(nexus_consolegate_t, nexus_consolegate_var_run_t, nexus_consolegate_var_run_t)
# tty2 (echo off for the recovery key, foreground process group after the shell)
term_use_unallocated_ttys(nexus_consolegate_t)
term_use_controlling_term(nexus_consolegate_t)
# a pty from `systemd-run --pty` in an admin's root shell (lab/appliance/console-gate.sh)
userdom_use_user_ptys(nexus_consolegate_t)
term_use_generic_ptys(nexus_consolegate_t)
# systemd-run --scope / systemctl stop <scope> run in this domain and talk to PID 1
# (private socket as root, or the system bus): create the transient scope, stop it
corecmd_exec_bin(nexus_consolegate_t)
systemd_exec_systemctl(nexus_consolegate_t)
files_read_etc_files(nexus_consolegate_t)
files_read_usr_files(nexus_consolegate_t)
init_stream_connect(nexus_consolegate_t)
init_read_state(nexus_consolegate_t)
dbus_system_bus_client(nexus_consolegate_t)
init_dbus_chat(nexus_consolegate_t)
init_start_transient_unit(nexus_consolegate_t)
allow nexus_consolegate_t init_t:service { stop status };
allow nexus_consolegate_t init_t:system status;
allow nexus_consolegate_t self:unix_dgram_socket create_socket_perms;
# The shell: systemd-run execs /bin/bash in place -> unconfined_t (system_u:system_r,
# the gate's identity and role; a shell entry point of unconfined_t as for logins)
corecmd_shell_domtrans(nexus_consolegate_t, unconfined_t)
corecmd_shell_entry_type(unconfined_t)
role system_r types unconfined_t;

# --- web-api: writes the code files (tmp + rename), revokes (deletes) them
allow nexus_webapi_t nexus_console_unlock_t:dir rw_dir_perms;
manage_files_pattern(nexus_webapi_t, nexus_console_unlock_t, nexus_console_unlock_t)

# Only the console gate reaches unconfined_t; only the web-api issues codes, only it
# and the gate read them.
neverallow { nexus_domain -nexus_consolegate_t } unconfined_t:process { transition dyntransition };
neverallow { nexus_domain -nexus_webapi_t } nexus_console_unlock_t:file { create write append rename link setattr relabelto };
neverallow { nexus_domain -nexus_webapi_t -nexus_consolegate_t } nexus_console_unlock_t:file { read open };
neverallow nexus_plugin_t { nexus_console_unlock_t nexus_consolegate_var_run_t }:file { read write append open create unlink link rename setattr execute ioctl lock };

########################################
# Disks (Phase 16a/b, os/greenboot/usr/libexec/nexus/nexus-disks, docs/hardware.md): root
# oneshot started by nexus-disks.timer (every 5 minutes) and nexus-disks.path (requests of the
# web-api in /var/lib/nexus/disks). Inventory (lsblk, /sys, udev db), SMART (smartctl: ATA
# pass-through and NVMe admin commands), md arrays (/proc/mdstat, mdadm), and the approved
# layout operations: mdadm create/add/remove/replace/grow, mkfs.xfs, xfs_growfs, the store's
# mount unit in /etc/systemd/system and stopping/starting the services that use the store.
# All tools run in this domain. It lists the store's directories (to see that it holds no
# files) and never opens a file in it; it never touches keys, the catalog or credentials; no
# network.

nexus_daemon(disks)
type nexus_disks_var_lib_t;	# /var/lib/nexus/disks: requests (web-api), status/ops/state (nexus-disks)
files_type(nexus_disks_var_lib_t)
gen_require(`
	type mdadm_exec_t;
	type mdadm_var_run_t;
	type systemd_unit_file_t;
	type mount_t;
	type fs_t;
')

# python3 with the standard library; lsblk (bin_t), smartctl, wipefs / blkid / mkfs.xfs /
# xfs_growfs (fsadm_exec_t) and mdadm in this domain
corecmd_exec_bin(nexus_disks_t)
fstools_exec(nexus_disks_t)
can_exec(nexus_disks_t, mdadm_exec_t)
libs_use_ld_so(nexus_disks_t)
libs_use_shared_libs(nexus_disks_t)
libs_read_lib_files(nexus_disks_t)
files_read_usr_files(nexus_disks_t)
files_read_etc_files(nexus_disks_t)
files_read_etc_runtime_files(nexus_disks_t)
auth_read_passwd(nexus_disks_t)
dev_read_urand(nexus_disks_t)
kernel_read_kernel_sysctls(nexus_disks_t)
# its control dir: consumes req-*.json, writes status/ops/state and the mkfs protofile
manage_dirs_pattern(nexus_disks_t, nexus_disks_var_lib_t, nexus_disks_var_lib_t)
manage_files_pattern(nexus_disks_t, nexus_disks_var_lib_t, nexus_disks_var_lib_t)
# ATA pass-through (SMART), md ioctls / NVMe admin commands / xfs_growfs; listing the store
# (0700 nexus-chunkstore) without a DAC override
allow nexus_disks_t self:capability { sys_rawio sys_admin dac_read_search };
# disks and md devices (block and NVMe character devices: fixed_disk_device_t)
storage_raw_rw_fixed_disk(nexus_disks_t)
storage_getattr_fixed_disk_dev(nexus_disks_t)
storage_getattr_removable_dev(nexus_disks_t)
# lsblk / mdadm: /sys/block (mdadm writes md/* attributes), udev's database, /proc/mdstat,
# mountinfo; the md personality (raid456) is loaded on demand by the kernel
dev_rw_sysfs(nexus_disks_t)
udev_read_db(nexus_disks_t)
udev_read_pid_files(nexus_disks_t)
kernel_read_system_state(nexus_disks_t)
kernel_read_software_raid_state(nexus_disks_t)
kernel_request_load_module(nexus_disks_t)
fs_getattr_all_fs(nexus_disks_t)
# mdadm: /etc/mdadm.conf (if any), its map in /run/mdadm
raid_read_conf_files(nexus_disks_t)
files_search_pids(nexus_disks_t)
allow nexus_disks_t mdadm_var_run_t:dir manage_dir_perms;
allow nexus_disks_t mdadm_var_run_t:file manage_file_perms;
# the store: directories listed (empty before the array is created), xfs_growfs on the mount
# point; never a file opened (neverallow below)
list_dirs_pattern(nexus_disks_t, nexus_store_t, nexus_store_t)
allow nexus_disks_t nexus_store_t:{ file lnk_file } getattr;
allow nexus_disks_t nexus_store_t:dir ioctl;
allow nexus_disks_t nexus_store_t:filesystem getattr;
# the store's mount unit /etc/systemd/system/var-lib-nexus-chunkstore.mount (temp file +
# rename) gets nexus_unit_file_t; nothing else in /etc/systemd/system is writable
files_search_etc(nexus_disks_t)
allow nexus_disks_t systemd_unit_file_t:dir rw_dir_perms;
allow nexus_disks_t nexus_unit_file_t:file { create_file_perms write_file_perms rename unlink setattr };
filetrans_pattern(nexus_disks_t, systemd_unit_file_t, nexus_unit_file_t, file, "var-lib-nexus-chunkstore.mount")
filetrans_pattern(nexus_disks_t, systemd_unit_file_t, nexus_unit_file_t, file, "var-lib-nexus-chunkstore.mount.tmp")
# systemctl: daemon-reload, enable --now the mount unit, stop/start the scheduler and
# replicad around the mount, is-active (private socket of PID 1, as root)
systemd_exec_systemctl(nexus_disks_t)
init_stream_connect(nexus_disks_t)
init_read_state(nexus_disks_t)
allow nexus_disks_t init_t:system { status reload };
allow nexus_disks_t nexus_unit_file_t:service { start stop status enable };
allow nexus_disks_t nexus_unit_file_t:file read_file_perms;
allow nexus_disks_t self:unix_dgram_socket create_socket_perms;

# The data array is mounted with context=nexus_store_t (every file of the store has that
# label anyway): mount (from the mount unit) relabels the XFS superblock, files associate
allow mount_t fs_t:filesystem relabelfrom;
allow mount_t nexus_store_t:filesystem { relabelto relabelfrom mount unmount getattr };
allow nexus_store_t self:filesystem associate;
# statvfs of the store (capacity, disk checks) on its own file system
allow { nexus_scheduler_t nexus_job_domain nexus_replicad_t nexus_diag_t } nexus_store_t:filesystem getattr;

# web-api: req-<id>.json (tmp + rename) in, status.json / ops.json out
allow nexus_webapi_t nexus_disks_var_lib_t:dir rw_dir_perms;
manage_files_pattern(nexus_webapi_t, nexus_disks_var_lib_t, nexus_disks_var_lib_t)
# scheduler: `disk` alerts from status.json, audit of ops.json; nexus-diag: its disk check
read_files_pattern(nexus_scheduler_t, nexus_disks_var_lib_t, nexus_disks_var_lib_t)
read_files_pattern(nexus_diag_t, nexus_disks_var_lib_t, nexus_disks_var_lib_t)
# nexus-disks.path (PathExistsGlob=req-*.json): systemd watches the dir and reads the matches
allow init_t nexus_disks_var_lib_t:dir { getattr search read watch };
allow init_t nexus_disks_var_lib_t:file { getattr read watch };

# no network; never reads or writes keys, the catalog, credentials or store contents; only it
# (and the web-api, for requests) writes its dir
neverallow nexus_disks_t self:{ tcp_socket udp_socket rawip_socket sctp_socket } create;
neverallow nexus_disks_t { nexus_keyd_var_lib_t nexus_catalog_t nexus_escrow_t nexus_sshkey_t nexus_scheduler_secret_t nexus_webapi_secret_t nexus_webapi_var_lib_t nexus_agent_ca_t nexus_replicad_var_lib_t nexus_replica_key_t nexus_downloads_t nexus_etc_t nexus_store_t }:file { read write append open create unlink link rename setattr };
neverallow nexus_disks_t { nexus_keyd_var_run_t nexus_scheduler_var_run_t nexus_replicad_var_run_t }:sock_file { write open };
neverallow { nexus_domain -nexus_disks_t -nexus_webapi_t } nexus_disks_var_lib_t:file { write append create unlink rename };
