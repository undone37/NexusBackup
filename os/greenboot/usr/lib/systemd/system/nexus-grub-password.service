[Unit]
Description=NexusBackup boot menu password (GRUB superuser)
# /etc/nexus/grub-user.cfg is written by nexus-setup (derived from the recovery key), which
# also starts this unit; at every boot it is installed again if /boot lost or changed it.
ConditionPathExists=/etc/nexus/grub-user.cfg
RequiresMountsFor=/boot

[Service]
Type=oneshot
ExecStart=/usr/libexec/nexus/nexus-grub-password
# Root without a mount namespace of its own (like nexus-update): it remounts /boot
# read-write for the copy when /boot is mounted read-only, which only works on the host's
# mount table. Its script is bin_t, so it runs as unconfined_service_t.
UMask=0077
NoNewPrivileges=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
LimitCORE=0
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
