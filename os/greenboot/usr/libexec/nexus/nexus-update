import subprocess
import sys
import tarfile
import time

CONF = os.environ.get("NEXUS_UPDATE_CONF", "/etc/nexus/update.conf")
CONF_DEFAULTS = {
    "NEXUS_IMAGE_REPO": "ghcr.io/undone37/nexusbackup",
    "NEXUS_UPDATE_TAG": "stable",
    "NEXUS_UPDATE_WINDOW": "Sun 03:00 120",
    "NEXUS_UPDATE_CHECK_HOURS": "24",
    "NEXUS_UPDATE_EGRESS": "nft",
    "NEXUS_UPDATE_HOSTS": "ghcr.io pkg-containers.githubusercontent.com",
    "NEXUS_UPDATE_DIR": "/var/lib/nexus/update",
    "NEXUS_UPDATE_LOCK": "/run/nexus-update.lock",
    "NEXUS_UPDATE_DIAG": "/usr/libexec/nexus/nexus-diag",
    # where bootc/ostree look for registry credentials (tmpfs: gone at reboot)
    "NEXUS_UPDATE_AUTHFILE": "/run/ostree/auth.json",
    # offline updates (docs/release.md "Offline update bundle"): root-only, the only path policy.json accepts
    # for the oci transport; the image is verified here before bootc reads it
    "NEXUS_UPDATE_OFFLINE_DIR": "/var/lib/nexus/update-offline",
    "NEXUS_UPDATE_POLICY": "/etc/containers/policy.json",
}
REQUESTS = ("stage", "apply", "rollback", "import")
# the uploaded bundle (web-api writes it into the control directory, then the request "import")
BUNDLE = "bundle.tar"
# what the release signs: the cosign "simple signing" payload of the image (docs/release.md)
COSIGN_TYPE = "cosign container image signature"
OCI_REF = "nexus"
INHIBIT_MAX_AGE = 6 * 3600
DAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]


class Error(Exception):
    pass


class Refused(Error):
    """A pre-update check with severity >= 3 failed."""


def load_conf(path=CONF):
    c = dict(CONF_DEFAULTS)
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                c[k.strip()] = v.strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    for k in CONF_DEFAULTS:  # environment wins (tests, manual runs)
        if k in os.environ:
            c[k] = os.environ[k]
    return c


def tool(name):
    return os.environ.get("NEXUS_UPDATE_" + name.upper().replace("-", "_"), name)


def run(*argv, check=True):
    p = subprocess.run([tool(argv[0]), *argv[1:]], capture_output=True, text=True)
    if check and p.returncode != 0:
        raise Error(f"{' '.join(argv)}: exit {p.returncode}: {(p.stderr or p.stdout).strip()[-500:]}")
    return p


# ---------------------------------------------------------------- window / control files


def parse_window(s):
    """'Sun 03:00 120' | 'Mon,Thu 01:30 60' | 'daily 03:00 90' | 'off' -> (days, minute, dur) | None"""
    s = s.strip()
    if s.lower() in ("", "off", "never"):
        return None
    parts = s.split()
    if len(parts) != 3:
        raise Error(f"bad window {s!r}: want '<days> HH:MM <minutes>'")
    d, hm, dur = parts
    if d.lower() == "daily":
        days = set(range(7))
    else:
        try:
            days = {DAYS.index(x.lower()[:3]) for x in d.split(",") if len(x) >= 3}
        except ValueError:
            raise Error(f"bad window days {d!r}")
    try:
        h, m = (int(x) for x in hm.split(":"))
        dur = int(dur)
    except ValueError:
        raise Error(f"bad window {s!r}")
    if not days or not (0 <= h < 24 and 0 <= m < 60) or not (0 < dur <= 24 * 60):
        raise Error(f"bad window {s!r}")
    return days, h * 60 + m, dur


def in_window(win, now):
    """now: aware UTC datetime. Windows may cross midnight."""
    if win is None:
        return False
    days, start_min, dur = win
    for back in (0, 1):
        day = (now - dt.timedelta(days=back)).date()
        if day.weekday() not in days:
            continue
        start = dt.datetime.combine(day, dt.time(start_min // 60, start_min % 60), dt.timezone.utc)
        if start <= now < start + dt.timedelta(minutes=dur):
            return True
    return False


def read_small(path, limit=256):
    """Read a control file written by a less privileged user: no symlinks, regular file only."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except (FileNotFoundError, OSError):
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        return os.read(fd, limit).decode("utf-8", "replace")
    finally:
        os.close(fd)


def take_request(d):
    p = os.path.join(d, "request")
    s = read_small(p)
    if s is None:
        return None
    try:
        os.unlink(p)  # consume first, so a failing action cannot re-trigger the path unit forever
    except FileNotFoundError:
        pass
    word = s.strip().lower()
    if word not in REQUESTS:
        log(f"ignoring unknown request {word[:32]!r}")
        return None
    return word


def inhibited(d, now_ts):
    try:
        st = os.lstat(os.path.join(d, "inhibit"))
    except FileNotFoundError:
        return False
    return stat.S_ISREG(st.st_mode) and now_ts - st.st_mtime < INHIBIT_MAX_AGE


def effective_window(c):
    s = read_small(os.path.join(c["NEXUS_UPDATE_DIR"], "window"))
    try:
        return parse_window(s) if s is not None else parse_window(c["NEXUS_UPDATE_WINDOW"])
    except Error as e:  # a broken override must not block updates forever: fall back
        log(f"{e}; using the default window")
        return parse_window(c["NEXUS_UPDATE_WINDOW"])


# ---------------------------------------------------------------- bootc


def bootc_status():
    return json.loads(run("bootc", "status", "--json").stdout)


def entry(e):
    if not e:
        return None
    img = e.get("image") or {}
    ref = img.get("image") or {}
    return {
        "image": ref.get("image"),
        "signature": ref.get("signature"),
        "digest": img.get("imageDigest"),
        "version": img.get("version"),
        "timestamp": img.get("timestamp"),
        "download_only": bool(e.get("downloadOnly")),
    }


def summary(st):
    s = st.get("status") or {}
    spec = (st.get("spec") or {}).get("image") or {}
    return {
        "spec_image": spec.get("image"),
        "spec_signature": spec.get("signature"),
        "booted": entry(s.get("booted")),
        "staged": entry(s.get("staged")),
        "rollback": entry(s.get("rollback")),
        "rollback_queued": bool(s.get("rollbackQueued")),
    }


class PullAuth:
    """Registry login for a private image repository, for the duration of a fetch.

    The control plane stores {"username", "token"} (a read-only pull token) in
    <update dir>/pull-auth.json; this writes bootc's auth file for the registry host
    of NEXUS_IMAGE_REPO (0600, tmpfs) and removes it again afterwards."""

    def __init__(self, c):
        self.c = c
        self.path = c["NEXUS_UPDATE_AUTHFILE"]
        self.wrote = False

    def __enter__(self):
        raw = read_small(os.path.join(self.c["NEXUS_UPDATE_DIR"], "pull-auth.json"), 4096)
        if not raw:
            return self
        try:
            a = json.loads(raw)
            user, token = str(a["username"]), str(a["token"])
        except (ValueError, KeyError, TypeError):
            raise Error("pull-auth.json is not {username, token}")
        host = self.c["NEXUS_IMAGE_REPO"].split("/", 1)[0]
        cred = base64.b64encode(f"{user}:{token}".encode()).decode()
        os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
        fd = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump({"auths": {host: {"auth": cred}}}, f)
        self.wrote = True
        return self

    def __exit__(self, *exc):
        if self.wrote:
            try:
                os.unlink(self.path)
            except FileNotFoundError:
                pass
        return False


class Egress:
    """Opens 443/tcp to the registry hosts in the nexus nftables sets for the duration of a fetch."""

    def __init__(self, c):
        self.on = c["NEXUS_UPDATE_EGRESS"] == "nft"
        self.hosts = c["NEXUS_UPDATE_HOSTS"].split()
        self.added = []

    def __enter__(self):
        if not self.on:
            return self
        addrs = set()
        for _ in range(3):  # CDN answers rotate; take the union of a few lookups
            for h in self.hosts:
                try:
                    for fam, _, _, _, sa in socket.getaddrinfo(h, 443, proto=socket.IPPROTO_TCP):
                        addrs.add((fam, sa[0]))
                except socket.gaierror as e:
                    raise Error(f"resolve {h}: {e}")
        for fam, a in sorted(addrs):
            v = "v6" if fam == socket.AF_INET6 else "v4"
            el = f"{{ {a} . tcp . 443 }}"
            # create fails if the element exists: then it is someone else's and stays
            if run("nft", "create", "element", "inet", "nexus", f"allowed_out_{v}", el, check=False).returncode == 0:
                self.added.append((v, el))
        return self

    def __exit__(self, *exc):
        for v, el in self.added:
            run("nft", "delete", "element", "inet", "nexus", f"allowed_out_{v}", el, check=False)
        self.added = []


def prechecks(c, st):
    """Runs `nexus-diag checks`, records the blocking ones in st["checks"] and raises
    Refused if there are any. Fails open when the checker itself cannot run."""
    now = int(time.time())
    if c["NEXUS_UPDATE_DIAG"] == "off":
        st["checks"] = {"time": now, "skipped": True, "blocking": []}
        return
    try:
        p = subprocess.run([c["NEXUS_UPDATE_DIAG"], "checks"], capture_output=True, text=True, timeout=900)
        cs = json.loads(p.stdout) if p.returncode == 0 else None
        if not isinstance(cs, list):
            raise ValueError(f"exit {p.returncode}: {(p.stderr or p.stdout).strip()[-200:]}")
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        log(f"pre-update checks unavailable ({e}); continuing without them")
        st["checks"] = {"time": now, "error": str(e)[:300], "blocking": []}
        return
    bad = [
        {k: x.get(k) for k in ("id", "title", "severity", "detail", "manual")}
        for x in cs
        if isinstance(x, dict) and x.get("status") == "fail" and (x.get("severity") or 0) >= 3
    ]
    st["checks"] = {"time": now, "blocking": bad}
    if bad:
        raise Refused("pre-update checks failed: " + "; ".join(f"{x['id']}: {x['detail']}" for x in bad))


def channel_version(c, target):
    """The version label of the channel's image (skopeo inspect: the manifest and config only, no pull),
    None when unknown. Only used to skip an older release; whatever is staged is still verified by bootc."""
    argv = ["skopeo", "inspect", "--no-tags", "--retry-times", "2"]
    if os.path.exists(c["NEXUS_UPDATE_AUTHFILE"]):
        argv += ["--authfile", c["NEXUS_UPDATE_AUTHFILE"]]
    p = run(*argv, f"docker://{target}", check=False)
    if p.returncode != 0:
        log(f"channel version unknown ({(p.stderr or p.stdout).strip()[-200:]}); checking with bootc")
        return None
    try:
        return (json.loads(p.stdout).get("Labels") or {}).get("org.opencontainers.image.version")
    except (ValueError, AttributeError):
        return None


def stage(c):
    target = f"{c['NEXUS_IMAGE_REPO']}:{c['NEXUS_UPDATE_TAG']}"
    s = summary(bootc_status())
    if s["spec_image"] is None:
        raise Error("not a bootc host (bootc status has no spec image)")
    with Egress(c), PullAuth(c):
        # never pull (or switch the origin to) an older release than the one running: an appliance updated
        # from a bundle or a lab build would otherwise stage the channel's older image (lab 2026-10-22:
        # "Check now" on 0.0.19-dev staged 0.0.1-alpha)
        booted = (s["booted"] or {}).get("version")
        remote = channel_version(c, target)
        old, new = parse_version(booted), parse_version(remote)
        if old and new and new < old:
            log(f"{target} is {remote}, older than the booted {booted}: nothing to stage")
            return f"up to date: the channel has {remote}, older than the booted {booted}"
        try:
            if s["spec_image"] != target or s["spec_signature"] != "containerPolicy":
                # first run after install, or channel/repo changed: pin the signed origin
                log(f"switching origin {s['spec_image']} ({s['spec_signature']}) -> {target} (signature enforced)")
                run("bootc", "switch", "--quiet", "--enforce-container-sigpolicy", target)
            else:
                run("bootc", "upgrade", "--quiet", "--download-only")
        except Error as e:
            if "signature verification failed" in str(e) or "invalid signature" in str(e):
                # containers/image only says "invalid signature when validating ASN.1 encoded signature"
                try:
                    keys = ", ".join(os.path.basename(k) for k in pinned_keys(c))
                except (Error, OSError, ValueError):
                    keys = "?"
                raise Error(
                    f"{target} is not signed with a key this appliance trusts (pinned: {keys}); a development or "
                    "lab build that pins only the TEST key cannot follow the release channel"
                ) from e
            raise
    s = summary(bootc_status())
    if s["staged"]:
        log(f"staged {s['staged']['digest']} (version {s['staged']['version']})")
        return f"staged {s['staged']['digest']}"
    return "up to date"


# ---------------------------------------------------------------- offline update bundle
#
# bundle.tar (release/update-bundle.sh): bundle.json {format, repository, version, digest}, image/ (an OCI
# layout with one manifest, ref name "nexus"), signature/payload.json + signature/payload.sig (the cosign
# simple-signing payload of the image and its base64 DER ECDSA signature, as in the registry's .sig tag),
# SHA256SUMS over every other file. Trust comes only from the signature: it must verify with a key pinned
# in policy.json for this repository, name this repository and the manifest digest of image/.


def pinned_keys(c):
    with open(c["NEXUS_UPDATE_POLICY"]) as f:
        pol = json.load(f)
    reqs = ((pol.get("transports") or {}).get("docker") or {}).get(c["NEXUS_IMAGE_REPO"]) or []
    keys = [k for r in reqs if r.get("type") == "sigstoreSigned" for k in (r.get("keyPaths") or [r.get("keyPath")]) if k]
    if not keys:
        raise Error(f"no pinned key for {c['NEXUS_IMAGE_REPO']} in {c['NEXUS_UPDATE_POLICY']}")
    return keys


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def read_text(path):
    with open(path) as f:
        return f.read()


def verify_signature(c, payload, sig_b64, work):
    """The pinned key that verifies the payload's signature (openssl, ECDSA P-256 over SHA-256)."""
    der = os.path.join(work, ".sig.der")
    try:
        with open(der, "wb") as f:
            f.write(base64.b64decode(sig_b64.strip(), validate=True))
    except ValueError:
        raise Refused("the signature is not base64")
    for k in pinned_keys(c):
        p = run("openssl", "dgst", "-sha256", "-verify", k, "-signature", der, payload, check=False)
        if p.returncode == 0:
            return k
    raise Refused("the image signature does not verify with any pinned release key")


def verify_bundle(c, root):
    """Checks an extracted bundle; returns {version, digest, key}. Raises Refused."""
    for d, dirs, files in os.walk(root):
        for n in dirs + files:
            st_ = os.lstat(os.path.join(d, n))
            if not (stat.S_ISREG(st_.st_mode) or stat.S_ISDIR(st_.st_mode)):
                raise Refused(f"bundle contains a link or special file: {os.path.relpath(os.path.join(d, n), root)}")
    sums = {}
    try:
        with open(os.path.join(root, "SHA256SUMS")) as f:
            for line in f:
                h, _, name = line.strip().partition("  ")
                sums[name] = h
    except OSError:
        raise Refused("bundle has no SHA256SUMS")
    have = {os.path.relpath(os.path.join(d, n), root) for d, _, fs in os.walk(root) for n in fs} - {"SHA256SUMS"}
    if have != set(sums):
        raise Refused(f"SHA256SUMS does not list exactly the bundle's files ({len(have ^ set(sums))} differ)")
    for name, h in sums.items():
        if sha256_file(os.path.join(root, name)) != h:
            raise Refused(f"checksum mismatch: {name} (truncated or modified upload)")
    try:
        meta = json.loads(read_text(os.path.join(root, "bundle.json")))
        payload_path = os.path.join(root, "signature", "payload.json")
        payload = json.loads(read_text(payload_path))
        sig = read_text(os.path.join(root, "signature", "payload.sig"))
        index = json.loads(read_text(os.path.join(root, "image", "index.json")))
    except (OSError, ValueError) as e:
        raise Refused(f"not an update bundle: {e}")
    if meta.get("format") != 1:
        raise Refused(f"unknown bundle format {meta.get('format')!r}")
    repo = c["NEXUS_IMAGE_REPO"]
    if meta.get("repository") != repo:
        raise Refused(f"bundle is for {meta.get('repository')}, this appliance follows {repo}")
    key = verify_signature(c, payload_path, sig, root)
    crit = payload.get("critical") or {}
    name = ((crit.get("identity") or {}).get("docker-reference") or "").split("@")[0]
    last = name.rsplit("/", 1)[-1]
    if ":" in last:  # drop a tag; matchRepository compares the repository only
        name = name[: len(name) - len(last)] + last.split(":", 1)[0]
    if crit.get("type") != COSIGN_TYPE or name != repo:
        raise Refused(f"the signature is not an image signature for {repo} (signed: {name or '-'})")
    digest = (crit.get("image") or {}).get("docker-manifest-digest") or ""
    mans = [m for m in index.get("manifests") or [] if (m.get("annotations") or {}).get("org.opencontainers.image.ref.name") == OCI_REF]
    if len(mans) != 1 or mans[0].get("digest") != digest or not digest.startswith("sha256:"):
        raise Refused("the signed digest is not the bundle's image")
    blob = lambda dg: os.path.join(root, "image", "blobs", "sha256", dg.split(":", 1)[1])
    try:
        man = json.loads(read_text(blob(digest)))
        cfg = json.loads(read_text(blob(man["config"]["digest"])))
    except (OSError, ValueError, KeyError, IndexError) as e:
        raise Refused(f"image manifest or config missing: {e}")
    if "sha256:" + sha256_file(blob(digest)) != digest:
        raise Refused("image manifest does not match its digest")
    version = ((cfg.get("config") or {}).get("Labels") or {}).get("org.opencontainers.image.version")
    if not version or version != meta.get("version"):
        raise Refused(f"image version {version!r} does not match the bundle's {meta.get('version')!r}")
    return {"version": version, "digest": digest, "key": os.path.basename(key)}


def import_bundle(c, st):
    """Moves the uploaded bundle out of the web-api's reach, extracts and verifies it, then stages it."""
    up = os.path.join(c["NEXUS_UPDATE_DIR"], BUNDLE)
    off = c["NEXUS_UPDATE_OFFLINE_DIR"]
    os.makedirs(off, mode=0o700, exist_ok=True)
    os.chmod(off, 0o700)
    tar = os.path.join(off, BUNDLE)
    try:
        fd = os.open(up, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        raise Error("no uploaded bundle")
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Refused("the upload is not a regular file")
        os.replace(up, tar)  # same file system; from here on only root can touch it
    finally:
        os.close(fd)
    new = os.path.join(off, "new")
    shutil.rmtree(new, ignore_errors=True)
    try:
        try:
            with tarfile.open(tar) as t:
                t.extractall(new, filter="data")  # no absolute paths, no escapes, no devices
        except (tarfile.TarError, OSError, ValueError) as e:
            raise Refused(f"cannot unpack the bundle: {e}")
        info = verify_bundle(c, new)
        s = summary(bootc_status())
        if info["digest"] == ((s["booted"] or {}).get("digest")):
            raise Refused(f"version {info['version']} ({info['digest']}) is already running")
        if info["digest"] in (st.get("failed_digests") or []):
            raise Refused(f"{info['digest']} was rolled back by greenboot before")
        old, newv = parse_version((s["booted"] or {}).get("version")), parse_version(info["version"])
        if old and newv and newv < old:
            raise Refused(f"version {info['version']} is older than the booted {(s['booted'] or {}).get('version')}")
        cur = os.path.join(off, "current")
        shutil.rmtree(cur, ignore_errors=True)
        os.replace(new, cur)
    except Error:
        shutil.rmtree(new, ignore_errors=True)
        raise
    finally:
        if os.path.exists(tar):
            os.unlink(tar)
    st["offline"] = {**info, "imported": int(time.time())}
    log(f"verified bundle {info['version']} ({info['digest']}, key {info['key']})")
    return stage_offline(c, st)


def stage_offline(c, st):
    """Stages the verified image in the offline directory (policy.json accepts only that path)."""
    ref = f"{os.path.join(c['NEXUS_UPDATE_OFFLINE_DIR'], 'current', 'image')}:{OCI_REF}"
    if summary(bootc_status())["spec_image"] == ref:
        # booted from an earlier bundle: same origin, so switch is a no-op; upgrade reads the new image there
        run("bootc", "upgrade", "--quiet")
    else:
        run("bootc", "switch", "--quiet", "--transport", "oci", ref)
    s = summary(bootc_status())
    if not s["staged"]:
        raise Error("bootc staged nothing from the bundle")
    log(f"staged {s['staged']['digest']} (version {s['staged']['version']}) from the offline bundle")
    return f"staged {s['staged']['digest']} from the uploaded bundle"


def parse_version(v):
    """'v1.2.3', '1.2.3-rc1' -> (1, 2, 3); None if not a dotted number."""
    if not v:
        return None
    core = v.lstrip("vV").split("-", 1)[0].split("+", 1)[0]
    try:
        return tuple(int(x) for x in core.split("."))
    except ValueError:
        return None


def reboot():
    run("systemctl", "reboot")


def apply(c, status=None, force=False):
    """status: the tick's status dict. The digest is recorded before the reboot so the
    next boot can tell whether the update stuck or greenboot rolled it back."""
    s = summary(bootc_status())
    st = s["staged"]
    if not st:
        return "nothing staged"
    status = status if status is not None else read_status(c)
    if not force:
        if st["digest"] in (status.get("failed_digests") or []):
            return f"not applying {st['digest']}: it was rolled back before (admin apply overrides)"
        # The signature policy matches the repository, not the tag: a registry (or
        # whoever moves the tag) could serve an older signed release. Never go back
        # automatically.
        old, new = parse_version((s["booted"] or {}).get("version")), parse_version(st["version"])
        if old and new and new < old:
            return f"not applying {st['digest']}: version {st['version']} is older than the booted one"
    log(f"applying staged {st['digest']}, rebooting")
    status["applying"] = st["digest"]
    # the web view too: after the reboot the next tick can be minutes away (timer), and the UI must not show
    # "no update status" meanwhile
    status["api"] = api_view({**status, **s, "channel": f"{c['NEXUS_IMAGE_REPO']}:{c['NEXUS_UPDATE_TAG']}"})
    write_status(c, status)
    if st["download_only"]:
        run("bootc", "upgrade", "--from-downloaded", "--apply")  # reboots
    else:
        reboot()  # a normal staged deployment is finalized at shutdown
    return f"rebooting into {st['digest']}"


def rollback(c):
    log("rollback requested, rebooting into the previous deployment")
    run("bootc", "rollback")
    reboot()
    return "rolling back"


# ---------------------------------------------------------------- status / tick


def epoch(ts):
    """bootc image timestamp (RFC 3339) -> unix seconds, None if unknown."""
    if not ts:
        return None
    try:
        return int(dt.datetime.fromisoformat(str(ts).replace("Z", "+00:00")).timestamp())
    except ValueError:
        return None


def window_text(w):
    """status["window"] dict -> 'Sun 03:00 120' ('off' when disabled)."""
    if not w:
        return "off"
    days = w.get("days") or []
    d = "daily" if len(days) == 7 else ",".join(x.capitalize() for x in sorted(days, key=DAYS.index))
    return f"{d} {w.get('start_utc')} {w.get('minutes')}"


def api_view(st):
    """The contract view of a status dict (docs/phase12-contract.md §5)."""

    def img(e):
        if not e:
            return None
        return {"version": e.get("version"), "digest": e.get("digest"), "since": epoch(e.get("timestamp"))}

    booted, staged = st.get("booted"), st.get("staged")
    last = st.get("last_result") or {}
    error = last.get("result") if str(last.get("result") or "").startswith("error") else None
    error = error or st.get("bootc_error")
    refused = str(last.get("result") or "").startswith("refused")
    available = None
    older = (lambda o, n: bool(o and n and n < o))(
        parse_version((booted or {}).get("version")), parse_version((staged or {}).get("version"))
    )
    if staged and staged.get("digest") != (booted or {}).get("digest") and not older:
        available = {"version": staged.get("version"), "digest": staged.get("digest")}
    channel = st.get("channel") or ""
    return {
        "booted": img(booted),
        "staged": img(staged),
        "available": available,
        "channel": channel.rsplit(":", 1)[-1] if channel else None,
        "window": window_text(st.get("window")),
        "last_check": st.get("last_check"),
        # a check started at this time is still running (pull, signature check)
        "checking": st.get("checking"),
        # a refused bundle is not a failed pre-update check: its own status, the reason in last_result
        "status": "error" if error else ("refused" if refused and last.get("request") == "import"
                                         else ("blocked" if refused else ("staged" if staged else "idle"))),
        "error": error,
        # the checks that refused the last stage / apply (manual: chapter 15 anchors)
        "blocked": ((st.get("checks") or {}).get("blocking") or []) if refused else [],
        "rollback": img(st.get("rollback")),
        "applying": st.get("applying"),
        # the last verified bundle {version, digest, key, imported}; while set, no automatic online checks
        "offline": st.get("offline"),
        # {time, request, result} of the last action, e.g. why an uploaded bundle was refused
        "last_result": st.get("last_result"),
    }


def status_path(c):
    return os.path.join(c["NEXUS_UPDATE_DIR"], "status.json")


def read_status(c):
    try:
        with open(status_path(c)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write_status(c, data):
    p = status_path(c)
    tmp = p + ".tmp"
    old = os.umask(0o027)
    try:
        with open(tmp, "w") as f:
            json.dump(data, f, indent=1, sort_keys=True)
            f.write("\n")
        os.replace(tmp, p)
    finally:
        os.umask(old)


def tick(c, now=None):
    now = now or dt.datetime.now(dt.timezone.utc)
    d = c["NEXUS_UPDATE_DIR"]
    prev = read_status(c)
    st = {k: prev.get(k) for k in ("last_check", "last_result", "failed_digests", "applying", "checks", "offline")}
    st["failed_digests"] = st["failed_digests"] or []
    req = take_request(d)
    result = None
    checked = []

    def gate():  # pre-update checks, at most once per tick
        if not checked:
            checked.append(True)
            prechecks(c, st)

    try:
        if st["applying"]:
            booted = (summary(bootc_status())["booted"] or {}).get("digest")
            if booted != st["applying"]:
                # we rebooted into it and are not running it: greenboot rolled it back
                log(f"update {st['applying']} did not stick (booted {booted}); not applying it again")
                st["failed_digests"] = (st["failed_digests"] + [st["applying"]])[-10:]
                result = f"rolled back from {st['applying']}"
            st["applying"] = None
        if req == "rollback":
            result = rollback(c)
        elif req == "import":
            try:
                gate()
            except Refused:
                # the upload is unusable now: without this the web-api answers every new upload with
                # "still being processed" (lab 2026-10-21, clock not synchronised)
                with contextlib.suppress(OSError):
                    os.unlink(os.path.join(d, BUNDLE))
                raise
            result = import_bundle(c, st)
        else:
            # updated from an uploaded bundle: no automatic online checks (an air-gapped appliance would
            # report an error every day) until an admin checks online ("Check now" = request stage)
            offline = st.get("offline") and req != "stage"
            if req == "stage":
                st["offline"] = None
            # bootc keeps a download-only staged deployment in runtime state: an
            # unclean power cut loses it. Re-stage at once instead of waiting a check interval.
            had = (prev.get("staged") or {}).get("digest")
            lost = bool(had) and not prev.get("applying") and not summary(bootc_status())["staged"]
            if lost:
                log(f"staged update {had} is gone (power loss before apply?); staging again")
            if lost and offline and os.path.isdir(os.path.join(c["NEXUS_UPDATE_OFFLINE_DIR"], "current", "image")):
                result = stage_offline(c, st)
                lost = False
            # "apply" = install now: fetch first when nothing is staged yet
            install_now = req == "apply" and not summary(bootc_status())["staged"]
            check_due = (
                req == "stage"
                or install_now
                or lost
                or not st["last_check"]
                or now.timestamp() - st["last_check"] >= float(c["NEXUS_UPDATE_CHECK_HOURS"]) * 3600
            ) and not offline
            if check_due:
                st["last_check"] = int(now.timestamp())
                # a check can take minutes (pull, signature): the web view says so meanwhile
                interim = {**prev, "checking": int(now.timestamp())}
                interim["api"] = api_view(interim)
                write_status(c, interim)
                gate()
                result = stage(c)
            win = effective_window(c)
            if req == "apply":
                gate()
                result = apply(c, st, force=True)
            elif in_window(win, now) and not inhibited(d, now.timestamp()):
                if summary(bootc_status())["staged"]:
                    gate()
                    result = apply(c, st)
    except Refused as e:
        result = f"refused: {e}"
        log(result)
    except Error as e:
        result = f"error: {e}"
        log(result)
    if result:
        st["last_result"] = {"time": int(now.timestamp()), "request": req, "result": result}
    win = effective_window(c)
    st.update(
        {
            "updated": int(now.timestamp()),
            "channel": f"{c['NEXUS_IMAGE_REPO']}:{c['NEXUS_UPDATE_TAG']}",
            "window": None if win is None else {"days": sorted(DAYS[i] for i in win[0]), "start_utc": f"{win[1] // 60:02d}:{win[1] % 60:02d}", "minutes": win[2]},
            "in_window": in_window(win, now),
            "inhibited": inhibited(d, now.timestamp()),
        }
    )
    try:
        st.update(summary(bootc_status()))
    except (Error, ValueError) as e:
        st["bootc_error"] = str(e)
    st["api"] = api_view(st)
    write_status(c, st)
    # a failed check (registry down, private repo without credential) is reported in
    # status.json and the web UI; it must not leave a failed unit behind (systemd.failed)
    return 0


def log(msg):
    print(f"nexus-update: {msg}", file=sys.stderr, flush=True)


def main(argv):
    as_json = argv[2:] == ["--json"] and argv[1:2] == ["status"]
    if not (len(argv) == 2 or as_json) or argv[1] not in ("tick", "stage", "apply", "rollback", "status"):
        print("usage: nexus-update tick|stage|apply|rollback|status [--json]", file=sys.stderr)
        return 2
    c = load_conf()
    cmd = argv[1]
    if cmd == "status":
        st = {**read_status(c), **summary(bootc_status())}
        if as_json:
            win = effective_window(c)
            st["window"] = None if win is None else {"days": sorted(DAYS[i] for i in win[0]), "start_utc": f"{win[1] // 60:02d}:{win[1] % 60:02d}", "minutes": win[2]}
            st["channel"] = f"{c['NEXUS_IMAGE_REPO']}:{c['NEXUS_UPDATE_TAG']}"
            st = api_view(st)
        print(json.dumps(st, indent=1, sort_keys=True))
        return 0
    os.makedirs(c["NEXUS_UPDATE_DIR"], exist_ok=True)
    with open(c["NEXUS_UPDATE_LOCK"], "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if cmd == "tick":
            return tick(c)
        try:
            if cmd != "rollback":  # NEXUS_UPDATE_DIAG=off nexus-update ... skips the checks
                st = read_status(c)
                prechecks(c, st)
            if cmd == "apply":  # an admin on the console: like the "apply" request
                print(apply(c, st, force=True))
            else:
                print({"stage": stage, "rollback": rollback}[cmd](c))
            return 0
        except Error as e:
            log(f"error: {e}")
            return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
