#!/usr/bin/python3 -I
# NexusBackup system disk recovery keyslot (#22 M3, docs/disk-encryption-design.md).
#
# The installer encrypts the system disk (LUKS2, root and swap, listed in /etc/crypttab) and enrols a TPM2 token
# (PCR 7); its generated passphrase was never shown. nexus-setup (confined, no access to disks or the TPM) writes a
# one-shot request to /run/nexus-luks-recovery (tmpfs, 0600 root) and starts this oneshot:
#   {"op": "slot", "words": "<recovery key>"}      first boot: a keyslot with the recovery key in its written form
#                                                  (24 words, single spaces), the install passphrase wiped; the TPM
#                                                  token unlocks for it
#   {"op": "reenroll", "words": "<recovery key>"}  keys-reseal: the TPM2 token for the TPM's current state, opened
#                                                  with the words (two calls: in one, systemd-cryptenroll sees "this
#                                                  PCR set is already enrolled" and does nothing)
# The request is removed before anything else; the words go to systemd-cryptenroll in its environment (NEWPASSWORD,
# PASSWORD), never in an argument. No /etc/crypttab: nothing to do. Exit 0 = done, 1 = error.

import json
import os
import re
import stat
import subprocess
import sys

DEFAULTS = {
    "REQUEST": "/run/nexus-luks-recovery",
    "CRYPTTAB": "/etc/crypttab",
    "CRYPTENROLL": "systemd-cryptenroll",
}
WORDS = re.compile(r"[a-z]{3,8}( [a-z]{3,8}){23}")
DEV = re.compile(r"/dev/[A-Za-z0-9/._:-]{1,200}")


def cfg(name):
    return os.environ.get("NEXUS_LUKS_" + name, DEFAULTS[name])


def log(msg):
    print(f"nexus-luks-recovery: {msg}", file=sys.stderr, flush=True)


def take_request():
    """The request (regular file of root, 0600, small), removed at once; None when there is none."""
    p = cfg("REQUEST")
    try:
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    try:
        os.unlink(p)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o077 or st.st_size > 4096:
            raise SystemExit(f"{p}: not a 0600 file of root: ignored")
        req = json.loads(os.read(fd, 4096))
    finally:
        os.close(fd)
    if req.get("op") not in ("slot", "reenroll") or not WORDS.fullmatch(req.get("words") or ""):
        raise SystemExit(f"{p}: invalid request")
    return req


def devices():
    """LUKS2 devices of the system disk from crypttab (`UUID=` or a path)."""
    try:
        with open(cfg("CRYPTTAB")) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        return []
    out = []
    for line in lines:
        f = line.split()
        if len(f) < 2 or f[0].startswith("#"):
            continue
        dev = "/dev/disk/by-uuid/" + f[1][5:] if f[1].startswith("UUID=") else f[1]
        if not DEV.fullmatch(dev):
            raise SystemExit(f"crypttab: unexpected device {dev!r}")
        out.append(dev)
    return out


def enroll(args, env):
    r = subprocess.run([cfg("CRYPTENROLL"), *args], env={**os.environ, **env}, capture_output=True, text=True,
                       timeout=300)
    if r.returncode:
        raise SystemExit(f"systemd-cryptenroll {' '.join(args)}: {r.stderr.strip()[-300:]}")


def main():
    req = take_request()
    if req is None:
        log("no request")
        return 0
    devs = devices()
    if not devs:
        log("no /etc/crypttab: the system disk is not encrypted, nothing to do")
        return 0
    w = req["words"]
    for d in devs:
        if req["op"] == "slot":
            enroll(["--unlock-tpm2-device=auto", "--password", "--wipe-slot=password", d], {"NEWPASSWORD": w})
            log(f"{d}: recovery key keyslot added, install passphrase wiped")
        else:
            enroll(["--wipe-slot=tpm2", d], {"PASSWORD": w})
            enroll(["--tpm2-device=auto", "--tpm2-pcrs=7", d], {"PASSWORD": w})
            log(f"{d}: TPM2 token enrolled for this TPM (PCR 7)")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit as e:
        if isinstance(e.code, str):
            log(e.code)
            sys.exit(1)
        raise
