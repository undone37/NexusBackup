def blocking(cs):
    """The checks that stop an update."""
    return [c for c in cs if c["status"] == "fail" and c["severity"] >= SEVERITY_BLOCKS_UPDATE]


# ---------------------------------------------------------------- bundle


def utc(ts):
    return dt.datetime.fromtimestamp(ts, dt.timezone.utc)


def catalog_stats():
    """Row counts and audit action counts: no row contents."""
    if not os.path.exists(cfg("CATALOG")):
        return {"error": "no catalog"}
    conn = catalog_conn()
    try:
        tables = [r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%' ORDER BY name")]
        return {
            "schema_version": conn.execute("PRAGMA user_version").fetchone()[0],
            "page_count": conn.execute("PRAGMA page_count").fetchone()[0],
            "page_size": conn.execute("PRAGMA page_size").fetchone()[0],
            "rows": {t: conn.execute(f'SELECT COUNT(*) FROM "{t}"').fetchone()[0] for t in tables},
            "audit_actions": dict(conn.execute("SELECT action, COUNT(*) FROM audit GROUP BY action ORDER BY action").fetchall()) if "audit" in tables else {},
            "jobs_by_kind_state": [list(r) for r in conn.execute("SELECT kind, state, COUNT(*) FROM jobs GROUP BY kind, state ORDER BY kind, state")] if "jobs" in tables else [],
        }
    except sqlite3.Error as e:
        return {"error": str(e)}
    finally:
        conn.close()


def read_text(path, limit=4 << 20):
    try:
        with open(path, errors="replace") as f:
            return f.read(limit)
    except OSError as e:
        return f"{path}: {e.strerror}\n"


def tool_text(*argv, timeout=None):
    rc, out, err = run(*argv, timeout=timeout)
    head = f"$ {' '.join(argv)}\n# exit {rc}\n"
    return head + out + (("\n# stderr:\n" + err) if err.strip() else "")


def journal(since, until, *args):
    lim = int(cfg("JOURNAL_MAX_MB")) * 2**20
    rc, out, err = run(
        "journalctl", "--no-pager", "-o", "short-iso-precise", "--utc",
        "--since", f"@{since}", "--until", f"@{until}", *args, timeout=600,
    )
    if len(out) > lim:  # keep the newest part: the end of the range is usually what matters
        out = f"[truncated: first {len(out) - lim} characters dropped]\n" + out[-lim:]
    return f"$ journalctl --since @{since} --until @{until} {' '.join(args)}\n# exit {rc}\n" + out + (("\n# stderr:\n" + err) if err.strip() else "")


def bundle_files(since, until, cs):
    """name -> text (all redacted by the caller)."""
    ts = utc(since).strftime("%m/%d/%Y %H:%M:%S").split()
    te = utc(until).strftime("%m/%d/%Y %H:%M:%S").split()
    drops = journal(since, until, "-k", "--grep", "nexus-(in|out)-drop")
    upd = read_update_status()
    return {
        "checks.json": json.dumps(cs, indent=1),
        "journal-nexus.txt": journal(since, until, "-u", "nexus-*", "-u", "greenboot-*", "-u", "chronyd.service", "-u", "nftables.service"),
        "journal-warnings.txt": journal(since, until, "-p", "warning"),
        "nft-drops.txt": drops,
        "avc.txt": tool_text("ausearch", "-m", "AVC,USER_AVC,SELINUX_ERR", "-i", "-ts", *ts, "-te", *te),
        "update-status.json": json.dumps(upd, indent=1, sort_keys=True) if upd is not None else "no update status\n",
        "chrony.txt": "\n".join(tool_text("chronyc", "-n", c) for c in ("tracking", "sources", "sourcestats", "authdata")),
        "systemd-failed.txt": tool_text("systemctl", "list-units", "--failed", "--plain", "--no-pager"),
        "nexus-units.txt": tool_text("systemctl", "list-units", "nexus-*", "--all", "--plain", "--no-pager"),
        "nft-ruleset.txt": tool_text("nft", "list", "table", "inet", "nexus"),
        "catalog-stats.json": json.dumps(catalog_stats(), indent=1),
        "disks.json": read_text(cfg("DISKS_STATUS")),
    }


def write_bundle(path, req, cs):
    files = {k: redact(v) for k, v in bundle_files(req["since"], req["until"], cs).items()}
    manifest = {
        "id": req["id"],
        "created": int(time.time()),
        "since": req["since"],
        "until": req["until"],
        "requested_by": req["by"],
        "redacted": "secrets, tokens, keys and passwords removed; host names and IP addresses kept",
        "files": sorted(files),
    }
    files["manifest.json"] = json.dumps(manifest, indent=1)
    top = f"nexus-support-{utc(manifest['created']).strftime('%Y%m%dT%H%M%SZ')}"
    tmp = path + ".tmp"
    with tarfile.open(tmp, "w:gz") as tar:
        for name, text in sorted(files.items()):
            data = text.encode()
            ti = tarfile.TarInfo(f"{top}/{name}")
            ti.size, ti.mtime, ti.mode = len(data), manifest["created"], 0o644
            tar.addfile(ti, io.BytesIO(data))
    os.replace(tmp, path)


# ---------------------------------------------------------------- requests


def read_small(path, limit=4096):
    """A control file written by a less privileged user: no symlinks, regular file only."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        return os.read(fd, limit + 1).decode("utf-8", "replace")
    finally:
        os.close(fd)


def parse_request(s, now):
    """Validated request dict, or raises ValueError."""
    if s is None or len(s) > 4096:
        raise ValueError("missing or oversized request")
    r = json.loads(s)
    if not isinstance(r, dict):
        raise ValueError("request is not an object")
    if not re.fullmatch(r"[0-9a-f]{32}", str(r.get("id", ""))):
        raise ValueError("bad id")
    if r.get("kind") not in ("checks", "bundle"):
        raise ValueError("bad kind")
    by = r.get("by")
    if not isinstance(by, str) or not re.fullmatch(r"[A-Za-z0-9._@-]{1,64}", by):
        raise ValueError("bad by")
    until = r.get("until", now)
    since = r.get("since", until - 86400)
    if not all(isinstance(x, int) and not isinstance(x, bool) for x in (since, until)) or not (0 <= since < until <= now + 3600) or until - since > MAX_RANGE:
        raise ValueError("bad time range")
    return {"id": r["id"], "kind": r["kind"], "by": by, "since": since, "until": until}


def write_json(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1, sort_keys=True)
        f.write("\n")
    os.replace(tmp, path)


def handle(d, req):
    out = os.path.join(d, req["id"])
    # the control dir is setgid nexus-webapi, so the group is inherited; the unit has
    # RestrictSUIDSGID=yes (an explicit S_ISGID mode is EPERM there)
    os.mkdir(out, 0o750)  # FileExistsError: an id is used once
    st = {**req, "created": int(time.time()), "state": "running", "error": None, "files": {}}
    write_json(os.path.join(out, "status.json"), st)
    try:
        cs = checks()
        write_json(os.path.join(out, "checks.json"), cs)
        st["files"]["checks.json"] = os.path.getsize(os.path.join(out, "checks.json"))
        if req["kind"] == "bundle":
            p = os.path.join(out, "bundle.tar.gz")
            write_bundle(p, req, cs)
            st["files"]["bundle.tar.gz"] = os.path.getsize(p)
        st["state"] = "done"
    except Exception as e:
        st["state"], st["error"] = "error", f"{type(e).__name__}: {e}"
        log(f"{req['id']}: {st['error']}")
    st["finished"] = int(time.time())
    write_json(os.path.join(out, "status.json"), st)
    log(f"{req['kind']} {req['id']} for {req['by']}: {st['state']}")


def prune(d, now):
    """Drops results older than 24 h, and all but the newest KEEP_RESULTS."""
    dirs = []
    for name in os.listdir(d):
        p = os.path.join(d, name)
        if re.fullmatch(r"[0-9a-f]{32}", name) and os.path.isdir(p) and not os.path.islink(p):
            dirs.append((os.lstat(p).st_mtime, p))
    dirs.sort(reverse=True)
    for i, (mtime, p) in enumerate(dirs):
        if i >= KEEP_RESULTS or now - mtime > RESULT_TTL:
            shutil.rmtree(p, ignore_errors=True)


def tick():
    d = cfg("DIR")
    req_path = os.path.join(d, "request.json")
    for _ in range(10):  # the web-api may queue the next request while we work
        s = read_small(req_path)
        if s is None:
            break
        try:
            os.unlink(req_path)  # consume first: a failing request cannot re-trigger the path unit forever
        except FileNotFoundError:
            pass
        try:
            req = parse_request(s, int(time.time()))
        except (ValueError, TypeError) as e:
            log(f"ignoring request: {e}")
            continue
        try:
            handle(d, req)
        except OSError as e:
            log(f"{req['id']}: {e}")
    prune(d, time.time())
    return 0


def main(argv):
    if argv[1:] == ["checks"]:
        print(json.dumps(checks(), indent=1))
        return 0
    if argv[1:] == ["tick"]:
        old = os.umask(0o027)
        try:
            return tick()
        finally:
            os.umask(old)
    print("usage: nexus-diag tick|checks", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
