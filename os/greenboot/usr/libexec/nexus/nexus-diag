def cfg(name):
    return os.environ.get("NEXUS_DIAG_" + name, DEFAULTS[name])


def log(msg):
    print(f"nexus-diag: {msg}", file=sys.stderr, flush=True)


def run(*argv, timeout=None):
    """(exit code, stdout, stderr); 127 when the tool is missing. Never raises."""
    try:
        p = subprocess.run(
            [cfg(argv[0].upper()), *argv[1:]],
            capture_output=True,
            text=True,
            errors="replace",
            timeout=timeout or float(cfg("TIMEOUT")),
            env={**os.environ, "LC_ALL": "C", "TZ": "UTC", "SYSTEMD_COLORS": "0", "SYSTEMD_PAGER": ""},
        )
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", f"{argv[0]}: not installed"
    except subprocess.TimeoutExpired:
        return 124, "", f"{argv[0]}: timed out"


def health():
    """nexus-health as a module: one implementation of the audit chain."""
    sys.dont_write_bytecode = True  # /usr is read-only; never leave __pycache__ next to it
    loader = importlib.machinery.SourceFileLoader("nexus_health", cfg("HEALTH"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


# ---------------------------------------------------------------- redaction

_SECRET_KEYS = (
    r"pass(?:word|wd|phrase)?|secret|client[_-]?secret|token|api[_-]?key|access[_-]?key|secret[_-]?key|"
    r"private[_-]?key|totp(?:[_-]?secret|[_-]?seed)?|seed|otp|csrf|session(?:[_-]?id)?|cookie|credentials?|"
    r"authorization|sas|x-amz-[a-z-]*"
)
# password_hash, totp_secret_enc, token_hash, ...
_SECRET_KEYS = r"(?:" + _SECRET_KEYS + r")(?:[_-](?:hash|enc|sealed|file))?"
_REDACTIONS = [
    # PEM blocks (keys, certificates, CSRs): never useful to support, sometimes secret
    (re.compile(r"-----BEGIN ([A-Z0-9 ]+)-----.*?(?:-----END \1-----|\Z)", re.S), r"[REDACTED PEM \1]"),
    # HTTP headers
    (re.compile(r"(?im)\b(authorization|proxy-authorization|cookie|set-cookie|x-api-key|x-csrf-token)(\s*[:=]\s*)[^\r\n]+"), r"\1\2[REDACTED]"),
    (re.compile(r"(?i)\b(bearer|basic)\s+[A-Za-z0-9._~+/=-]{8,}"), r"\1 [REDACTED]"),
    # API tokens (nxt_...), agent / enrollment tokens with a prefix
    (re.compile(r"\bnx[a-z]_[A-Za-z0-9_-]{8,}"), "[REDACTED TOKEN]"),
    # otpauth://totp/...?secret=BASE32
    (re.compile(r"(?i)(otpauth://\S*?[?&]secret=)[A-Za-z2-7=]+"), r"\1[REDACTED]"),
    # user:password@host in URLs
    (re.compile(r"(?i)\b([a-z][a-z0-9+.-]*://[^/\s:@]+:)[^@\s/]+@"), r"\1[REDACTED]@"),
    # download / diagnostics tokens in URLs
    (re.compile(r"(/(?:downloads|diagnostics)/)[0-9a-f]{32,64}\b"), r"\1[REDACTED]"),
    # JSON: "password": "...", "token": 123
    (re.compile(r'(?i)("(?:[a-z0-9_-]*[_-])?(?:' + _SECRET_KEYS + r')"\s*:\s*)("(?:[^"\\]|\\.)*"|[^\s,}\]]+)'), r'\1"[REDACTED]"'),
    # key=value / key: value in logs, configs and command lines
    (re.compile(r"(?i)(\b(?:[a-z0-9_-]*[_-])?(?:" + _SECRET_KEYS + r")\b\s*[=:]\s*)(?!\[REDACTED)(\"[^\"]*\"|'[^']*'|[^\s,;&\"']+)"), r"\1[REDACTED]"),
    # --password VALUE on command lines
    (re.compile(r"(?i)(--(?:[a-z0-9-]*-)?(?:password|secret|token|key)\s+)(?!\[REDACTED)\S+"), r"\1[REDACTED]"),
]


def redact(text):
    """Removes secrets from free text (journal lines, JSON, command output). Idempotent."""
    for rx, repl in _REDACTIONS:
        text = rx.sub(repl, text)
    return text


# ---------------------------------------------------------------- checks


def check(cid, title, fn):
    """Runs one check; a check that crashes is a warning, never an update blocker."""
    try:
        status, severity, detail = fn()
    except Exception as e:  # a bug or an unexpected host state: visible, but not blocking
        status, severity, detail = "warn", 2, f"check could not run: {type(e).__name__}: {e}"
    return {
        "id": cid,
        "title": title,
        "status": status,
        "severity": severity if status in ("warn", "fail") else 1,
        "detail": detail,
        "manual": MANUAL + cid.replace(".", "-"),
    }


def mib(n):
    return f"{n / 2**30:.1f} GiB" if n >= 2**30 else f"{n // 2**20} MiB"


def disk(path):
    def fn():
        if not os.path.exists(path):
            return "skip", 1, f"{path} does not exist"
        s = os.statvfs(path)
        total, free = s.f_blocks * s.f_frsize, s.f_bavail * s.f_frsize
        if not total:
            return "skip", 1, f"{path}: no size reported"
        used = 100.0 * (total - free) / total
        d = f"{path}: {used:.0f} % used, {mib(free)} of {mib(total)} free"
        if used >= float(cfg("DISK_FAIL_PCT")):
            return "fail", 3, d
        if used >= float(cfg("DISK_WARN_PCT")):
            return "warn", 2, d
        return "pass", 1, d

    return fn


def time_sync():
    # -c: CSV. tracking: refid, ip, stratum, ref time, system offset, last offset, rms offset,
    # frequency, residual freq, skew, root delay, root dispersion, update interval, leap status
    rc, out, err = run("chronyc", "-c", "-n", "tracking")
    if rc == 127:
        return "skip", 1, "chronyc not installed"
    if rc != 0:
        return "fail", 3, f"chronyd does not answer: {(err or out).strip()[:200]}"
    f = out.strip().split(",")
    if len(f) < 14:
        return "warn", 2, f"unexpected chronyc output: {out.strip()[:200]}"
    stratum, offset, leap = int(f[2]), float(f[4]), f[13]
    d = f"stratum {stratum}, offset {offset * 1000:+.1f} ms, {leap.lower()}, reference {f[0]}"
    if leap.lower().startswith("not synchron") or stratum in (0, 16):
        return "fail", 3, "clock not synchronised: " + d
    if abs(offset) > 1.0:
        return "warn", 2, d
    return "pass", 1, d


def time_nts():
    # authdata: name, ip, mode, key id, type, key length, last, ...; mode NTS for NTS sources
    rc, out, err = run("chronyc", "-c", "-n", "authdata")
    if rc == 127:
        return "skip", 1, "chronyc not installed"
    if rc != 0:
        return "warn", 2, f"chronyc authdata failed: {(err or out).strip()[:200]}"
    rows = [l.split(",") for l in out.strip().splitlines() if l.count(",") >= 3]
    nts = [r for r in rows if r[2] == "NTS"]
    other = [r[0] for r in rows if r[2] != "NTS"]
    if not nts:
        return "warn", 2, "no NTS-authenticated time source"
    d = f"{len(nts)} NTS source(s)"
    if other:
        return "warn", 2, d + "; unauthenticated: " + ", ".join(other[:5])
    return "pass", 1, d


def time_compliance():
    """The compliance clock (retention locks, ADR-011) against system time, as the scheduler
    measured it (setting compliance_clock; the stores are closed to nexus-diag)."""
    if not os.path.exists(cfg("CATALOG")):
        return "skip", 1, "no catalog (first-boot setup not finished)"
    conn = catalog_conn()
    try:
        row = conn.execute("SELECT value FROM settings WHERE key = 'compliance_clock'").fetchone()
    finally:
        conn.close()
    if not row:
        return "skip", 1, "not measured yet (no tenant store, or the scheduler has not run)"
    st = json.loads(row[0])
    skew, jump = int(st.get("skew_secs") or 0), int(st.get("jump_secs") or 0)
    d = f"tenant {st.get('tenant')}: compliance clock {abs(skew)} s {'ahead of' if skew < 0 else 'behind'} system time"
    if jump:
        d += f", {jump} s of it from a system time jump while running"
    age = time.time() - int(st.get("checked") or 0)
    if age > 900:
        return "warn", 2, f"last measured {age / 60:.0f} min ago (is nexus-scheduler running?); " + d
    # severity 2 at most: the compliance clock never makes an update unsafe
    bad = max(jump, -skew)
    if bad > 600:
        return "fail", 2, d
    if bad > 60:
        return "warn", 2, d
    if skew > 60:
        return "pass", 1, d + " after a restart (downtime); it catches up slowly, locks last longer meanwhile"
    return "pass", 1, d


def egress():
    missing = []
    for s in ("allowed_out_v4", "allowed_out_v6"):
        rc, out, err = run("nft", "list", "set", "inet", "nexus", s)
        if rc == 127:
            return "skip", 1, "nft not installed"
        if rc != 0:
            missing.append(s)
    if missing:
        return "fail", 3, "nftables table inet nexus incomplete (missing " + ", ".join(missing) + "): outbound filtering is not active"
    down = [u for u in ("nexus-nft-sync.path", "nexus-nft-sync.timer") if run("systemctl", "is-active", "--quiet", u)[0] != 0]
    if down:
        return "warn", 2, "allow-list sync not active: " + ", ".join(down)
    return "pass", 1, "default-deny output chain loaded, allow-list sync active"


def keyd():
    if not os.path.exists(cfg("SETUP_DONE")):
        return "skip", 1, "first-boot setup not finished"
    if run("systemctl", "is-active", "--quiet", "nexus-keyd.service")[0] != 0:
        return "fail", 4, "nexus-keyd.service is not running: no backups or restores"
    # only nexus-diag.service has the group that may look into keyd's run dir; run by
    # nexus-update (no such group, no DAC override in nexus_diag_t) the unit state suffices
    try:
        keyd_gid = grp.getgrnam("nexus-keyd").gr_gid
    except KeyError:
        keyd_gid = None
    if keyd_gid is not None and keyd_gid not in os.getgroups() and os.getegid() != keyd_gid:
        return "pass", 1, "key daemon running (socket not inspected from this caller)"
    try:
        if not stat.S_ISSOCK(os.stat(cfg("KEYD_SOCKET")).st_mode):
            return "fail", 4, f"{cfg('KEYD_SOCKET')} is not a socket"
    except OSError as e:
        return "fail", 4, f"keyd socket {cfg('KEYD_SOCKET')}: {e.strerror}"
    # keyd loads the KEK when it starts (no TPM sealing yet): running = unlocked
    return "pass", 1, "key daemon running, socket present"


def tls_cert():
    path = cfg("TLS_CERT")
    if not os.path.exists(path):
        return "skip", 1, f"{path} does not exist (first-boot setup not finished?)"
    info = ssl._ssl._test_decode_cert(path)  # parses only the first certificate; no key access
    end = ssl.cert_time_to_seconds(info["notAfter"])
    days = (end - time.time()) / 86400
    when = dt.datetime.fromtimestamp(end, dt.timezone.utc).strftime("%Y-%m-%d")
    if days < 0:
        return "fail", 3, f"web certificate expired on {when}"
    if days < float(cfg("CERT_WARN_DAYS")):
        return "warn", 2, f"web certificate expires on {when} ({days:.0f} days)"
    return "pass", 1, f"web certificate valid until {when}"


def catalog_conn():
    """Read-only connection that never writes the -shm file either (readonly_shm); a
    catalog nobody has open (no -wal/-shm) is read as immutable."""
    path = cfg("CATALOG")
    shm = os.path.exists(path + "-shm") and os.path.exists(path + "-wal")
    mode = "mode=ro&readonly_shm=1" if shm else "mode=ro&immutable=1"
    conn = sqlite3.connect(f"file:{path}?{mode}", uri=True, timeout=30)
    conn.execute("PRAGMA temp_store = MEMORY")  # no temp files (the unit has only a private /tmp)
    return conn


def catalog_integrity():
    if not os.path.exists(cfg("CATALOG")):
        return "skip", 1, "no catalog (first-boot setup not finished)"
    conn = catalog_conn()
    try:
        res = [r[0] for r in conn.execute("PRAGMA quick_check")]
    finally:
        conn.close()
    if res != ["ok"]:
        return "fail", 4, "PRAGMA quick_check: " + "; ".join(res[:5])
    return "pass", 1, "quick_check ok"


def audit_chain():
    if not os.path.exists(cfg("CATALOG")):
        return "skip", 1, "no catalog (first-boot setup not finished)"
    h = health()
    conn = catalog_conn()
    try:
        n = h.verify_audit(conn)
    except h.Fail as e:
        return "fail", 4, str(e)
    finally:
        conn.close()
    return "pass", 1, f"{n} entries, hash chain intact"


def selinux():
    try:
        with open(cfg("SELINUX_ENFORCE")) as f:
            v = f.read().strip()
    except FileNotFoundError:
        return "fail", 4, "SELinux is disabled"
    if v != "1":
        return "fail", 4, "SELinux is permissive: the service confinement is not enforced"
    return "pass", 1, "enforcing"


def failed_units():
    rc, out, err = run("systemctl", "list-units", "--failed", "--plain", "--no-legend", "--no-pager")
    if rc == 127:
        return "skip", 1, "systemctl not available"
    if rc != 0:
        return "warn", 2, f"systemctl failed: {(err or out).strip()[:200]}"
    units = [l.split()[0] for l in out.splitlines() if l.strip()]
    if not units:
        return "pass", 1, "no failed units"
    core = [u for u in units if u in CORE_UNITS]
    d = "failed: " + ", ".join(units[:10]) + (" …" if len(units) > 10 else "")
    return ("fail", 3, d) if core else ("warn", 2, d)


def read_update_status():
    try:
        with open(cfg("UPDATE_STATUS")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def bootc():
    st = read_update_status()
    if st is None:
        return "skip", 1, "no update status yet (nexus-update has not run)"
    if st.get("bootc_error"):
        return "warn", 2, "bootc status failed: " + str(st["bootc_error"])[:200]
    booted, staged, rb = st.get("booted") or {}, st.get("staged"), st.get("rollback")
    parts = [f"booted {booted.get('version') or '?'}"]
    if staged:
        parts.append(f"staged {staged.get('version') or staged.get('digest')}")
    parts.append(f"rollback {rb.get('version') or rb.get('digest')}" if rb else "no rollback image")
    d = ", ".join(parts)
    if st.get("rollback_queued"):
        return "warn", 2, "a rollback is queued for the next boot; " + d
    if st.get("spec_signature") not in (None, "containerPolicy"):
        return "warn", 2, f"origin signature mode {st.get('spec_signature')} (nexus-update enforces signatures at the next check); " + d
    return "pass", 1, d


def smart():
    """Disk health as nexus-disks last saw it (Phase 16a): SMART, md arrays. nexus-diag itself
    never opens a disk."""
    try:
        with open(cfg("DISKS_STATUS")) as f:
            st = json.load(f)
    except FileNotFoundError:
        return "skip", 1, "no disk status yet (nexus-disks has not run)"
    age = time.time() - st.get("scanned", 0)
    if age > 3600:
        return "warn", 2, f"disk status is {age / 3600:.0f} h old: nexus-disks.timer is not running"
    failing = [d["name"] for d in st.get("disks") or [] if (d.get("smart") or {}).get("health") == "failed"]
    bad = [a["name"] for a in st.get("arrays") or [] if a.get("state") in ("failed", "inactive")]
    degraded = [a["name"] for a in st.get("arrays") or [] if a.get("degraded") and a["name"] not in bad]
    sectors = [d["name"] for d in st.get("disks") or [] if any(
        ((d.get("smart") or {}).get(k) or 0) > 0 for k in ("pending", "reallocated", "offline_uncorrectable", "media_errors"))]
    if failing or bad:
        return "fail", 3, "; ".join(x for x in (
            failing and "SMART reports failing disk(s): " + ", ".join(failing),
            bad and "failed array(s): " + ", ".join(bad)) if x)
    if degraded or sectors:
        return "warn", 2, "; ".join(x for x in (
            degraded and "degraded array(s): " + ", ".join(degraded),
            sectors and "bad sectors or media errors on: " + ", ".join(sectors)) if x)
    smart_ok = sum(1 for d in st.get("disks") or [] if (d.get("smart") or {}).get("available"))
    return "pass", 1, f"{len(st.get('disks') or [])} disk(s), {smart_ok} with SMART, {len(st.get('arrays') or [])} array(s) healthy"


# ---------------------------------------------------------------- security posture (Phase 21b)
# Recommendations, never update blockers: pass or warn (severity 2). Catalog based except the
# boot menu password; the Security posture card (Settings → Diagnostics) shows these rows.

PRIVILEGED = "role IN ('admin','security_officer') AND disabled = 0 AND activation_hash IS NULL AND (expires IS NULL OR expires > ?)"


def posture(fn):
    def run_():
        if not os.path.exists(cfg("CATALOG")):
            return "skip", 1, "no catalog (first-boot setup not finished)"
        conn = catalog_conn()
        try:
            settings = dict(conn.execute("SELECT key, value FROM settings"))
            ok, detail = fn(conn, settings, int(time.time()))
        finally:
            conn.close()
        return ("pass", 1, detail) if ok else ("warn", 2, detail)
    return run_


def jsetting(settings, key, default):
    try:
        v = json.loads(settings[key])
    except (KeyError, ValueError):
        return default
    return default if v is None else v


def p_approvals(conn, settings, now):
    on = settings.get("approvals_enabled") != "false"
    n = conn.execute(f"SELECT COUNT(*) FROM users WHERE {PRIVILEGED}", (now,)).fetchone()[0]
    d = f"approvals {'on' if on else 'off'}, {n} possible approver(s) (active admins and security officers)"
    return on and n >= 3, d + ("" if on and n >= 3 else "; recommended: approvals on and at least 3 approvers")


def p_forwarding(conn, settings, now):
    f = jsetting(settings, "forwarding", {})
    sinks = [k for k in ("syslog", "https") if isinstance(f.get(k), dict) and f[k].get("enabled", True)]
    if not sinks:
        return False, "no audit forwarding to a syslog or HTTPS receiver configured"
    bad = []
    for k in sinks:
        row = conn.execute("SELECT last_ok, failing_since FROM forward_state WHERE sink = ?", (k,)).fetchone()
        if not row or row[0] is None or row[1] is not None:
            bad.append(k)
    if bad:
        return False, "forwarding not delivering: " + ", ".join(bad)
    return True, "forwarding delivers to " + ", ".join(sinks)


def p_offsite_lock(conn, settings, now):
    unlocked = []
    tenants = conn.execute("SELECT name, offsite FROM tenants ORDER BY name").fetchall()
    for name, raw in tenants:
        try:
            remote = (json.loads(raw or "{}") or {}).get("remote")
        except ValueError:
            remote = None
        if not (isinstance(remote, dict) and remote.get("type") == "s3" and remote.get("lock")):
            unlocked.append(name)
    if not tenants:
        return False, "no tenants yet"
    if unlocked:
        return False, "no offsite copy with S3 Object Lock for: " + ", ".join(unlocked[:10]) + (" …" if len(unlocked) > 10 else "")
    return True, f"{len(tenants)} tenant(s) copy offsite with S3 Object Lock"


def p_inbound(conn, settings, now):
    inbound = jsetting(settings, "inbound", None)
    if isinstance(inbound, dict):
        allow = ((inbound.get("services") or {}).get("web") or {}).get("allow") or []
    else:
        allow = jsetting(settings, "mgmt_allow", [])
    if not allow:
        return False, "the web UI and API accept connections from any address (no inbound allow-list)"
    return True, "web UI and API restricted to " + ", ".join(allow[:5]) + (" …" if len(allow) > 5 else "")


def p_certificate(conn, settings, now):
    web = jsetting(settings, "tls_status", {}).get("web") or {}
    if web.get("imported"):
        return True, f"imported certificate {web.get('subject') or ''}".strip()
    return False, "the self-signed certificate is in use; import one signed by your CA"


def p_dormant_admins(conn, settings, now):
    try:
        days = int(settings.get("dormant_days") or 0)
    except ValueError:
        days = 0
    days = days or int(cfg("DORMANT_ADMIN_DAYS"))
    rows = conn.execute(
        f"SELECT name FROM users WHERE {PRIVILEGED} AND COALESCE(last_login, created) < ? ORDER BY name",
        (now, now - days * 86400)).fetchall()
    if rows:
        return False, f"no login for {days} days: " + ", ".join(r[0] for r in rows[:10])
    return True, f"every admin and security officer logged in within {days} days"


def p_totp(conn, settings, now):
    local, oidc, missing = 0, 0, []
    for name, auth, totp in conn.execute(
            "SELECT name, auth, totp_secret FROM users WHERE disabled = 0 AND activation_hash IS NULL ORDER BY name"):
        if auth == "oidc":
            oidc += 1
        elif totp:
            local += 1
        else:
            missing.append(name)
    if missing:
        return False, "local accounts without TOTP: " + ", ".join(missing[:10])
    d = f"{local} local account(s) with password + TOTP"
    return True, d + (f"; {oidc} single sign-on account(s): the identity provider must enforce MFA" if oidc else "")


def grub_password():
    if not os.path.exists(cfg("GRUB_USER")):
        return "warn", 2, "no boot menu password: set it with nexus-setup at the console"
    try:
        os.stat(cfg("GRUB_BOOT"))
    except FileNotFoundError:
        return "warn", 2, f"boot menu password set but not installed in {cfg('GRUB_BOOT')} (nexus-grub-password)"
    except PermissionError:
        pass  # /boot not readable from this caller: the configured hash is enough
    return "pass", 1, "boot menu password set"


