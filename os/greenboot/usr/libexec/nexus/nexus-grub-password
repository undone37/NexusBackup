#!/usr/bin/python3 -I
# NexusBackup boot menu password (Phase 18, docs/control-plane.md "Boot menu password").
#
# nexus-setup writes the GRUB superuser's PBKDF2 hash, derived from the recovery key, to
# /etc/nexus/grub-user.cfg (one line GRUB2_PASSWORD=grub.pbkdf2.sha512.…). This oneshot
# (nexus-grub-password.service: at every boot and when nexus-setup starts it) copies it to
# /boot/grub2/user.cfg, which the static GRUB configuration of bootupd sources
# (configs.d/01_users.cfg: superusers="root", password_pbkdf2). The bootc/BLS menu entries
# stay unrestricted (they boot without a password); editing an entry, the GRUB command
# line and the firmware-settings entry need the password.
#
# GRUB sources the file as script, so only that exact line is accepted. /boot is remounted
# read-write for the copy if it is mounted read-only, and back afterwards. Nothing to do
# when the files already match. Exit 0 = installed or unchanged, 1 = error.

import os
import re
import subprocess
import sys

DEFAULTS = {
    "SRC": "/etc/nexus/grub-user.cfg",
    "BOOT": "/boot",
    "MOUNTINFO": "/proc/self/mountinfo",
    "MOUNT": "mount",
}
LINE = re.compile(r"GRUB2_PASSWORD=grub\.pbkdf2\.sha512\.[0-9]{1,7}\.[0-9A-F]{16,256}\.[0-9A-F]{16,256}\n")


def cfg(name):
    return os.environ.get("NEXUS_GRUB_" + name, DEFAULTS[name])


def log(msg):
    print(f"nexus-grub-password: {msg}", file=sys.stderr, flush=True)


def read_src(path):
    """The hash line (regular file, no symlink, small), or None when there is none yet."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, "rb") as f:
        return f.read(1025).decode("ascii", "replace")


def mounted_ro(mountpoint):
    """True if `mountpoint` is a mount point mounted read-only (the last mount on it counts)."""
    ro = False
    with open(cfg("MOUNTINFO")) as f:
        for line in f:
            p = line.split()
            if len(p) > 5 and p[4] == mountpoint:
                ro = "ro" in p[5].split(",")
    return ro


def remount(boot, mode):
    subprocess.run([cfg("MOUNT"), "-o", f"remount,{mode}", boot], check=True, capture_output=True, text=True)


def install(data, dst):
    tmp = dst + ".nexus-tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, 0o600)
    os.rename(tmp, dst)
    dfd = os.open(os.path.dirname(dst), os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def main():
    try:
        data = read_src(cfg("SRC"))
    except OSError as e:  # a symlink (ELOOP) or unreadable
        log(f"{cfg('SRC')}: {e}; not installed")
        return 1
    if data is None:
        log("no boot menu password yet (first-boot setup not finished)")
        return 0
    if not LINE.fullmatch(data):
        log(f"{cfg('SRC')} is not a single GRUB2_PASSWORD=grub.pbkdf2.sha512.… line; not installed")
        return 1
    boot = cfg("BOOT")
    grub = os.path.join(boot, "grub2")
    dst = os.path.join(grub, "user.cfg")
    try:
        with open(dst) as f:
            if f.read() == data:
                return 0
    except FileNotFoundError:
        pass
    if not os.path.isdir(grub):
        log(f"{grub} does not exist: not a GRUB (bootupd) system")
        return 1
    ro = mounted_ro(boot)
    try:
        if ro:
            remount(boot, "rw")
        install(data, dst)
    except (OSError, subprocess.CalledProcessError) as e:
        log(f"installing {dst} failed: {getattr(e, 'stderr', None) or e}")
        return 1
    finally:
        if ro:
            try:
                remount(boot, "ro")
            except subprocess.CalledProcessError as e:
                log(f"remounting {boot} read-only failed: {e.stderr}")
    log(f"boot menu password installed ({dst})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
