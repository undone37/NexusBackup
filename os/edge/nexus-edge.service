[Unit]
Description=NexusBackup edge proxy (agents 443/tcp, appliance control 7445/tcp)
Documentation=file:///usr/share/doc/nexus/edge.md
After=network-online.target nftables.service
Wants=network-online.target

[Service]
# Before enrollment (`nexus-edge init --token`) it answers only enrollment on the control
# port; before the appliance pushed its configuration every agent handshake fails.
ExecStart=/usr/bin/nexus-edge serve
User=nexus-edge
Group=nexus-edge
StateDirectory=nexus-edge
StateDirectoryMode=0700
# An update pushed by the appliance (signature checked against the pinned release keys)
# is stored in /var/lib/nexus-edge/update and the process exits: the restart picks it up
# (nexus-edge re-verifies it before exec).
Restart=always
RestartSec=2
UMask=0077
LimitCORE=0
LimitNOFILE=8192

# 443 is privileged; nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindAllow=tcp:443
SocketBindAllow=tcp:7445
SocketBindDeny=any

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
