#!/usr/bin/perl
# SPDX-License-Identifier: AGPL-3.0-only
#
# NexusBackup SSH forced command (runs as user nexusbackup on a PVE node).
#
# authorized_keys:
#   restrict,command="/usr/lib/nexusbackup/helper" ssh-ed25519 AAAA... nexus-appliance
#
# Commands (from SSH_ORIGINAL_COMMAND; see docs/pve-connector.md):
#   job <vmid>                  print the job JSON, exit 1 if there is none
#   nbd <vmid>                  pipe stdin/stdout <-> the job's NBD unix socket
#   zeromap <vmid> <export>     read the extents given on stdin ({"extents":[[off,len],…],
#                               "granularity":65536}) from the job's NBD export locally and
#                               print the all-zero blocks ({"zero":[[off,len],…],"scanned":n};
#                               "zeromap-progress <bytes>" on stderr every 2 s):
#                               zvols and LVM report no holes to QEMU, so the appliance would
#                               transfer every zero block of a thin disk
#   done <vmid> ok              signal success to the waiting backup_vm
#   done <vmid> fail <msg>      signal failure
#   put-index <storeid>         replace the catalog from stdin (max 64 MiB JSON)
#   restore-job <archive>       print the pending restore request, exit 1 if none
#   restore-serve <archive> <device>
#                               listen on the request's socket, accept exactly one
#                               connection (qemu-nbd on the node), pipe it <-> stdio
#   ct-stream <vmid>            pipe stdin/stdout <-> the container job's socket
#                               (backup_container streams the tar records)
#   ct-restore-serve <archive>  like restore-serve, for a container restore
#                               request (the plugin connects and reads the tar)
#   ir-serve <vmid> <archive> <device>
#                               instant recovery: listen on
#                               /run/nexusbackup/ir/<vmid>.<archive>.<device>.sock
#                               (backing file of the VM's qcow2 overlay), print
#                               "listening", accept one connection (no timeout;
#                               ends on stdin EOF), print "accepted", pipe it <-> stdio
# Anything else: exit 2 and log to syslog.
#
# Exit codes: 0 ok, 1 runtime failure, 2 invalid command or arguments.
#
# TEST-ONLY: NEXUSBACKUP_RUNDIR, NEXUSBACKUP_RESTOREDIR, NEXUSBACKUP_IRDIR and
# NEXUSBACKUP_STATEDIR override /run/nexusbackup/jobs, /run/nexusbackup/restore,
# /run/nexusbackup/ir and /var/lib/nexusbackup for pve-plugin/t/helper.t. They are ignored when running
# under sshd (SSH_CONNECTION set), and sshd does not pass client environment by
# default.

use strict;
use warnings;

use Fcntl qw(O_RDONLY);
use File::Temp ();
use IO::Handle;
use IO::Select;
use IO::Socket::UNIX;
use JSON;
use POSIX ();
use Socket qw(SOCK_STREAM SHUT_WR);
use Sys::Syslog ();

my $under_sshd = defined($ENV{SSH_CONNECTION});
my $RUNDIR = (!$under_sshd && $ENV{NEXUSBACKUP_RUNDIR}) || '/run/nexusbackup/jobs';
my $STATEDIR = (!$under_sshd && $ENV{NEXUSBACKUP_STATEDIR}) || '/var/lib/nexusbackup';
my $RESTOREDIR = (!$under_sshd && $ENV{NEXUSBACKUP_RESTOREDIR}) || '/run/nexusbackup/restore';
my $IRDIR = (!$under_sshd && $ENV{NEXUSBACKUP_IRDIR}) || '/run/nexusbackup/ir';

my $INDEX_MAX = 64 * 1024 * 1024;
my $BUFSIZE = 1024 * 1024;
my $ACCEPT_TIMEOUT = 600;
my $VMID_RE = qr/^\d{1,9}\z/;
my $STOREID_RE = qr/^[a-z][a-z0-9\-_.]{1,99}\z/;
my $ARCHIVE_RE = qr/^nexus-\d{1,9}-\d{1,12}\z/;
my $DEVICE_RE = qr/^[a-z0-9\-]{1,64}\z/;

my $syslog_open = 0;

sub slog {
    my ($prio, $msg) = @_;
    eval {
        if (!$syslog_open) {
            Sys::Syslog::openlog('nexusbackup-helper', 'pid', 'auth');
            $syslog_open = 1;
        }
        $msg =~ s/[^\x20-\x7e]/?/g;
        Sys::Syslog::syslog($prio, '%s', $msg);
    };
}

sub fail {
    my ($code, $msg) = @_;
    print STDERR "nexusbackup-helper: $msg\n";
    slog($code == 2 ? 'warning' : 'err', $msg);
    exit($code);
}

sub usage_error {
    my ($what) = @_;
    fail(2, "rejected command: $what");
}

sub read_job {
    my ($vmid) = @_;
    my $file = "$RUNDIR/$vmid.json";
    open(my $fh, '<', $file) or return undef;
    binmode($fh);
    my $raw = do { local $/; <$fh> };
    close($fh);
    return $raw;
}

# Copy everything from $in to $out until EOF. Returns 1 on EOF, 0 on error.
sub pump {
    my ($in, $out) = @_;
    my $buf;
    while (1) {
        my $n = sysread($in, $buf, $BUFSIZE);
        if (!defined($n)) {
            next if $!{EINTR};
            return 0;
        }
        return 1 if $n == 0;
        my $off = 0;
        while ($off < $n) {
            my $w = syswrite($out, $buf, $n - $off, $off);
            if (!defined($w)) {
                next if $!{EINTR};
                return 0;
            }
            $off += $w;
        }
    }
}

sub cmd_job {
    my ($vmid) = @_;
    my $raw = read_job($vmid);
    exit(1) if !defined($raw);
    binmode(STDOUT);
    print STDOUT $raw;
    exit(0);
}

sub cmd_nbd {
    my ($vmid) = @_;

    my $raw = read_job($vmid) // fail(1, "nbd $vmid: no job");
    my $job = eval { JSON->new->utf8->decode($raw) };
    fail(1, "nbd $vmid: invalid job file") if ref($job) ne 'HASH';
    my $path = $job->{nbd_socket};
    fail(1, "nbd $vmid: job has no valid nbd_socket")
        if !defined($path) || ref($path) || $path !~ m!^/!;

    my $sock = IO::Socket::UNIX->new(Type => SOCK_STREAM, Peer => $path)
        or fail(1, "nbd $vmid: connect to $path failed: $!");
    slog('info', "nbd $vmid: connected to $path");

    pipe_stdio($sock, "nbd $vmid");
}

# ---------------------------------------------------------------------------
# zeromap: a minimal NBD client (fixed newstyle, OPT_GO, simple replies, READ)

my $ZEROMAP_MAX_IN = 16 * 1024 * 1024;    # extents JSON
my $NBD_READ = 4 * 1024 * 1024;

sub read_full {
    my ($fh, $len, $what) = @_;
    my $buf = '';
    while (length($buf) < $len) {
        my $n = sysread($fh, $buf, $len - length($buf), length($buf));
        if (!defined($n)) {
            next if $!{EINTR};
            fail(1, "zeromap: $what: $!");
        }
        fail(1, "zeromap: $what: unexpected EOF") if $n == 0;
    }
    return $buf;
}

sub write_full {
    my ($fh, $data) = @_;
    my $off = 0;
    while ($off < length($data)) {
        my $w = syswrite($fh, $data, length($data) - $off, $off);
        if (!defined($w)) {
            next if $!{EINTR};
            fail(1, "zeromap: write: $!");
        }
        $off += $w;
    }
}

sub nbd_go {
    my ($s, $export) = @_;
    my $hello = read_full($s, 18, 'greeting');
    fail(1, 'zeromap: not a newstyle NBD server') if substr($hello, 0, 16) ne 'NBDMAGICIHAVEOPT';
    my $flags = unpack('n', substr($hello, 16, 2));
    fail(1, 'zeromap: server lacks fixed newstyle') if !($flags & 1);
    write_full($s, pack('N', 1 | ($flags & 2)));    # FIXED_NEWSTYLE (+ NO_ZEROES if offered)
    my $data = pack('N', length($export)) . $export . pack('n', 0);
    write_full($s, 'IHAVEOPT' . pack('NN', 7, length($data)) . $data);    # OPT_GO
    my $size;
    while (1) {
        my ($magic_hi, $magic_lo, $opt, $type, $len) = unpack('NNNNN', read_full($s, 20, 'option reply'));
        fail(1, 'zeromap: bad option reply') if $magic_hi != 0x0003e889 || $magic_lo != 0x045565a9;
        my $d = $len ? read_full($s, $len, 'option data') : '';
        last if $type == 1;    # REP_ACK
        if ($type == 3 && length($d) >= 12 && unpack('n', $d) == 0) {    # REP_INFO / INFO_EXPORT
            my ($hi, $lo) = unpack('NN', substr($d, 2, 8));
            $size = $hi * 4294967296 + $lo;
        } elsif ($type & 0x80000000) {
            fail(1, "zeromap: export $export refused (" . sprintf('%#x', $type) . ")");
        }
    }
    fail(1, 'zeromap: no export size') if !defined($size);
    return $size;
}

sub nbd_read {
    my ($s, $off, $len, $cookie) = @_;
    my $req = pack('NnnNNNNN', 0x25609513, 0, 0, 0, $cookie,
        int($off / 4294967296), $off % 4294967296, $len);
    write_full($s, $req);
    my ($magic, $err, $c_hi, $c_lo) = unpack('NNNN', read_full($s, 16, 'reply'));
    fail(1, 'zeromap: bad reply magic') if $magic != 0x67446698;
    fail(1, "zeromap: read error $err at $off") if $err;
    return read_full($s, $len, 'read data');
}

sub cmd_zeromap {
    my ($vmid, $export) = @_;
    my $raw = read_job($vmid) // fail(1, "zeromap $vmid: no job");
    my $job = eval { JSON->new->utf8->decode($raw) };
    fail(1, "zeromap $vmid: invalid job file") if ref($job) ne 'HASH';
    my $path = $job->{nbd_socket};
    fail(1, "zeromap $vmid: job has no valid nbd_socket")
        if !defined($path) || ref($path) || $path !~ m!^/!;

    binmode(STDIN);
    my $in = '';
    while (1) {
        my $n = sysread(STDIN, $in, 65536, length($in));
        fail(1, 'zeromap: stdin: ' . $!) if !defined($n) && !$!{EINTR};
        last if defined($n) && $n == 0;
        fail(1, 'zeromap: request too large') if length($in) > $ZEROMAP_MAX_IN;
    }
    my $reqj = eval { JSON->new->utf8->decode($in) };
    fail(1, 'zeromap: invalid request') if ref($reqj) ne 'HASH' || ref($reqj->{extents}) ne 'ARRAY';
    my $g = $reqj->{granularity} // 65536;
    fail(1, 'zeromap: invalid granularity')
        if ref($g) || $g !~ m/^\d+\z/ || $g < 4096 || $g > $NBD_READ || $NBD_READ % $g;

    my $s = IO::Socket::UNIX->new(Type => SOCK_STREAM, Peer => $path)
        or fail(1, "zeromap $vmid: connect to $path failed: $!");
    binmode($s);
    my $size = nbd_go($s, $export);
    my $zeros = "\0" x $g;
    my @zero;
    my ($scanned, $cookie, $last_report) = (0, 0, time());
    for my $e ($reqj->{extents}->@*) {
        fail(1, 'zeromap: invalid extent') if ref($e) ne 'ARRAY' || @$e != 2;
        my ($o, $l) = @$e;
        fail(1, 'zeromap: invalid extent')
            if grep { ref($_) || !defined($_) || !m/^\d+\z/ } ($o, $l);
        # whole blocks only: a partial block at either end is simply transferred
        my $start = int(($o + $g - 1) / $g) * $g;
        my $end = $o + $l;
        $end = $size if $end > $size;
        $end -= $end % $g;
        for (my $pos = $start; $pos < $end; $pos += $NBD_READ) {
            my $len = $end - $pos < $NBD_READ ? $end - $pos : $NBD_READ;
            my $data = nbd_read($s, $pos, $len, ++$cookie);
            $scanned += $len;
            if (time() - $last_report >= 2) {    # the appliance shows this as progress
                $last_report = time();
                syswrite(STDERR, "zeromap-progress $scanned\n");
            }
            for (my $b = 0; $b < $len; $b += $g) {
                next if substr($data, $b, $g) ne $zeros;
                my $at = $pos + $b;
                if (@zero && $zero[-1][0] + $zero[-1][1] == $at) {
                    $zero[-1][1] += $g;
                } else {
                    push @zero, [$at, $g];
                }
            }
        }
    }
    write_full($s, pack('NnnNNNNN', 0x25609513, 0, 2, 0, 0, 0, 0, 0));    # NBD_CMD_DISC
    close($s);
    binmode(STDOUT);
    print STDOUT JSON->new->utf8->canonical->encode({ zero => \@zero, scanned => $scanned + 0 });
    slog('info', "zeromap $vmid $export: scanned $scanned bytes, " . scalar(@zero) . " zero runs");
    exit(0);
}

# Full-duplex byte pipe stdin -> $sock and $sock -> stdout; exits the process.
# Ends when the socket peer closes (or stdout breaks).
sub pipe_stdio {
    my ($sock, $label) = @_;

    binmode(STDIN);
    binmode(STDOUT);
    binmode($sock);
    $SIG{PIPE} = 'IGNORE';

    # Two processes, one per direction, so a blocked write in one direction
    # can never stall the other (NBD pipelines requests and replies).
    my $pid = fork();
    fail(1, "$label: fork failed: $!") if !defined($pid);

    if ($pid == 0) {
        # child: stdin -> socket, then half-close so the server sees EOF
        close(STDOUT);
        my $ok = pump(\*STDIN, $sock);
        shutdown($sock, SHUT_WR);
        POSIX::_exit($ok ? 0 : 1);
    }

    # parent: socket -> stdout until the server closes
    close(STDIN);
    my $ok = pump($sock, \*STDOUT);
    close(STDOUT);
    close($sock);
    kill('TERM', $pid);
    waitpid($pid, 0);
    slog('info', "$label: closed" . ($ok ? '' : " (write error: $!)"));
    exit($ok ? 0 : 1);
}

sub cmd_restore_job {
    my ($archive) = @_;
    open(my $fh, '<', "$RESTOREDIR/$archive.json") or exit(1);
    binmode($fh);
    my $raw = do { local $/; <$fh> };
    close($fh);
    binmode(STDOUT);
    print STDOUT $raw;
    exit(0);
}

sub cmd_restore_serve {
    my ($archive, $device) = @_;
    my $label = "restore-serve $archive $device";

    # The request must exist and be for this device. The socket path is derived
    # here, never taken from the file.
    open(my $fh, '<', "$RESTOREDIR/$archive.json") or fail(1, "$label: no restore request");
    my $req = eval { JSON->new->utf8->decode(do { local $/; <$fh> }) };
    close($fh);
    fail(1, "$label: invalid restore request") if ref($req) ne 'HASH';
    fail(1, "$label: pending request is for device '" . ($req->{device} // '') . "'")
        if ($req->{device} // '') ne $device || ($req->{archive} // '') ne $archive;

    serve_one($label, "$RESTOREDIR/$archive.$device.sock", "$RESTOREDIR/.$archive.$device.$$.sock");
}

# Listen on $path (bound as $tmp, then renamed), accept exactly one connection
# and pipe it <-> stdio; exits the process.
sub serve_one {
    my ($label, $path, $tmp) = @_;
    unlink($tmp);
    # Listen under a temporary name, then rename: the waiting plugin only sees
    # the socket once it accepts connections, with its final mode.
    my $listen = IO::Socket::UNIX->new(Type => SOCK_STREAM, Local => $tmp, Listen => 1)
        or fail(1, "$label: listen on $tmp failed: $!");
    if (!chmod(0660, $tmp) || !rename($tmp, $path)) {
        my $err = $!;
        unlink($tmp);
        fail(1, "$label: publishing socket failed: $err");
    }
    slog('info', "$label: listening on $path");

    my $sel = IO::Select->new($listen);
    my $conn;
    my $deadline = time() + $ACCEPT_TIMEOUT;
    while (!$conn) {
        my $left = $deadline - time();
        if ($left <= 0) {
            unlink($path);
            fail(1, "$label: no connection within ${ACCEPT_TIMEOUT}s");
        }
        $conn = $listen->accept() if $sel->can_read($left);
    }
    unlink($path); # exactly one connection
    close($listen);
    slog('info', "$label: accepted connection");

    pipe_stdio($conn, $label);
}

sub cmd_ct_stream {
    my ($vmid) = @_;
    my $label = "ct-stream $vmid";

    my $raw = read_job($vmid) // fail(1, "$label: no job");
    my $job = eval { JSON->new->utf8->decode($raw) };
    fail(1, "$label: invalid job file") if ref($job) ne 'HASH';
    fail(1, "$label: job is not a container job") if ($job->{type} // '') ne 'lxc';

    # derived, never taken from the file
    my $path = "$RUNDIR/$vmid.ct.sock";
    my $sock = IO::Socket::UNIX->new(Type => SOCK_STREAM, Peer => $path)
        or fail(1, "$label: connect to $path failed: $!");
    slog('info', "$label: connected to $path");

    pipe_stdio($sock, $label);
}

sub cmd_ct_restore_serve {
    my ($archive) = @_;
    my $label = "ct-restore-serve $archive";

    open(my $fh, '<', "$RESTOREDIR/$archive.json") or fail(1, "$label: no restore request");
    my $req = eval { JSON->new->utf8->decode(do { local $/; <$fh> }) };
    close($fh);
    fail(1, "$label: invalid restore request") if ref($req) ne 'HASH';
    fail(1, "$label: pending request is not a container restore")
        if ($req->{type} // '') ne 'lxc' || ($req->{archive} // '') ne $archive;

    serve_one($label, "$RESTOREDIR/$archive.ct.sock", "$RESTOREDIR/.$archive.ct.$$.sock");
}

# Instant recovery: QEMU on the node opens the backing NBD export of an overlay
# (created by the storage plugin) through this socket; it may connect several
# times (VM start, reconnects, offline disk move). Each SSH session serves one
# connection; the appliance keeps one idle session listening per device and
# starts the next one when it reads "accepted". The newest listener renames its
# socket over the path; a listener only removes the path while it is its own.
sub cmd_ir_serve {
    my ($vmid, $archive, $device) = @_;
    my $label = "ir-serve $vmid $archive $device";
    my $path = "$IRDIR/$vmid.$archive.$device.sock";
    my $tmp = "$IRDIR/.$vmid.$archive.$device.$$.sock";

    unlink($tmp);
    my $listen = IO::Socket::UNIX->new(Type => SOCK_STREAM, Local => $tmp, Listen => 8)
        or fail(1, "$label: listen on $tmp failed: $!");
    my @id = (stat($tmp))[0, 1];
    if (!chmod(0660, $tmp) || !rename($tmp, $path)) {
        my $err = $!;
        unlink($tmp);
        fail(1, "$label: publishing socket failed: $err");
    }
    my $release = sub {
        my @cur = (stat($path))[0, 1];
        unlink($path) if @cur && $cur[0] == $id[0] && $cur[1] == $id[1];
    };
    binmode(STDOUT);
    STDOUT->autoflush(1);
    print STDOUT "listening\n";

    # Wait for QEMU without a timeout, but end as soon as the appliance goes away
    # (stdin EOF). The appliance sends nothing before "accepted".
    my $sel = IO::Select->new($listen, \*STDIN);
    my $conn;
    while (!$conn) {
        for my $fh ($sel->can_read()) {
            if ($fh == $listen) {
                $conn = $listen->accept();
                next;
            }
            my $n = sysread(STDIN, my $buf, 1);
            next if !defined($n) && $!{EINTR};
            $release->();
            fail(1, "$label: unexpected input before a connection") if $n;
            slog('info', "$label: appliance closed the session");
            exit(0);
        }
    }
    close($listen); # further connects are refused until the next listener renames in
    $release->();
    print STDOUT "accepted\n";
    slog('info', "$label: accepted connection");

    pipe_stdio($conn, $label);
}

sub cmd_done {
    my ($vmid, $status, @msg) = @_;

    my $content;
    if ($status eq 'ok') {
        usage_error("done $vmid ok: extra arguments") if @msg;
        $content = "ok\n";
    } elsif ($status eq 'fail') {
        my $msg = join(' ', @msg);
        $msg =~ s/[^\x20-\x7e]//g;
        $msg = substr($msg, 0, 1024);
        usage_error("done $vmid fail: message required") if $msg !~ m/\S/;
        $content = "fail $msg\n";
    } else {
        usage_error("done $vmid: status must be ok or fail");
    }

    fail(1, "done $vmid: no job") if !-e "$RUNDIR/$vmid.json";

    my $tmp = eval { File::Temp->new(DIR => $RUNDIR, TEMPLATE => ".$vmid.done.XXXXXX", UNLINK => 0) }
        or fail(1, "done $vmid: cannot create temp file: $@");
    print {$tmp} $content;
    $tmp->flush;
    $tmp->sync;
    close($tmp) or fail(1, "done $vmid: write failed: $!");
    rename($tmp->filename, "$RUNDIR/$vmid.done")
        or do { unlink($tmp->filename); fail(1, "done $vmid: rename failed: $!") };

    slog('info', "done $vmid " . substr($content, 0, -1));
    exit(0);
}

sub cmd_put_index {
    my ($storeid) = @_;

    my $dir = "$STATEDIR/$storeid";
    fail(1, "put-index $storeid: $dir does not exist") if !-d $dir;

    binmode(STDIN);
    my $data = '';
    while (1) {
        my $n = sysread(STDIN, $data, $BUFSIZE, length($data));
        if (!defined($n)) {
            next if $!{EINTR};
            fail(1, "put-index $storeid: read error: $!");
        }
        last if $n == 0;
        fail(1, "put-index $storeid: index larger than 64 MiB") if length($data) > $INDEX_MAX;
    }

    my $json = eval { JSON->new->utf8->decode($data) };
    fail(1, "put-index $storeid: invalid JSON: " . ($@ =~ s/\s+$//r)) if !defined($json);
    fail(1, "put-index $storeid: index must be an object with an 'archives' array")
        if ref($json) ne 'HASH' || ref($json->{archives}) ne 'ARRAY';

    my $tmp = eval { File::Temp->new(DIR => $dir, TEMPLATE => '.index.json.XXXXXX', UNLINK => 0) }
        or fail(1, "put-index $storeid: cannot create temp file: $@");
    binmode($tmp);
    print {$tmp} $data;
    $tmp->flush;
    $tmp->sync;
    chmod(0640, $tmp->filename);
    close($tmp) or do { unlink($tmp->filename); fail(1, "put-index $storeid: write failed: $!") };
    rename($tmp->filename, "$dir/index.json")
        or do { unlink($tmp->filename); fail(1, "put-index $storeid: rename failed: $!") };

    slog('info', "put-index $storeid: " . scalar(@{ $json->{archives} }) . " archives");
    exit(0);
}

# ---------------------------------------------------------------------------

my @args;
if (defined($ENV{SSH_ORIGINAL_COMMAND}) || $under_sshd) {
    my $cmdline = $ENV{SSH_ORIGINAL_COMMAND} // '';
    usage_error('(empty)') if $cmdline !~ m/\S/;
    usage_error('command too long') if length($cmdline) > 2048;
    @args = split(/\s+/, $cmdline =~ s/^\s+//r);
} else {
    @args = @ARGV;
}

my $cmd = shift(@args) // usage_error('(empty)');
my $printable = join(' ', $cmd, @args);

if ($cmd eq 'job' || $cmd eq 'nbd') {
    usage_error($printable) if @args != 1 || $args[0] !~ $VMID_RE;
    $cmd eq 'job' ? cmd_job($args[0]) : cmd_nbd($args[0]);
} elsif ($cmd eq 'zeromap') {
    usage_error($printable) if @args != 2 || $args[0] !~ $VMID_RE || $args[1] !~ $DEVICE_RE;
    cmd_zeromap(@args);
} elsif ($cmd eq 'done') {
    usage_error($printable) if @args < 2 || $args[0] !~ $VMID_RE;
    cmd_done(@args);
} elsif ($cmd eq 'put-index') {
    usage_error($printable) if @args != 1 || $args[0] !~ $STOREID_RE;
    cmd_put_index($args[0]);
} elsif ($cmd eq 'restore-job') {
    usage_error($printable) if @args != 1 || $args[0] !~ $ARCHIVE_RE;
    cmd_restore_job($args[0]);
} elsif ($cmd eq 'restore-serve') {
    usage_error($printable) if @args != 2 || $args[0] !~ $ARCHIVE_RE || $args[1] !~ $DEVICE_RE;
    cmd_restore_serve(@args);
} elsif ($cmd eq 'ct-stream') {
    usage_error($printable) if @args != 1 || $args[0] !~ $VMID_RE;
    cmd_ct_stream($args[0]);
} elsif ($cmd eq 'ct-restore-serve') {
    usage_error($printable) if @args != 1 || $args[0] !~ $ARCHIVE_RE;
    cmd_ct_restore_serve($args[0]);
} elsif ($cmd eq 'ir-serve') {
    usage_error($printable)
        if @args != 3 || $args[0] !~ $VMID_RE || $args[1] !~ $ARCHIVE_RE || $args[2] !~ $DEVICE_RE;
    cmd_ir_serve(@args);
} else {
    usage_error($printable);
}
