# Release constants (sourced by release/*.sh and .github/workflows/release.yml).
# KEY=VALUE only, no quotes, no shell expansion: the workflow appends the KEY=VALUE
# lines to $GITHUB_ENV, the scripts load them via release/lib.sh (environment wins).

# The one image repository appliances follow. Must equal the scope in
# os/etc/containers/policy.json, os/etc/containers/registries.d/nexus-appliance.yaml and
# NEXUS_IMAGE_REPO in os/etc/nexus/update.conf (release/check-trust.sh enforces this;
# a fork changes all four, or builds with --build-arg NEXUS_IMAGE_REPO=...).
NEXUS_IMAGE_REPO=ghcr.io/undone37/nexusbackup

# Tools, run from their official images (never installed on the host). Pinned by digest.
# cosign stays on v2: containers/image (podman, skopeo, bootc) verifies the classic
# "simple signing" payload in the sha256-<digest>.sig tag that cosign v2 writes; cosign
# v3 defaults to the new bundle format stored as OCI referrers.
COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v2.6.5@sha256:ad281047f85c5e1fc6ffbc30c2b55be3b07b4032bef715a12122ce5829619aca
SYFT_IMAGE=docker.io/anchore/syft:v1.54.1@sha256:3eb5379ba7b409c3f4069b686110527af0c47df993fa5c10d13e7cf34f49b1aa
ORAS_IMAGE=ghcr.io/oras-project/oras:v1.3.4@sha256:f7bc056d54d97baa399414ed5048ecc67c3371b750d4bbce1d871827a5758179
# CVE scan of the release image (release/cve-scan.sh)
GRYPE_IMAGE=docker.io/anchore/grype:v0.120.1@sha256:e4a44ef45d285b829ce6efe2642980329661bd2d18eab5fc539138d4adaebbbe
# skopeo for the policy check, from the appliance's own base image: same containers/image
# version and policy semantics as the appliance.
POLICY_CHECK_IMAGE=quay.io/almalinuxorg/almalinux-bootc:10
