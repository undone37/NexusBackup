{
  "id": "postgresql",
  "name": "PostgreSQL",
  "version": "1.5.0",
  "publisher": "nexusbackup",
  "api": 1,
  "kinds": [
    {
      "kind": "postgresql",
      "title": "PostgreSQL server (14 or newer)",
      "config_schema": {
        "type": "object",
        "required": ["host", "user", "password"],
        "properties": {
          "host": { "type": "string", "format": "hostname", "title": "Server" },
          "port": { "type": "integer", "format": "port", "title": "Port", "default": 5432 },
          "hosts": {
            "type": "array",
            "title": "More servers of the cluster (HA: host or host:port; backups use the primary)",
            "items": { "type": "string", "maxLength": 260, "pattern": "^[A-Za-z0-9._:\\[\\]-]{1,260}$" }
          },
          "user": {
            "type": "string",
            "title": "User",
            "description": "Role with REPLICATION and pg_read_all_data; pg_hba.conf must allow it for `replication` too",
            "pattern": "^[A-Za-z0-9_.-]{1,63}$"
          },
          "password": { "type": "string", "format": "password", "title": "Password", "maxLength": 1024 },
          "sslmode": {
            "type": "string",
            "title": "TLS",
            "enum": ["require", "verify-full", "disable"],
            "default": "require",
            "description": "require = encrypted, certificate not checked; verify-full = CA (below, else public CAs) + host name"
          },
          "ca_cert": { "type": "string", "title": "CA certificate (PEM, verify-full)", "maxLength": 16384 },
          "databases_include": {
            "type": "array",
            "title": "Databases offered (patterns, empty = all)",
            "items": { "type": "string", "maxLength": 128 }
          },
          "databases_exclude": {
            "type": "array",
            "title": "Databases hidden (patterns)",
            "items": { "type": "string", "maxLength": 128 }
          },
          "slot": {
            "type": "string",
            "title": "Replication slot (cluster backups)",
            "pattern": "^[a-z0-9_]{1,63}$",
            "default": "nexusbackup"
          },
          "full_every_days": {
            "type": "integer",
            "title": "New base backup every … days (cluster backups)",
            "minimum": 1,
            "maximum": 365,
            "default": 7
          },
          "restore_host": { "type": "string", "format": "hostname", "title": "Alternate restore server" },
          "restore_port": { "type": "integer", "format": "port", "title": "Alternate server port", "default": 5432 },
          "restore_user": {
            "type": "string",
            "title": "Alternate server user (CREATEDB)",
            "pattern": "^[A-Za-z0-9_.-]{1,63}$"
          },
          "restore_password": { "type": "string", "format": "password", "title": "Alternate server password", "maxLength": 1024 },
          "ssh_host": { "type": "string", "format": "hostname", "title": "Point-in-time restore host (SSH)" },
          "ssh_port": { "type": "integer", "format": "port", "title": "SSH port", "default": 22 },
          "ssh_user": {
            "type": "string",
            "title": "SSH user (owner of the restored data directory)",
            "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
            "default": "postgres"
          },
          "ssh_key": { "type": "string", "format": "password", "title": "SSH private key (OpenSSH, unencrypted)", "maxLength": 16384 },
          "ssh_host_key": {
            "type": "string",
            "title": "SSH host key (known_hosts line or public key)",
            "maxLength": 4096
          },
          "ssh_pg_ctl": {
            "type": "string",
            "title": "pg_ctl on the restore host (optional; default: of the restored major version)",
            "pattern": "^/[A-Za-z0-9._/-]{1,1023}$"
          },
          "verify_dir": {
            "type": "string",
            "title": "Restore tests of cluster snapshots: directory on the restore host for the throwaway data directories",
            "pattern": "^/[A-Za-z0-9._/-]{1,1023}$"
          },
          "verify_port": {
            "type": "integer",
            "format": "port",
            "title": "Restore tests: port of the throwaway server",
            "default": 5499
          }
        }
      },
      "secret_fields": ["password", "restore_password", "ssh_key"],
      "endpoints": [
        { "host": "/host", "port": "/port", "default_port": 5432, "proto": "tcp" },
        { "host": "/hosts", "port": "/port", "default_port": 5432, "proto": "tcp" },
        { "host": "/restore_host", "port": "/restore_port", "default_port": 5432, "proto": "tcp" },
        { "host": "/ssh_host", "port": "/ssh_port", "default_port": 22, "proto": "tcp" }
      ],
      "guests": { "title": "Databases (logical dumps; none selected = whole cluster: base backup + WAL)", "list": true },
      "backup": { "incremental": true, "consistent": "application" },
      "restores": [
        { "id": "download", "title": "Download (tar/zip)" },
        {
          "id": "verify",
          "title": "Restore test (dump: throwaway database, row counts checked; cluster: point-in-time to a random point of its range in a throwaway directory, started, queried; removed again)",
          "applies_to": "any",
          "params_schema": { "type": "object", "properties": { "target_time": { "type": "string", "title": "Cluster snapshots: recover to time (empty = end of the backup; scheduled tests pick a random point)", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,6})?)?( ?(Z|[+-][0-9]{2}(:?[0-9]{2})?))?)?$" } } }
        },
        {
          "id": "to_target",
          "title": "Restore database dump to a server",
          "applies_to": "guest",
          "params_schema": {
            "type": "object",
            "required": ["database"],
            "properties": {
              "database": { "type": "string", "title": "Target database", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,62}$" },
              "server": {
                "type": "string",
                "title": "Server",
                "enum": ["source", "alternate"],
                "default": "source"
              },
              "into_existing": { "type": "boolean", "title": "Restore into an existing database", "default": false }
            }
          }
        },
        {
          "id": "pitr",
          "title": "Point-in-time restore (new data directory via SSH)",
          "app_specific": true,
          "applies_to": "source",
          "params_schema": {
            "type": "object",
            "required": ["directory"],
            "properties": {
              "directory": {
                "type": "string",
                "title": "New data directory on the restore host (must not exist)",
                "pattern": "^/[A-Za-z0-9._/-]{1,1023}$"
              },
              "target_time": {
                "type": "string",
                "title": "Recover to time (e.g. 2026-10-10 14:30:00+00; all targets empty = end of the backup)",
                "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,6})?)?( ?(Z|[+-][0-9]{2}(:?[0-9]{2})?))?)?$"
              },
              "target_lsn": {
                "type": "string",
                "title": "… or to LSN (e.g. 0/3000060)",
                "pattern": "^([0-9A-Fa-f]{1,8}/[0-9A-Fa-f]{1,8})?$"
              },
              "target_name": {
                "type": "string",
                "title": "… or to a named restore point (pg_create_restore_point)",
                "pattern": "^[A-Za-z0-9_.:-]{0,63}$"
              },
              "port": { "type": "integer", "format": "port", "title": "Port of the restored server (optional)" },
              "tablespaces": {
                "type": "array",
                "title": "Tablespace directories (one per line: <oid or old path>=<new path>; needed when the cluster has tablespaces)",
                "items": { "type": "string", "maxLength": 2100, "pattern": "^[^=]{1,1024}=/[A-Za-z0-9._/-]{1,1023}$" }
              },
              "start": { "type": "boolean", "title": "Start PostgreSQL after the restore (pg_ctl over SSH)", "default": false }
            }
          }
        }
      ]
    }
  ],
  "sandbox": { "network": "endpoints", "tmp_mb": 256, "memory_mb": 1024 }
}
