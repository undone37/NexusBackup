# PostgreSQL + sshd for the plugin's integration test (see run.sh): the server to
# back up, and the "restore host" a point-in-time restore unpacks a data directory
# on (SSH as postgres, key auth only).
ARG BASE=docker.io/library/postgres:17
FROM ${BASE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        openssh-server && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_* && mkdir -p /run/sshd \
    && usermod -p "*" postgres
COPY init.sh /docker-entrypoint-initdb.d/50-nexus.sh
COPY entrypoint.sh /usr/local/bin/testbox-entrypoint
RUN chmod 755 /usr/local/bin/testbox-entrypoint /docker-entrypoint-initdb.d/50-nexus.sh
ENTRYPOINT ["/usr/local/bin/testbox-entrypoint"]
CMD ["postgres"]
