{
  "id": "nexusstor",
  "name": "NexusStor",
  "version": "1.2.0",
  "publisher": "nexusbackup",
  "api": 1,
  "kinds": [
    {
      "kind": "nexusstor",
      "title": "NexusStor vStors (paired appliance)",
      "config_schema": {
        "type": "object",
        "required": ["host", "fingerprint", "client_cert", "client_key"],
        "properties": {
          "token": {
            "type": "string",
            "format": "password",
            "title": "Pairing token from NexusStor (Settings, NexusBackup, Pair: nst1.…)",
            "pattern": "^nst1\\.[A-Za-z0-9_-]+={0,2}$",
            "maxLength": 2048
          },
          "host": { "type": "string", "format": "hostname", "title": "NexusStor management address (from the token)" },
          "port": { "type": "integer", "format": "port", "title": "Port (from the token)", "default": 8443 },
          "fingerprint": {
            "type": "string",
            "title": "NexusStor certificate SHA-256 (pinned, from the token)",
            "pattern": "^[0-9a-f]{64}$"
          },
          "client_cert": {
            "type": "string",
            "title": "Client certificate of this pairing (generated by the appliance)",
            "maxLength": 16384
          },
          "client_key": {
            "type": "string",
            "format": "password",
            "title": "Client key of this pairing (generated by the appliance)",
            "maxLength": 16384
          },
          "appliance": {
            "type": "string",
            "title": "Name of this NexusBackup shown on NexusStor",
            "pattern": "^[ -~]{1,64}$",
            "maxLength": 64
          }
        }
      },
      "secret_fields": ["token", "client_key"],
      "endpoints": [{ "host": "/host", "port": "/port", "default_port": 8443, "proto": "tcp" }],
      "guests": { "title": "vStors", "list": true },
      "backup": { "incremental": true, "consistent": "snapshot", "reports": true, "findings": true },
      "restores": [{ "id": "download", "title": "Download (tar/zip)" }]
    }
  ],
  "sandbox": { "network": "endpoints", "tmp_mb": 64, "memory_mb": 2048 }
}
